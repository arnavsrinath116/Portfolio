---
import Icon from './Icon.astro';
import { projects } from '../data/projects';
import { withBase } from '../lib/url';

// the first screen must not look finished: the project covers peek up from below its edge
const peeks = projects.filter((p) => p.cover).slice(0, 2);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage" data-hero-stage>
    <div class="hero-type" data-reveal>
      <h1 id="hero-title" class="title">
        <span class="line line-1" data-line="1">Arnav <span class="hl-block" style="--hl-delay: 1.4s">Srinath’s</span></span>
        <span class="line line-2" data-line="2">Portfolio</span>
      </h1>
      <p class="intro" data-intro>I design <span class="hl">objects</span> and the <span class="hl">interfaces</span> that control them.</p>
    </div>

    <svg class="annotations" aria-hidden="true" data-annotations></svg>

    <!-- a glimpse of the work below, cut by the bottom of the sheet; it carries the scroll cue -->
    <a class="peek" href="#work" data-reveal data-peek aria-label="Selected work, below">
      <span class="peek-label"><span class="cue-arrow"><Icon name="arrow-down" /></span>Next · Selected work</span>
      <span class="peek-row">
        {
          peeks.map((p) => (
            <span class="peek-card">
              <img src={withBase(p.cover!.src)} alt="" width="2000" height="1160" decoding="async" style={p.cover!.focus ? `object-position:${p.cover!.focus}` : undefined} />
            </span>
          ))
        }
      </span>
    </a>

    <!-- the Jet V1 hologram: line art straight on the sheet, exploded by the scroll (heroJet.ts) -->
    <canvas class="hero-jet" aria-hidden="true" data-hero-jet></canvas>
  </div>
</section>

<script>
  // the peek has done its job once you start scrolling: it rises a touch and fades away
  const peek = document.querySelector<HTMLElement>('[data-peek]');
  if (peek) {
    const update = () => {
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight * 0.3)));
      peek.style.setProperty('--gone', String(p));
      peek.style.visibility = p >= 1 ? 'hidden' : '';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  /* one screen: nothing is pinned, so the first scroll moves the page */
  .hero {
    position: relative;
    height: 100svh;
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    /* not clipped: the hologram overhangs the foot of the hero and fades out (its own mask)
       rather than being cut off as the page scrolls */
    overflow: visible;
  }
  .hero {
    overflow-x: clip;
  }

  .hero-type {
    position: absolute;
    z-index: 1;
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    top: 27%;
  }
  .title {
    display: flex;
    flex-direction: column;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.6rem, 7.1vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .line {
    display: block;
    width: max-content;
    max-width: 100%;
  }
  .line-2 {
    margin-left: 2.9em;
    margin-top: 0.06em;
  }
  .intro {
    margin-top: clamp(26px, 4vh, 40px);
    margin-left: calc(clamp(2.6rem, 7.1vw, 6rem) * 2.9);
    max-width: 30ch;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.45;
    color: var(--sand-2);
  }

  .annotations {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  /* the arrow keeps nudging downward: there's more */
  .cue-arrow {
    display: inline-grid;
    animation: cue-nudge 1.8s var(--ease-inout) infinite;
  }
  @keyframes cue-nudge {
    0%,
    100% {
      transform: translateY(-2px);
    }
    50% {
      transform: translateY(4px);
    }
  }

  /* the peek: the covers of the work below, half off the foot of the sheet, bottom left */
  .peek {
    --gone: 0;
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    bottom: 0;
    z-index: 1;
    display: grid;
    gap: 12px;
    justify-items: start;
    color: inherit;
    text-decoration: none;
    opacity: calc(1 - var(--gone));
    transform: translateY(calc(var(--gone) * -24px));
  }
  .peek-label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sand-3);
    transition: color var(--dur-base) var(--ease-out);
  }
  .peek-label :global(.icon) {
    color: var(--accent);
  }
  .peek-row {
    display: flex;
    gap: clamp(10px, 1.2vw, 16px);
    margin-bottom: calc(clamp(150px, 17vw, 260px) * 1160 / 2000 * -0.45);
  }
  .peek-card {
    display: block;
    width: clamp(150px, 17vw, 260px);
    aspect-ratio: 2000 / 1160;
    border-radius: 10px;
    overflow: hidden;
    background: var(--slate-2);
    box-shadow: var(--slab-shadow);
    border-top: 1px solid var(--slate-edge);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .peek-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
  }
  @media (hover: hover) {
    .peek:hover .peek-label {
      color: var(--accent);
    }
    .peek:hover .peek-card {
      transform: translateY(-14px);
    }
    .peek:hover .peek-card:nth-child(2) {
      transition-delay: 0.05s;
    }
  }

  /* the hologram: a diagonal band across the lower right, running off the bottom of the
     sheet; it never takes the pointer */
  .hero-jet {
    position: absolute;
    right: -12vw;
    bottom: 0;
    width: 68vw;
    height: 80svh;
    z-index: 0; /* behind the title: the lettering always reads on top */
    pointer-events: none;
    /* it dissolves into the foot of the sheet instead of being cut by it */
    -webkit-mask-image: linear-gradient(to top, transparent 0, #000 10%);
    mask-image: linear-gradient(to top, transparent 0, #000 10%);
    opacity: 0;
    filter: drop-shadow(0 0 6px rgb(148 196 217 / 0.45));
    transition: opacity 1.2s var(--ease-out);
  }
  .hero-jet:global(.is-on) {
    opacity: 1;
  }
  :global(html[data-theme='light']) .hero-jet {
    filter: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .cue-arrow {
      animation: none;
    }
  }

  /* narrower screens: the heading sits in normal flow, centred */
  @media (max-width: 900px) {
    .hero-stage {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(28px, 6vh, 56px);
      padding: calc(var(--header-h) + var(--frame) + 16px) calc(var(--frame) + var(--gutter))
        calc(var(--frame) + 64px);
    }
    .hero-type {
      position: relative;
      inset: auto;
    }
    }
  }
  @media (max-width: 900px) and (max-height: 640px) {
    .title {
      font-size: clamp(2.2rem, 6vw, 3.2rem);
    }
  }
  @media (max-width: 700px) {
    .peek-card {
      width: clamp(104px, 30vw, 150px);
    }
    .peek-row {
      margin-bottom: calc(clamp(104px, 30vw, 150px) * 1160 / 2000 * -0.5);
    }
    .hero-jet {
      width: 100vw;
      height: 48svh;
      bottom: 0;
    }
    .title {
      font-size: clamp(2.2rem, 11.2vw, 3.4rem);
      font-stretch: 112%;
    }
    .line-1 {
      width: auto;
    }
    .line-2 {
      margin-left: 1.1em;
    }
    .intro {
      margin-left: calc(clamp(2.2rem, 11.2vw, 3.4rem) * 1.1);
      margin-top: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero-stage {
      position: relative;
    }
  }
</style>
