---
import Icon from './Icon.astro';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage" data-hero-stage>
    <div class="hero-type" data-reveal>
      <h1 id="hero-title" class="title">
        <span class="line line-1" data-line="1">Arnav <span class="hl-block" style="--hl-delay: 1.4s">Srinath’s</span></span>
        <span class="line line-2" data-line="2">Portfolio</span>
      </h1>
      <p class="intro" data-intro>I design <span class="hl">objects</span> and the <span class="hl">interfaces</span> that control them.</p>
    </div>

    <svg class="annotations" aria-hidden="true" data-annotations></svg>

    <p class="scroll-cue" data-reveal>
      <Icon name="arrow-down" />
      Scroll
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 200vh;
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .hero-type {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    top: 27%;
  }
  .title {
    display: flex;
    flex-direction: column;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.6rem, 7.1vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .line {
    display: block;
    width: max-content;
    max-width: 100%;
  }
  .line-2 {
    margin-left: 2.9em;
    margin-top: 0.06em;
  }
  .intro {
    margin-top: clamp(26px, 4vh, 40px);
    margin-left: calc(clamp(2.6rem, 7.1vw, 6rem) * 2.9);
    max-width: 30ch;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.45;
    color: var(--sand-2);
  }

  .annotations {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .scroll-cue {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 26px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .scroll-cue :global(.icon) {
    color: var(--orange);
  }

  /* narrower screens: the heading sits in normal flow, centred */
  @media (max-width: 900px) {
    .hero-stage {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(28px, 6vh, 56px);
      padding: calc(var(--header-h) + var(--frame) + 16px) calc(var(--frame) + var(--gutter))
        calc(var(--frame) + 64px);
    }
    .hero-type {
      position: relative;
      inset: auto;
    }
    }
  }
  @media (max-width: 900px) and (max-height: 640px) {
    .title {
      font-size: clamp(2.2rem, 6vw, 3.2rem);
    }
  }
  @media (max-width: 700px) {
    .hero {
      height: 170vh;
    }
    .title {
      font-size: clamp(2.2rem, 11.2vw, 3.4rem);
      font-stretch: 112%;
    }
    .line-1 {
      width: auto;
    }
    .line-2 {
      margin-left: 1.1em;
    }
    .intro {
      margin-left: calc(clamp(2.2rem, 11.2vw, 3.4rem) * 1.1);
      margin-top: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero-stage {
      position: relative;
    }
  }
</style>
