---
import Icon from './Icon.astro';

const disciplines = [
  { name: 'Product', line: 'Objects you can hold, modelled in CAD' },
  { name: 'UX', line: 'Flows people move through' },
  { name: 'HMI', line: 'Interfaces that control machines' },
];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero-stage" data-hero-stage>
    <div class="hero-type" data-reveal>
      <h1 id="hero-title" class="title">
        <span class="line line-1" data-line="1">Arnav Srinath’s</span>
        <span class="line line-2" data-line="2">Portfolio</span>
      </h1>
      <p class="intro" data-intro>I design objects and the interfaces that control them.</p>
    </div>

    <!-- slate slabs: the material of the page, tilted by the cursor, fanned by scroll -->
    <div class="slabs" data-slabs data-reveal>
      <div class="slab slab-back" data-slab="0"></div>
      <div class="slab slab-mid" data-slab="1"></div>
      <div class="slab slab-front" data-slab="2">
        <ul class="disciplines" aria-label="Disciplines">
          {
            disciplines.map((d) => (
              <li>
                <span class="d-name">{d.name}</span>
                <span class="d-line">{d.line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <svg class="annotations" aria-hidden="true" data-annotations></svg>

    <p class="scroll-cue" data-reveal>
      <Icon name="arrow-down" />
      Scroll
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 200vh;
  }
  .hero-stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
  }

  .hero-type {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    top: 27%;
  }
  .title {
    display: flex;
    flex-direction: column;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.6rem, 7.1vw, 6rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .line {
    display: block;
    width: max-content;
    max-width: 100%;
  }
  .line-2 {
    margin-left: 2.9em;
    margin-top: 0.06em;
  }
  .intro {
    margin-top: clamp(26px, 4vh, 40px);
    margin-left: calc(clamp(2.6rem, 7.1vw, 6rem) * 2.9);
    max-width: 30ch;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.45;
    color: var(--sand-2);
  }

  /* ---- slate slabs ---- */
  .slabs {
    position: absolute;
    right: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 9vh);
    width: clamp(300px, 27vw, 420px);
    aspect-ratio: 4 / 3;
    perspective: 1100px;
  }
  .slab {
    --tx: 0px;
    --ty: 0px;
    --fx: 0px;
    --fy: 0px;
    --fr: 0deg;
    position: absolute;
    inset: 0;
    border-radius: var(--radius-slab);
    box-shadow: var(--slab-shadow);
    border-top: 1px solid var(--slate-edge);
    transform-style: preserve-3d;
    transform: translate3d(calc(var(--tx) + var(--fx)), calc(var(--ty) + var(--fy)), 0) rotate(var(--fr))
      rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    will-change: transform;
  }
  .slab::after {
    /* light raking across the stone, following the cursor */
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      60% 70% at var(--lx, 30%) var(--ly, 20%),
      rgb(230 220 200 / 0.07),
      rgb(230 220 200 / 0) 70%
    );
    pointer-events: none;
  }
  .slab-back {
    background: var(--slate-2);
    --tx: -46px;
    --ty: -40px;
  }
  .slab-mid {
    background: var(--slate-3);
    --tx: -22px;
    --ty: -19px;
  }
  .slab-front {
    background: var(--slate-4);
    display: flex;
    align-items: flex-end;
    padding: clamp(18px, 2vw, 26px);
  }
  .disciplines {
    width: 100%;
  }
  .disciplines li {
    display: grid;
    gap: 2px;
    padding: 12px 0;
    border-top: 1px solid rgb(230 220 200 / 0.12);
  }
  .disciplines li:first-child {
    border-top: 0;
  }
  .d-name {
    font-stretch: 125%;
    font-weight: 640;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--sand);
  }
  .d-line {
    font-size: 0.875rem;
    color: var(--sand-2);
  }

  .annotations {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }

  .scroll-cue {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 26px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .scroll-cue :global(.icon) {
    color: var(--orange);
  }

  /* narrower screens: heading and slabs stack in normal flow, never overlap */
  @media (max-width: 900px) {
    .hero-stage {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: clamp(28px, 6vh, 56px);
      padding: calc(var(--header-h) + var(--frame) + 16px) calc(var(--frame) + var(--gutter))
        calc(var(--frame) + 64px);
    }
    .hero-type,
    .slabs {
      position: relative;
      inset: auto;
    }
    .slabs {
      align-self: flex-end;
      width: min(100% - 50px, 480px);
      aspect-ratio: auto;
    }
    .slab-front {
      position: relative; /* the front slab sets the stack's height */
      padding: 16px 20px;
    }
    /* keep the stacked slabs tight so they never ride up into the intro */
    .slab-back {
      --tx: -30px;
      --ty: -16px;
    }
    .slab-mid {
      --tx: -15px;
      --ty: -8px;
    }
    .disciplines li {
      padding: 8px 0;
    }
  }
  @media (max-width: 900px) and (max-height: 640px) {
    .d-line {
      display: none;
    }
    .title {
      font-size: clamp(2.2rem, 6vw, 3.2rem);
    }
  }
  @media (max-width: 700px) {
    .hero {
      height: 170vh;
    }
    .title {
      font-size: clamp(2.2rem, 11.2vw, 3.4rem);
      font-stretch: 112%;
    }
    .line-1 {
      width: auto;
    }
    .line-2 {
      margin-left: 1.1em;
    }
    .intro {
      margin-left: calc(clamp(2.2rem, 11.2vw, 3.4rem) * 1.1);
      margin-top: 48px;
    }
    .disciplines li {
      padding: 8px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero {
      height: auto;
    }
    .hero-stage {
      position: relative;
    }
  }
</style>
