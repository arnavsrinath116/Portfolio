---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';
const year = new Date().getFullYear();
// opens a new Gmail draft in a new tab, already addressed to me
const compose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`;
---

<footer class="site-footer" id="contact" aria-labelledby="footer-title" data-footer>
  <div class="contact-slab" data-contact data-dim="h-right">
    <div class="contact-main">
      <h2 id="footer-title" class="footer-lead">To talk about a project or a role, write to me.</h2>
      <a class="footer-email" href={compose} target="_blank" rel="noopener" data-magnet>
        <span>{site.email}</span>
        <Icon name="arrow-up-right" />
      </a>
    </div>

    <ul class="footer-links">
      <li>
        <a class="bracket" href={site.linkedin} target="_blank" rel="noopener" data-magnet>
          LinkedIn <Icon name="arrow-up-right" />
        </a>
      </li>
      <li>
        <a class="bracket" href={withBase(site.resume)} target="_blank" rel="noopener" data-magnet>Résumé <Icon name="arrow-up-right" /></a>
      </li>
      <li>
        <a class="bracket" href="#top" data-magnet data-to-top>Back to top</a>
      </li>
    </ul>
  </div>

  <div class="footer-base">
    <!-- the A.S. cube from the header, drawn flat in isometric -->
    <svg class="footer-mark" viewBox="0 0 32 32" aria-hidden="true">
      <path class="fm-top" d="M16 4 27 10.3 16 16.6 5 10.3Z" />
      <path d="M5 10.3V23L16 29.3 27 23V10.3M16 16.6V29.3" />
      <text transform="matrix(0.866 0.5 0 1 10.5 20.4)">A</text>
      <text transform="matrix(0.866 -0.5 0 1 21.5 20.4)">S</text>
    </svg>
    <span>© {year} {site.name}</span>
    <span class="footer-disc">Product, UX and HMI design</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: clamp(60px, 10vh, 110px) calc(var(--frame) + var(--gutter)) calc(var(--frame) + 22px);
  }

  .contact-slab {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px clamp(24px, 4vw, 64px);
    align-items: end;
    padding: clamp(28px, 4vw, 56px);
    background: var(--slate-3);
    border-radius: calc(var(--radius-slab) * var(--sq));
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
  }
  .contact-main {
    min-width: 0;
    container-type: inline-size;
  }
  .footer-lead {
    margin: 0;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    font-weight: 400;
    line-height: 1.5;
    color: var(--sand-2);
  }
  /* the address is the headline: as large as the slab allows, always on one line */
  .footer-email {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    margin-top: 10px;
    font-stretch: 112%;
    font-weight: 600;
    font-size: clamp(1rem, 6cqi, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    white-space: nowrap;
    color: var(--sand);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.16em;
    text-decoration-color: rgb(var(--ink-rgb) / 0.3);
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }
  .footer-email :global(.icon) {
    flex: none;
    width: 0.5em;
    height: 0.5em;
    color: var(--accent);
    transition: transform var(--dur-base) var(--ease-out);
  }
  .footer-email:focus-visible {
    color: var(--accent);
  }
  @media (hover: hover) {
    .footer-email:hover {
      color: var(--accent);
      text-decoration-color: currentColor;
    }
    .footer-email:hover :global(.icon) {
      transform: translate(2px, -2px);
    }
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px; /* room between the links' hover rings */
    margin-right: -0.9em;
    font-size: 0.9375rem;
  }
  .footer-links a {
    gap: 0.55em;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: clamp(40px, 7vh, 72px);
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .footer-mark {
    width: 28px;
    height: 28px;
    fill: none;
    stroke: var(--sand-2);
    stroke-width: 1.2;
    stroke-linejoin: round;
  }
  .footer-mark .fm-top {
    stroke: var(--accent);
  }
  .footer-mark text {
    fill: var(--sand-2);
    stroke: none;
    font-family: var(--font-letter);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 8px;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .footer-disc {
    margin-left: auto;
  }

  @media (max-width: 700px) {
    .contact-slab {
      grid-template-columns: 1fr;
    }
    .footer-links {
      flex-direction: row;
      flex-wrap: wrap;
      margin: 0 0 0 -0.9em;
    }
  }
</style>
