---
import Icon from './Icon.astro';
import { site } from '../data/site';
const year = new Date().getFullYear();
// opens a new Gmail draft in a new tab, already addressed to me
const compose = `https://mail.google.com/mail/?view=cm&fs=1&to=${encodeURIComponent(site.email)}`;
---

<footer class="site-footer" id="contact" aria-labelledby="footer-title" data-footer>
  <div class="contact-slab" data-contact data-dim="h-right">
    <div class="contact-main">
      <h2 id="footer-title" class="footer-lead" data-words>Let’s get in <span class="hl-block">touch.</span></h2>
      <a class="footer-email bracket" href={compose} target="_blank" rel="noopener" data-magnet>
        {site.email}
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>

    <ul class="footer-links">
      <li>
        <a class="bracket" href={site.linkedin} target="_blank" rel="noopener" data-magnet>
          LinkedIn <Icon name="arrow-up-right" />
        </a>
      </li>
      <li>
        <a class="bracket" href={site.resume} data-magnet>Résumé <Icon name="arrow-down" /></a>
      </li>
      <li>
        <a class="bracket" href="#top" data-magnet data-to-top>Back to top <Icon name="arrow-up" /></a>
      </li>
    </ul>

    <p class="footer-clock">
      <span class="clock-label">Local time · {site.city}</span>
      <time data-clock data-tz={site.timeZone}>--:--:--</time>
    </p>
  </div>

  <div class="wordmark-wrap" data-wordmark-wrap>
    <svg class="wordmark" viewBox="0 0 1000 150" preserveAspectRatio="xMidYMid meet" role="img" aria-label={site.name} data-wordmark>
      <g class="guides" data-wm-guides></g>
      <text class="wm-text" x="0" y="132" data-wm-text>{site.name.toUpperCase()}</text>
      <g class="points" data-wm-points></g>
    </svg>
  </div>

  <div class="footer-base">
    <span>© {year} {site.name}</span>
    <span>{site.disciplines.join(' · ')}</span>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    padding: clamp(60px, 10vh, 110px) calc(var(--frame) + var(--gutter)) calc(var(--frame) + 22px);
  }

  .contact-slab {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 3fr) minmax(0, 2fr);
    gap: 32px clamp(24px, 4vw, 64px);
    align-items: end;
    padding: clamp(28px, 4vw, 56px);
    background: var(--slate-3);
    border-radius: var(--radius-slab);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
  }
  .footer-lead {
    font-stretch: 112%;
    font-weight: 560;
    font-size: clamp(1.6rem, 3.1vw, 2.75rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 18ch;
    text-wrap: balance;
  }
  .footer-email {
    margin: 22px 0 0 -0.9em;
    font-stretch: 112%;
    font-weight: 520;
    font-size: clamp(1.125rem, 1.9vw, 1.625rem);
    letter-spacing: -0.01em;
    color: var(--sand);
    text-decoration: underline 1px var(--sand-3);
    text-underline-offset: 0.28em;
    overflow-wrap: anywhere;
  }
  /* phones: the address scales to stay on one line rather than breaking mid-domain */
  @media (max-width: 520px) {
    .footer-email {
      font-size: clamp(0.75rem, 3.7vw, 1.125rem);
      white-space: nowrap;
      overflow-wrap: normal;
    }
  }
  .footer-email :global(.icon) {
    flex: none;
  }
  .footer-email:focus-visible {
    color: var(--accent);
  }
  @media (hover: hover) {
    .footer-email:hover {
      text-decoration-color: transparent;
    }
  }
  .footer-links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    margin-left: -0.9em;
    font-size: 0.9375rem;
  }
  .footer-links a {
    gap: 0.55em;
  }
  .footer-clock {
    display: grid;
    gap: 4px;
    justify-items: end;
    text-align: right;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .footer-clock time {
    color: var(--sand);
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }

  .wordmark-wrap {
    margin-top: clamp(56px, 10vh, 110px);
  }
  .wordmark {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .wm-text {
    font-family: var(--font-letter);
    font-stretch: 125%;
    font-weight: 640;
    font-size: 150px;
    fill: transparent;
    stroke: var(--sand);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .wordmark :global(.guide) {
    stroke: var(--line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .wordmark :global(.cpoint) {
    stroke: var(--accent);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .footer-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 28px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--sand-3);
  }

  @media (max-width: 860px) {
    .contact-slab {
      grid-template-columns: 1fr 1fr;
    }
    .contact-main {
      grid-column: 1 / -1;
    }
    .footer-clock {
      justify-items: start;
      text-align: left;
    }
  }
</style>
