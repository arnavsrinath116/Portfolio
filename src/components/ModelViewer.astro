---
import type { SkillModel } from '../data/skills';
import { withBase } from '../lib/url';

interface Props {
  model: SkillModel;
  title: string;
}
const { model, title } = Astro.props;
const mm = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(1));
const [x, y, z] = model.size;
---

<!-- a Fusion model, turned by hand: modelViewer.ts loads three.js only when this scrolls into view -->
<figure
  class="mv"
  data-model={withBase(model.src)}
  data-section={model.section ? '' : undefined}
  data-fade={model.fade?.join(',')}
>
  <div
    class="mv-stage"
    tabindex="0"
    role="img"
    aria-label={`3D model of the ${title}. Drag, or use the left and right arrow keys, to turn it.`}
    data-mv-stage
  >
    <p class="mv-status" data-mv-status>Loading model</p>
    {
      (model.section || model.fade) && (
        <div class="mv-corner">
          {model.section && (
            <button type="button" class="mv-btn" aria-pressed="true" data-mv-section>
              Section
            </button>
          )}
          {model.fade && (
            <button type="button" class="mv-btn" aria-pressed="false" data-mv-fade>
              Opacity
            </button>
          )}
        </div>
      )
    }
    <!-- the view cube: turns with the camera; a side face turns the model to that view -->
    <svg class="mv-cube" viewBox="-1.3 -1.3 2.6 2.6" aria-hidden="true" data-mv-cube></svg>
    <button type="button" class="mv-home" aria-label="Reset view" title="Home view" data-mv-reset>
      <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2.5 7.5 8 3l5.5 4.5M4 6.5V13h3V9.5h2V13h3V6.5" /></svg>
    </button>
  </div>
  <figcaption class="mv-bar">
    <span class="mv-dims">{mm(x)} × {mm(y)} × {mm(z)} mm</span>
    <span class="mv-parts">{model.parts} {model.parts === 1 ? 'part' : 'parts'}</span>
  </figcaption>
</figure>

<style>
  .mv {
    margin: 0;
  }
  .mv-stage {
    position: relative;
    aspect-ratio: 16 / 9;
    max-height: 560px;
    width: 100%;
    overflow: hidden;
    border-radius: 10px;
    background:
      radial-gradient(120% 90% at 50% 40%, rgb(var(--ink-rgb) / 0.05), transparent 60%),
      rgb(var(--bg-rgb) / 0.55);
    border: 1px solid rgb(var(--ink-rgb) / 0.08);
    cursor: grab;
  }
  .mv-stage:active {
    cursor: grabbing;
  }
  .mv-stage:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .mv-stage :global(canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  .mv-stage:global(.is-ready) :global(canvas) {
    opacity: 1;
  }
  .mv-status {
    position: absolute;
    inset: 0;
    pointer-events: none; /* it sits over the canvas: never let it catch a drag or a scroll */
    display: grid;
    place-items: center;
    color: var(--sand-3);
    font-size: 0.8125rem;
    transition: opacity 300ms ease-out;
  }
  .mv-stage:global(.is-ready) .mv-status {
    opacity: 0;
  }
  .mv-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  /* a measurement: the one place mono type is used */
  .mv-dims {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .mv-btn {
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid rgb(var(--ink-rgb) / 0.16);
    color: var(--sand-2);
    font-size: 0.8125rem;
    transition:
      color 200ms ease-out,
      border-color 200ms ease-out,
      background-color 200ms ease-out;
  }
  .mv-btn[aria-pressed='true'] {
    color: var(--slate);
    background: var(--sand);
    border-color: var(--sand);
  }
  @media (hover: hover) {
    .mv-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
    .mv-btn[aria-pressed='true']:hover {
      color: var(--on-accent);
      background: var(--accent-fill);
    }
  }
  /* the feature toggles (Section, Opacity): the accent, so they read as the thing to try. On, a
     filled pill; off, an outlined one. Until one has been clicked, a soft ring pulses round them */
  .mv-btn[data-mv-section],
  .mv-btn[data-mv-fade] {
    position: relative;
    font-weight: 600;
    color: var(--accent);
    border-color: var(--accent);
  }
  .mv-btn[data-mv-section][aria-pressed='true'],
  .mv-btn[data-mv-fade][aria-pressed='true'] {
    color: var(--on-accent);
    background: var(--accent-fill);
    border-color: var(--accent-fill);
  }
  .mv-btn[data-mv-section]::after,
  .mv-btn[data-mv-fade]::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    box-shadow: 0 0 0 0 rgb(148 196 217 / 0.55);
    animation: mv-call 2.2s ease-out infinite;
    pointer-events: none;
  }
  .mv:global(.is-tried) .mv-btn::after {
    animation: none;
  }
  @keyframes mv-call {
    0% {
      box-shadow: 0 0 0 0 rgb(148 196 217 / 0.55);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px rgb(148 196 217 / 0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mv-btn::after {
      animation: none;
    }
  }
  /* the model's own controls (Section, Opacity) sit on the stage, bottom right; off, on a wash
     of the page so they read over the model */
  .mv-corner {
    position: absolute;
    right: 12px;
    bottom: 12px;
    z-index: 1;
    display: flex;
    gap: 8px;
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  .mv-stage:global(.is-ready) .mv-corner {
    opacity: 1;
  }
  .mv-corner .mv-btn:not([aria-pressed='true']) {
    background: rgb(var(--bg-rgb) / 0.78);
  }

  /* the view cube, top right of the stage (modelViewer.ts draws it): six faces and an RGB axis triad */
  .mv-cube {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    width: 92px;
    height: 92px;
    overflow: visible;
    touch-action: none; /* a drag on the cube turns the model, never scrolls the card */
    cursor: grab;
    opacity: 0;
    transition: opacity 600ms ease-out;
  }
  .mv-stage:global(.is-ready) .mv-cube {
    opacity: 1;
  }
  .mv-cube :global(.cf) {
    cursor: pointer;
  }
  .mv-cube:global(.is-dragging),
  .mv-cube:global(.is-dragging) :global(.cf) {
    cursor: grabbing;
  }
  .mv-cube :global(.cf polygon) {
    fill: rgb(var(--bg-rgb));
    fill-opacity: 0.86;
    stroke: rgb(var(--ink-rgb) / 0.38);
    stroke-width: 0.025;
    stroke-linejoin: round;
    transition: fill 160ms ease-out;
  }
  .mv-cube :global(.cf text) {
    fill: rgb(var(--ink-rgb) / 0.7);
    font-size: 0.19px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-anchor: middle;
    dominant-baseline: central;
    user-select: none;
  }
  /* home: back to the starting view, a bare icon in the cube's corner */
  .mv-home {
    position: absolute;
    top: 6px;
    right: 6px;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    background: none;
    color: rgb(var(--ink-rgb) / 0.7);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 600ms ease-out,
      color 160ms ease-out;
  }
  .mv-stage:global(.is-ready) .mv-home {
    opacity: 1;
  }
  .mv-home svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .mv-home:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 2px;
  }
  @media (hover: hover) {
    .mv-home:hover {
      color: var(--accent);
    }
  }
  /* the face whose view is held */
  .mv-cube :global(.cf.is-locked polygon) {
    fill: var(--accent);
    fill-opacity: 0.9;
  }
  .mv-cube :global(.cf.is-locked text) {
    fill: var(--on-accent);
  }
  @media (hover: hover) {
    .mv-cube:not(:global(.is-dragging)) :global(.cf:hover polygon) {
      fill: var(--accent);
      fill-opacity: 0.9;
    }
    .mv-cube:not(:global(.is-dragging)) :global(.cf:hover text) {
      fill: var(--on-accent);
    }
  }
  .mv-cube :global(.ax) {
    stroke-width: 0.045;
    stroke-linecap: round;
  }
  .mv-cube :global(text.ax-l) {
    stroke: none;
    font-size: 0.2px;
    font-weight: 700;
    text-anchor: middle;
    dominant-baseline: central;
  }
  .mv-cube :global(.ax-x) {
    stroke: #e5484d;
    fill: #e5484d;
  }
  .mv-cube :global(.ax-y) {
    stroke: #3fa86b;
    fill: #3fa86b;
  }
  .mv-cube :global(.ax-z) {
    stroke: #3e7ff0;
    fill: #3e7ff0;
  }

  @media (max-width: 600px) {
    .mv-stage {
      aspect-ratio: 4 / 3;
    }
    .mv-cube {
      top: 4px;
      right: 4px;
      width: 64px;
      height: 64px;
    }
    .mv-home {
      top: 4px;
      right: 4px;
      width: 24px;
      height: 24px;
    }
    .mv-corner {
      right: 8px;
      bottom: 8px;
    }
  }
</style>
