---
import Icon from './Icon.astro';
import WireLogo from './WireLogo.astro';
import { skills } from '../data/skills';
import { withBase } from '../lib/url';

// sheet numbers, as on a drawing set: S-01, S-02…
const sheet = (i: number) => `S-${String(i + 1).padStart(2, '0')}`;
// only finished pieces count as works; the rest are still in drafting
const built = (s: (typeof skills)[number]) => s.works.filter((w) => !w.pending).length;

// the hover peek: one small thumbnail from each finished work in the skill (its first image, the
// middle screen of a prototype, or a film's poster), from /skills/peek
type Shot = { src: string; ratio: number; phone?: boolean };
const thumb = (src: string) => withBase(`/skills/peek/${src.split('/').pop()}`);
// a little mess: each card at its own angle and height
const TILT = [-7, 5, -3, 8];
const DROP = [-5, 4, -2, 6];
const pile = (sk: (typeof skills)[number]): Shot[] =>
  sk.works
    .filter((w) => !w.pending)
    .map((w): Shot | null => {
      const im = w.images?.[0];
      if (im) return { src: im.src, ratio: im.width / im.height };
      const sc = w.prototype?.screens[1] ?? w.prototype?.screens[0];
      if (sc) return { src: sc.src, ratio: 402 / 874, phone: true };
      if (w.video) return { src: w.video.poster, ratio: w.video.width / w.video.height };
      return null;
    })
    .filter((s): s is Shot => s !== null);
---

<section class="skills" id="skills" aria-labelledby="skills-title">
  <div class="skills-head">
    <h2 id="skills-title" class="skills-title" data-words><span class="hl-block">Skills</span></h2>
    <p class="skills-note">What I <span class="hl">can do</span>, as a set of sheets. Open one to see the work.</p>
  </div>

  <!-- a drawing index: the sheet list, with the hovered sheet's drawing in the viewport beside it -->
  <div class="set" data-rise-group data-skills data-skill-set>
    <div class="view" aria-hidden="true" data-panel data-wire-host>
      <span class="view-cross view-tl"></span><span class="view-cross view-tr"></span>
      <span class="view-cross view-bl"></span><span class="view-cross view-br"></span>
      {
        skills.map((s, i) => (
          <div class:list={['view-item', { 'is-on': i === 0 }]} data-view={s.slug}>
            <WireLogo paths={s.logo} label="" />
          </div>
        ))
      }
      <p class="view-label">
        {
          skills.map((s, i) => (
            <span class:list={{ 'is-on': i === 0 }} data-view-label={s.slug}>
              {sheet(i)} · {s.name}
            </span>
          ))
        }
      </p>
    </div>

    <ol class="index" data-panel>
      {
        skills.map((s, i) => (
          <li>
            <a href={`#skill-${s.slug}`} class="row" data-open-project={`skill-${s.slug}`} data-pick={s.slug} data-wire-host>
              <span class="row-no">{sheet(i)}</span>
              <span class="row-ico">
                <WireLogo paths={s.logo} label="" />
              </span>
              <span class="row-text">
                <span class="row-name">{s.name}</span>
                <span class="row-tools">{s.tools.join(' · ')}</span>
              </span>
              {pile(s).length > 0 && (
                <span class="row-peek" aria-hidden="true">
                  {pile(s).map((sh, k, all) => (
                    <span
                      class:list={['peek', { 'is-phone': sh.phone }]}
                      style={`--i:${k};--k:${all.length - 1 - k};--r:${TILT[k % 4]}deg;--y:${DROP[k % 4]}px;--ratio:${sh.ratio}`}
                    >
                      <img src={thumb(sh.src)} alt="" loading="lazy" decoding="async" />
                    </span>
                  ))}
                </span>
              )}
              <span class:list={['row-state', { 'is-pending': !built(s) }]}>{built(s) ? `${String(built(s)).padStart(2, '0')} works` : 'In drafting'}</span>
              <Icon name="arrow-up-right" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // hovering or focusing a sheet in the index puts its drawing in the viewport
  document.querySelectorAll<HTMLElement>('[data-skill-set]').forEach((set) => {
    const pick = (slug: string) => {
      set.querySelectorAll<HTMLElement>('[data-view]').forEach((v) => v.classList.toggle('is-on', v.dataset.view === slug));
      set.querySelectorAll<HTMLElement>('[data-view-label]').forEach((v) => v.classList.toggle('is-on', v.dataset.viewLabel === slug));
      set.querySelectorAll<HTMLElement>('[data-pick]').forEach((r) => r.classList.toggle('is-on', r.dataset.pick === slug));
    };
    set.querySelectorAll<HTMLElement>('[data-pick]').forEach((row) => {
      // the peek never covers the name: shrink it to the room left after the name, if it's short
      const peek = row.querySelector<HTMLElement>('.row-peek');
      const name = row.querySelector<HTMLElement>('.row-name');
      const fit = () => {
        if (!peek || !name) return;
        const cards = Array.from(peek.querySelectorAll<HTMLElement>('.peek'));
        const span = Math.max(...cards.map((c) => -c.offsetLeft), 0) + 12; // cards hang left of the anchor
        const r = row.getBoundingClientRect();
        // where the name's text actually ends (its box spans the whole column)
        const range = document.createRange();
        range.selectNodeContents(name);
        const nameRight = Math.max(...Array.from(range.getClientRects()).map((b) => b.right));
        const room = r.right - 6 - nameRight - 18;
        peek.style.setProperty('--fit', String(Math.max(0.45, Math.min(1, room / span))));
      };
      row.addEventListener('pointerenter', fit);
      const go = () => pick(row.dataset.pick!);
      row.addEventListener('pointerenter', go);
      row.addEventListener('focus', go);
    });
  });

</script>

<style>
  .skills {
    position: relative;
    padding: clamp(20px, 4vh, 48px) calc(var(--frame) + var(--gutter)) clamp(90px, 14vh, 160px);
  }
  .skills-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 24px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(32px, 6vh, 60px);
  }
  .skills-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .skills-note {
    max-width: 40ch;
    color: var(--sand-2);
    font-size: 1rem;
    line-height: 1.55;
  }

  /* ---------- the set: viewport + index, one slab ---------- */
  .set {
    position: relative;
    z-index: 1; /* the guiding line passes behind */
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    border-radius: var(--radius-slab);
    background: var(--slate-2);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
    overflow: hidden;
  }
  .set > [data-panel] {
    --rise: 0px; /* scroll entrance (guide.ts) */
    transform: translateY(var(--rise));
  }

  /* viewport: a patch of drafting grid with registration crosses */
  .view {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0; /* stays in its column: it takes the index's height, never grows wider to stay square */
    min-height: 360px;
    border-right: 1px solid var(--line-faint);
    background:
      linear-gradient(var(--line-faint) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px) 0 0 / 24px 24px,
      rgb(var(--bg-rgb) / 0.35);
    --wire-ink: var(--sand);
  }
  .view-item {
    grid-area: 1 / 1;
    width: 52%;
    opacity: 0;
    transform: scale(0.94);
    transition:
      opacity 0.35s ease-out,
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .view-item:not(.is-on) {
    visibility: hidden;
    transition:
      opacity 0.2s ease-out,
      transform 0.2s ease-out,
      visibility 0s 0.2s;
  }
  .view-item.is-on {
    opacity: 1;
    transform: none;
  }
  .view-cross {
    position: absolute;
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--sand-3), var(--sand-3)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--sand-3), var(--sand-3)) 0 50% / 100% 1px no-repeat;
  }
  .view-tl {
    top: 16px;
    left: 16px;
  }
  .view-tr {
    top: 16px;
    right: 16px;
  }
  .view-bl {
    bottom: 16px;
    left: 16px;
  }
  .view-br {
    bottom: 16px;
    right: 16px;
  }
  .view-label {
    position: absolute;
    left: 36px;
    bottom: 13px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  .view-label span:not(.is-on) {
    display: none;
  }

  /* index: one row per sheet */
  .index {
    display: grid;
    align-content: center;
    margin: 0;
    /* the numbers stand off the viewport by about the gap between number and icon */
    padding: clamp(8px, 1.5vw, 20px) clamp(16px, 2.4vw, 36px) clamp(8px, 1.5vw, 20px) clamp(20px, 2.8vw, 40px);
    list-style: none;
  }
  .index li + li {
    border-top: 1px solid var(--line-faint);
  }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: 52px 44px minmax(0, 1fr) auto 14px;
    align-items: center;
    gap: clamp(12px, 1.6vw, 22px);
    padding: clamp(16px, 2.6vh, 26px) 4px;
    color: inherit;
    text-decoration: none;
    background: var(--slate-2); /* the card grows out of this colour */
    --wire-ink: var(--sand-2);
  }
  .row-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--sand-3);
    transition: color var(--dur-base) var(--ease-out);
  }
  .row-ico {
    display: block;
    width: 40px;
  }
  .row-text {
    display: grid;
    gap: 5px;
    min-width: 0;
  }
  .row-name {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.05rem, 1.7vw, 1.5rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .row-tools {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  /* the peek: hovering a sheet tips its works out of the row's right end, small, tilted and
     overlapping, where the work count sits (which steps aside for them) */
  .row-peek {
    position: absolute;
    top: 50%;
    right: 6px;
    height: 0;
    pointer-events: none;
    /* shrunk on hover when the name leaves too little room (Skills.astro script) */
    scale: var(--fit, 1);
    transform-origin: 100% 50%;
  }
  .peek {
    position: absolute;
    right: calc(var(--k) * 32px);
    top: 0;
    height: 54px;
    aspect-ratio: var(--ratio);
    padding: 3px;
    border-radius: 3px;
    background: #f8f5ef;
    box-shadow:
      0 0 0 1px rgb(20 23 26 / 0.1),
      0 10px 20px -10px rgb(20 23 26 / 0.5);
    opacity: 0;
    transform: translateY(calc(-50% + 16px)) rotate(calc(var(--r) * -2.5)) scale(0.55);
    transition:
      transform 0.2s ease-in,
      opacity 0.15s ease-in;
  }
  .peek.is-phone {
    height: 68px;
    border-radius: 9px;
  }
  .peek img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 2px;
  }
  .peek.is-phone img {
    border-radius: 7px;
  }
  @media (hover: hover) {
    .row:hover .peek,
    .row:focus-visible .peek {
      opacity: 1;
      transform: translateY(calc(-50% + var(--y))) rotate(var(--r)) scale(1);
      transition:
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 0.06s),
        opacity 0.2s ease-out calc(var(--i) * 0.06s);
    }
    .row:has(.row-peek):hover .row-state,
    .row:has(.row-peek):focus-visible .row-state,
    .row:has(.row-peek):hover > :global(.icon),
    .row:has(.row-peek):focus-visible > :global(.icon) {
      opacity: 0;
    }
  }
  @media (hover: none) {
    .row-peek {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .row:hover .peek,
    .row:focus-visible .peek {
      transition: opacity 0.2s ease-out;
    }
  }

  .row-state {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sand-2);
    white-space: nowrap;
    transition: opacity 0.2s var(--ease-out);
  }
  /* dashed means not yet drawn */
  .row-state.is-pending {
    padding-bottom: 2px;
    border-bottom: 1px dashed var(--sand-3);
    color: var(--sand-3);
  }
  .row :global(.icon) {
    color: var(--sand-3);
    transition:
      transform var(--dur-base) var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .row.is-on .row-no,
  .row:focus-visible .row-no {
    color: var(--accent);
  }
  .row.is-on .row-name {
    transform: translateX(6px);
  }
  .row.is-on {
    --wire-ink: var(--accent);
  }
  .row.is-on :global(.icon) {
    color: var(--accent);
    transform: translate(2px, -2px);
  }
  .row:focus-visible {
    outline-offset: -2px;
  }

  @media (max-width: 860px) {
    .skills-head {
      grid-template-columns: 1fr;
    }
  }
  /* phones: the index alone; each row keeps its own small drawing */
  @media (max-width: 760px) {
    .set {
      grid-template-columns: 1fr;
    }
    .view {
      display: none;
    }
    .row {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 4px 14px;
    }
    .row-no,
    .row :global(.icon) {
      display: none;
    }
    .row-ico {
      grid-row: span 2;
    }
    .row-state {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
