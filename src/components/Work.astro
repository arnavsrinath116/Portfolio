---
import Icon from './Icon.astro';
import { projects } from '../data/projects';

const notes: Record<string, string> = {
  product: 'Object, CAD and prototype',
  ux: 'Research, flows and screens',
  hmi: 'Controls and the interface between',
};
---

<section class="work" id="work" aria-labelledby="work-title" data-work>
  <div class="work-head" data-guide-a>
    <h2 id="work-title" class="work-title" data-dim="w-top" data-dim-text>Selected work</h2>
    <p class="work-note">
      Three case studies, each told through the Double Diamond: discover, define, develop, deliver. Open one to
      read it.
    </p>
  </div>

  <div class="work-grid" data-rise-group>
    {
      projects.map((p) => (
        <a
          href={`#project-${p.slug}`}
          data-open-project={p.slug}
          class={`panel panel-${p.slug}`}
          data-panel={p.slug}
          data-dim={p.slug === 'product' ? 'h-left' : undefined}
        >
          <div class="panel-frame" aria-hidden="true" />
          <div class="panel-meta">
            <h3 class="panel-title">
              {p.discipline}
            </h3>
            <p class="panel-note">{notes[p.slug]}</p>
            <p class="panel-status">
              <span class="status-dot" aria-hidden="true" />
              Open case study
              <Icon name="arrow-up-right" />
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: clamp(110px, 18vh, 200px) calc(var(--frame) + var(--gutter)) clamp(90px, 14vh, 160px);
  }
  .work-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 24px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(40px, 7vh, 72px);
  }
  .work-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .work-note {
    max-width: 40ch;
    color: var(--sand-2);
    font-size: 1rem;
    line-height: 1.55;
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: clamp(16px, 2vw, 28px);
  }
  .panel {
    position: relative;
    z-index: 1; /* the guiding line passes behind the slabs */
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 22px;
    padding: clamp(16px, 1.8vw, 24px);
    border-radius: var(--radius-slab);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
  }
  .panel-product {
    grid-row: 1 / span 2;
    background: var(--slate-3);
    min-height: clamp(420px, 62vh, 640px);
  }
  .panel-ux {
    background: var(--slate-2);
    min-height: clamp(220px, 30vh, 300px);
  }
  .panel-hmi {
    background: var(--slate-4);
    min-height: clamp(220px, 30vh, 300px);
  }
  /* dashed = not drawn yet: where the project's visual will sit */
  .panel-frame {
    border: 1px dashed rgb(230 220 200 / 0.16);
    border-radius: 8px;
    min-height: 90px;
  }
  .panel-meta {
    display: grid;
    gap: 6px;
  }
  .panel-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .panel-note {
    color: var(--sand-2);
    font-size: 0.9375rem;
  }
  .panel-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  /* the whole slab is the link: lift and light on hover */
  a.panel {
    --rise: 0px; /* scroll entrance (guide.ts) */
    --lift: 0px; /* hover */
    transform: translateY(calc(var(--rise) + var(--lift)));
    color: inherit;
    transition:
      transform var(--dur-slow) var(--ease-out),
      box-shadow var(--dur-slow) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    a.panel:hover {
      --lift: -6px;
      border-top-color: rgb(230 220 200 / 0.2);
      box-shadow:
        0 1px 0 rgb(255 255 255 / 0.04) inset,
        0 36px 64px -18px rgb(0 0 0 / 0.65),
        0 10px 20px -8px rgb(0 0 0 / 0.45);
    }
    a.panel:hover .panel-status {
      color: var(--orange);
    }
  }
  a.panel:focus-visible {
    outline-offset: 4px;
  }
  .panel-status :global(.icon) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  a.panel:hover .panel-status :global(.icon) {
    transform: translate(2px, -2px);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border: 1px solid var(--orange);
  }

  @media (max-width: 860px) {
    .work-head,
    .work-grid {
      grid-template-columns: 1fr;
    }
    .panel-product {
      grid-row: auto;
      min-height: 360px;
    }
  }
</style>
