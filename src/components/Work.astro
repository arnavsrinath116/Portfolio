---
// Placeholder slabs for the three case studies. Nothing here is a claim:
// each panel says what discipline it is and that the write-up is in progress.
const projects = [
  { key: 'product', discipline: 'Product', note: 'Object, CAD and prototype' },
  { key: 'ux', discipline: 'UX', note: 'Research, flows and screens' },
  { key: 'hmi', discipline: 'HMI', note: 'Controls and the interface between' },
];
---

<section class="work" id="work" aria-labelledby="work-title" data-work>
  <div class="work-head" data-guide-a>
    <h2 id="work-title" class="work-title" data-dim="w-top" data-dim-text>Selected work</h2>
    <p class="work-note">
      Three case studies are in progress: a product, a UX project and an HMI. Each one appears here as it is
      finished.
    </p>
  </div>

  <div class="work-grid">
    {
      projects.map((p) => (
        <article class={`panel panel-${p.key}`} data-panel={p.key} data-dim={p.key === 'product' ? 'h-left' : undefined}>
          <div class="panel-frame" aria-hidden="true" />
          <div class="panel-meta">
            <h3 class="panel-title">{p.discipline}</h3>
            <p class="panel-note">{p.note}</p>
            <p class="panel-status">
              <span class="status-dot" aria-hidden="true" />
              Case study in progress
            </p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .work {
    position: relative;
    padding: clamp(110px, 18vh, 200px) calc(var(--frame) + var(--gutter)) clamp(90px, 14vh, 160px);
  }
  .work-head {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 24px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(40px, 7vh, 72px);
  }
  .work-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2rem, 4.4vw, 3.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .work-note {
    max-width: 40ch;
    color: var(--sand-2);
    font-size: 1rem;
    line-height: 1.55;
  }

  .work-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: clamp(16px, 2vw, 28px);
  }
  .panel {
    position: relative;
    z-index: 1; /* the guiding line passes behind the slabs */
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 22px;
    padding: clamp(16px, 1.8vw, 24px);
    border-radius: var(--radius-slab);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
  }
  .panel-product {
    grid-row: 1 / span 2;
    background: var(--slate-3);
    min-height: clamp(420px, 62vh, 640px);
  }
  .panel-ux {
    background: var(--slate-2);
    min-height: clamp(220px, 30vh, 300px);
  }
  .panel-hmi {
    background: var(--slate-4);
    min-height: clamp(220px, 30vh, 300px);
  }
  /* dashed = not drawn yet: where the project's visual will sit */
  .panel-frame {
    border: 1px dashed rgb(230 220 200 / 0.16);
    border-radius: 8px;
    min-height: 90px;
  }
  .panel-meta {
    display: grid;
    gap: 6px;
  }
  .panel-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.25rem, 1.9vw, 1.75rem);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .panel-note {
    color: var(--sand-2);
    font-size: 0.9375rem;
  }
  .panel-status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border: 1px solid var(--orange);
  }

  @media (max-width: 860px) {
    .work-head,
    .work-grid {
      grid-template-columns: 1fr;
    }
    .panel-product {
      grid-row: auto;
      min-height: 360px;
    }
  }
</style>
