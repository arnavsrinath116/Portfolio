---
import { withBase } from '../lib/url';
import { site } from '../data/site';

interface Props {
  /** on pages other than home: a back-to-home button by the logo, and the bar never hides */
  back?: boolean;
}
const { back = false } = Astro.props;

// the sections of the page, always one click away
const tabs = [
  { label: 'Work', href: withBase('/#work') },
  { label: 'Skills', href: withBase('/#skills') },
  { label: 'Contact', href: '#contact' }, // every page ends on the contact slab
];
---


<header class="site-header" data-header data-reveal data-pinned={back ? '' : undefined}>
  <div class="hdr-left">
  <a class="logo" href={withBase('/')} aria-label={`${site.name}, home`} data-magnet>
    <span class="cube-stage" aria-hidden="true">
      <span class="cube">
        <span class="face front">A</span>
        <span class="face right">S</span>
        <span class="face back">A</span>
        <span class="face left">S</span>
        <span class="face top"></span>
        <span class="face bottom"></span>
      </span>
    </span>
  </a>
  {
    back && (
      <a class="back-btn" href={withBase('/')} aria-label="Back to home" data-magnet>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M10 6H2M5.5 2.5 2 6l3.5 3.5" /></svg>
        Home
      </a>
    )
  }
  </div>


  <div class="hdr-right">
    <!-- every section, right on the header -->
    <nav class="hdr-nav" aria-label="Sections">
      <ul>
        {
          tabs.map((t) => (
            <li>
              <a class="bracket" href={t.href} data-nav-link data-magnet>
                {t.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- the one thing a reviewer reaches for first: always in the top bar -->
    <a class="resume-btn" href={withBase(site.resume)} target="_blank" rel="noopener" data-magnet>
      Résumé
      <svg class="resume-ico" viewBox="0 0 12 12" aria-hidden="true"><path d="M6 1.5v7M3 5.5 6 8.5 9 5.5M2 10.5h8"></path></svg>
    </a>

    <!-- light / dark: a switch, moon on the dark side, sun on the light -->
    <button class="theme-switch" type="button" role="switch" aria-checked="false" aria-label="Light mode" data-theme-toggle data-magnet>
      <span class="ts-track" aria-hidden="true">
        <svg class="ts-ico ts-moon" viewBox="0 0 16 16"><path d="M12.6 10.2A5.4 5.4 0 0 1 5.8 3.4 5.4 5.4 0 1 0 12.6 10.2Z"></path></svg>
        <svg class="ts-ico ts-sun" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3"></circle><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M3.5 12.5l1.3-1.3M11.2 4.8l1.3-1.3"></path></svg>
        <span class="ts-knob">
          <svg class="ts-ico ts-moon" viewBox="0 0 16 16"><path d="M12.6 10.2A5.4 5.4 0 0 1 5.8 3.4 5.4 5.4 0 1 0 12.6 10.2Z"></path></svg>
          <svg class="ts-ico ts-sun" viewBox="0 0 16 16"><circle cx="8" cy="8" r="3"></circle><path d="M8 1.6v1.8M8 12.6v1.8M1.6 8h1.8M12.6 8h1.8M3.5 3.5l1.3 1.3M11.2 11.2l1.3 1.3M3.5 12.5l1.3-1.3M11.2 4.8l1.3-1.3"></path></svg>
        </span>
      </span>
    </button>
  </div>
</header>

<script>
  // flip the sheet between dark and light (the switch is "light mode": on = light), remember it, and crossfade where the browser can
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const meta = document.querySelector<HTMLMetaElement>('[data-theme-color]');
  const reflect = () => {
    const light = root.dataset.theme === 'light';
    btn?.setAttribute('aria-checked', String(light));
    meta?.setAttribute('content', light ? '#ece6da' : '#14171a');
  };
  const apply = (light: boolean) => {
    if (light) root.dataset.theme = 'light';
    else delete root.dataset.theme;
    reflect();
    document.dispatchEvent(new CustomEvent('themechange', { detail: { light } }));
  };
  btn?.addEventListener('click', () => {
    const next = root.dataset.theme !== 'light';
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reduce) doc.startViewTransition(() => apply(next));
    else apply(next);
  });
  reflect();
</script>

<style>
  .site-header {
    position: fixed;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    z-index: 8600;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 0 var(--gutter);
    /* no bar: just the mark, the tabs and the switch floating over the page */
    background: transparent;
    pointer-events: none;
    transition:
      transform 0.6s var(--ease-out),
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }

  .site-header > * {
    pointer-events: auto;
  }
  .site-header:global(.is-hidden) {
    transform: translateY(calc(-100% - var(--frame) - 2px));
  }

  .hdr-left {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: clamp(20px, 2.4vw, 36px);
  }
  /* back to the front page: just an arrow, set apart from the logo */
  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--dur-base) var(--ease-out);
  }
  .back-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .back-btn:hover {
      color: var(--accent);
    }
    .back-btn:hover svg {
      transform: translateX(-3px);
    }
  }

  /* ---- Isometric AS cube: true 3D, orthographic (no perspective) ---- */
  .logo {
    justify-self: start;
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%; /* the mercury cursor wraps it as a circle */
  }
  .cube-stage {
    --s: 22px;
    width: var(--s);
    height: var(--s);
    position: relative;
  }
  .cube {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(-35.264deg) rotateY(-45deg);
    transition: transform 1.1s var(--ease-inout);
  }
  @media (hover: hover) {
    .logo:hover .cube {
      transform: rotateX(-35.264deg) rotateY(-405deg);
    }
  }
  .logo:focus-visible .cube {
    transform: rotateX(-35.264deg) rotateY(-405deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    font-family: var(--font-letter);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    backface-visibility: hidden;
  }
  .front {
    transform: translateZ(calc(var(--s) / 2));
  }
  .back {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }
  .right {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
  }
  .left {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
  }
  .top {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
    border-color: var(--accent);
  }
  .bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
  }
  /* hidden edges read through the open faces, as on a real isometric drawing */
  .top,
  .bottom {
    backface-visibility: visible;
  }


  .hdr-right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(6px, 1.4vw, 22px);
  }
  .hdr-nav ul {
    display: flex;
    gap: clamp(0px, 0.4vw, 6px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hdr-nav a {
    color: inherit;
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* the section you're reading: in the accent, its brackets drawn */
  .hdr-nav a:global([aria-current='location']) {
    color: var(--accent);
  }
  .hdr-nav a:global([aria-current='location'])::before,
  .hdr-nav a:global([aria-current='location'])::after {
    opacity: 1;
    transform: none;
  }

  /* résumé: the only filled control in the bar, so it reads as the primary action */
  .resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 30px;
    padding: 0 13px;
    border-radius: 15px;
    background: var(--accent-fill);
    color: var(--on-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .resume-ico {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .resume-btn:hover .resume-ico {
      transform: translateY(2px);
    }
  }
  .resume-btn:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  /* the switch: a pill track with both marks, and a knob carrying the current one */
  /* the button is the pill itself, so the mercury cursor wraps it as a pill
     (it follows the hovered element's own corner radius) */
  .theme-switch {
    display: grid;
    place-items: center;
    padding: 0;
    border-radius: 13px;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .ts-track {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 48px;
    height: 26px;
    padding: 0 6px;
    border: 1px solid var(--sand-3);
    border-radius: 13px;
    transition: border-color var(--dur-base) var(--ease-out);
  }
  .ts-ico {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ts-track > .ts-ico {
    color: var(--sand-3);
  }
  .ts-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--sand);
    color: var(--slate);
    transition: transform 0.45s cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  .ts-knob .ts-ico {
    grid-area: 1 / 1;
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.45s var(--ease-out);
  }
  .ts-knob .ts-sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }
  :global(html[data-theme='light']) .ts-knob {
    transform: translateX(22px);
  }
  :global(html[data-theme='light']) .ts-knob .ts-moon {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }
  :global(html[data-theme='light']) .ts-knob .ts-sun {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) {
    .theme-switch:hover .ts-track {
      border-color: var(--accent);
    }
  }
  .theme-switch:focus-visible {
    outline: none;
  }
  /* touch: an invisible, larger hit area round the small controls */
  @media (pointer: coarse) {
    .theme-switch,
    .resume-btn,
    .back-btn {
      position: relative;
    }
    .theme-switch::before,
    .resume-btn::before,
    .back-btn::before {
      content: '';
      position: absolute;
      inset: -8px -4px;
    }
  }
  .theme-switch:focus-visible .ts-track {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 800px) {
    .site-header {
      grid-template-columns: auto 1fr;
      --header-h: 64px;
      height: 64px;
      padding: 0 12px;
    }
    .logo {
      width: 44px;
    }
    .hdr-right {
      gap: 2px;
    }
    .hdr-nav a {
      padding: 0.55em 0.55em;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }
    .theme-switch {
      margin-left: 4px;
    }
    .resume-btn {
      margin-left: 2px;
    }
  }
  /* phones: everything still fits on one line; the résumé keeps its label, drops the icon */
  @media (max-width: 520px) {
    .hdr-nav a {
      padding: 14px 0.4em; /* a 40 px tall touch target, the same look */
      font-size: 0.6875rem;
      letter-spacing: 0;
    }
    .resume-btn {
      height: 26px;
      padding: 0 9px;
      font-size: 0.6875rem;
      letter-spacing: 0.02em;
    }
    .resume-ico {
      display: none;
    }
    .hdr-left {
      gap: 10px;
    }
    /* with Home in the bar, Contact (the foot of the page) gives up its room */
    .site-header[data-pinned] .hdr-nav li:last-child {
      display: none;
    }
  }
</style>
