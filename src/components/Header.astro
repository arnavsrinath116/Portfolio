---
import { withBase } from '../lib/url';
import { site } from '../data/site';
---


<header class="site-header" data-header data-reveal>
  <a class="logo" href={withBase('/')} aria-label={`${site.name}, home`} data-magnet>
    <span class="cube-stage" aria-hidden="true">
      <span class="cube">
        <span class="face front">A</span>
        <span class="face right">S</span>
        <span class="face back">A</span>
        <span class="face left">S</span>
        <span class="face top"></span>
        <span class="face bottom"></span>
      </span>
    </span>
  </a>


  <button
    class="menu-btn bracket"
    type="button"
    aria-expanded="false"
    aria-controls="site-menu"
    data-menu-toggle
    data-magnet
  >
    <span class="menu-label" data-menu-label>Menu</span>
    <span class="dots" aria-hidden="true"><i></i><i></i></span>
  </button>
</header>

<style>
  .site-header {
    position: fixed;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    z-index: 8600;
    height: var(--header-h);
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    padding: 0 var(--gutter);
    /* no bar: just the mark and the menu floating over the page */
    background: transparent;
    pointer-events: none;
    transition:
      transform 0.6s var(--ease-out),
      color var(--dur-base) var(--ease-out);
  }
  .site-header > * {
    pointer-events: auto;
  }
  .site-header:global(.is-hidden) {
    transform: translateY(calc(-100% - var(--frame) - 2px));
  }
  :global(html.menu-open) .site-header {
    color: var(--mercury-ink);
    transform: none;
  }

  /* ---- Isometric AS cube: true 3D, orthographic (no perspective) ---- */
  .logo {
    justify-self: start;
    display: inline-grid;
    place-items: center;
    width: 52px;
    height: 52px;
  }
  .cube-stage {
    --s: 22px;
    width: var(--s);
    height: var(--s);
    position: relative;
  }
  .cube {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(-35.264deg) rotateY(-45deg);
    transition: transform 1.1s var(--ease-inout);
  }
  @media (hover: hover) {
    .logo:hover .cube {
      transform: rotateX(-35.264deg) rotateY(-405deg);
    }
  }
  .logo:focus-visible .cube {
    transform: rotateX(-35.264deg) rotateY(-405deg);
  }
  .face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    font-family: var(--font-letter);
    font-stretch: 125%;
    font-weight: 700;
    font-size: 13px;
    line-height: 1;
    backface-visibility: hidden;
  }
  .front {
    transform: translateZ(calc(var(--s) / 2));
  }
  .back {
    transform: rotateY(180deg) translateZ(calc(var(--s) / 2));
  }
  .right {
    transform: rotateY(90deg) translateZ(calc(var(--s) / 2));
  }
  .left {
    transform: rotateY(-90deg) translateZ(calc(var(--s) / 2));
  }
  .top {
    transform: rotateX(90deg) translateZ(calc(var(--s) / 2));
    border-color: var(--orange);
  }
  .bottom {
    transform: rotateX(-90deg) translateZ(calc(var(--s) / 2));
  }
  /* hidden edges read through the open faces, as on a real isometric drawing */
  .top,
  .bottom {
    backface-visibility: visible;
  }
  :global(html.menu-open) .top {
    border-color: currentColor;
  }


  .menu-btn {
    justify-self: end;
    font-size: 0.875rem;
    font-weight: 560;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  /* orange fails on mercury; on the flood the hover stays ink, brackets carry it */
  :global(html.menu-open) .menu-btn,
  :global(html.menu-open) .menu-btn:hover,
  :global(html.menu-open) .menu-btn:focus-visible {
    color: var(--mercury-ink);
  }
  .dots {
    position: relative;
    width: 12px;
    height: 12px;
    display: inline-block;
    transition: transform var(--dur-slow) var(--ease-out);
  }
  .dots i {
    position: absolute;
    top: 50%;
    width: 3px;
    height: 3px;
    margin-top: -1.5px;
    background: currentColor;
  }
  .dots i:first-child {
    left: 2px;
  }
  .dots i:last-child {
    right: 2px;
  }
  .menu-btn[aria-expanded='true'] .dots {
    transform: rotate(90deg);
  }

  @media (max-width: 800px) {
    .site-header {
      grid-template-columns: 1fr 1fr;
      --header-h: 64px;
      height: 64px;
    }
  }
</style>
