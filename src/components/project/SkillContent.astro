---
import WireLogo from '../WireLogo.astro';
import ModelViewer from '../ModelViewer.astro';
import Gallery from '../Gallery.astro';
import Prototype from '../Prototype.astro';
import Film from '../Film.astro';
import CameraKit from './CameraKit.astro';
import type { Skill } from '../../data/skills';
import { skills } from '../../data/skills';
import { projects } from '../../data/projects';

interface Props {
  skill: Skill;
}
const { skill } = Astro.props;
const key = `skill-${skill.slug}`;
// tools as a phrase: "Fusion 360 and Blender"
const phrase = (list: string[]) => (list.length < 2 ? list.join('') : `${list.slice(0, -1).join(', ')} and ${list[list.length - 1]}`);
const others = skills.filter((s) => s.slug !== skill.slug);
const studies = projects.filter((p) => p.tools.some((t) => skill.tools.includes(t)));
// *word* in the summary is set in the accent colour
const summary = skill.summary.split(/\*([^*]+)\*/);
---

<!-- a skill as one drawing sheet: title + drawing, a title block, then the work on one stage -->
<article class="sk" data-project={key} aria-labelledby={`${key}-title`} hidden data-sk>
  <header class="sk-head" data-pc-rise data-wire-host>
    <div class="sk-intro">
      <h2 class="sk-title" id={`${key}-title`} data-words="open">{skill.name}</h2>
      <p class="sk-summary">{summary.map((part, i) => (i % 2 ? <span class="hl">{part}</span> : part))}</p>
    </div>
    <div class="sk-view" aria-hidden="true">
      <span class="x x-tl"></span><span class="x x-tr"></span><span class="x x-bl"></span><span class="x x-br"></span>
      <WireLogo paths={skill.logo} label="" />
    </div>
  </header>

  <!-- the facts, in one plain line -->
  <p class="sk-tb" data-pc-rise>
    {skill.tools.length > 0 && <span>Made with {phrase(skill.tools)}.</span>}
    {
      studies.length > 0 && (
        <span class="sk-used">
          Used in{' '}
          {studies.map((p, i) => (
            <Fragment>
              {i > 0 && (i === studies.length - 1 ? ' and ' : ', ')}
              <button type="button" class="sk-link" data-switch-project={p.slug} data-magnet>{p.title}</button>
            </Fragment>
          ))}.
        </span>
      )
    }
  </p>

  {skill.kit && <CameraKit kit={skill.kit} id={key} />}

  <!-- the work: one stage, and the list that picks what's on it -->
  <section class="sk-set" data-pc-rise aria-label={`${skill.name} work`} data-sk-set>
    <div class="sk-stages">
      {
        skill.works.map((w, i) => (
          <div class="sk-stage" data-stage={i} hidden={i !== 0}>
            {w.model ? (
              <ModelViewer model={w.model} title={w.title} />
            ) : w.video ? (
              <Film video={w.video} title={w.title} kind={w.kind} />
            ) : w.prototype ? (
              <Prototype prototype={w.prototype} title={w.title} kind={w.kind} />
            ) : w.images?.length ? (
              <Gallery images={w.images} title={w.title} kind={w.kind} />
            ) : (
              <div class="sk-draft" role="img" aria-label={`${w.kind}: not drawn yet`}>
                <span class="sk-draft-k">{w.kind}</span>
                <span class="sk-draft-s">In drafting</span>
              </div>
            )}
          </div>
        ))
      }
    </div>
    <div class="sk-list">
      <ol>
        {
          skill.works.map((w, i) => (
            <li>
              <button type="button" class:list={['sk-pick', { 'is-on': i === 0, 'is-pending': w.pending }]} aria-pressed={i === 0 ? 'true' : 'false'} data-pick={i}>
                <span class="sk-pick-t">{w.title}</span>
                <span class="sk-pick-k">{w.pending ? 'In drafting' : w.kind}</span>
              </button>
              {!w.pending && (
                <div class:list={['sk-about', { 'is-open': i === 0 }]} data-about={i}>
                  <div>
                    <p class:list={{ 'is-placeholder': !w.about }}>{w.about ?? 'About this project: write-up coming soon.'}</p>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <nav class="sk-next pc-others" aria-label="Other skills">
    {
      others.map((o) => (
        <button type="button" class="sk-next-a" data-switch-project={`skill-${o.slug}`} data-magnet>
          <span class="sk-next-n">{o.name}</span>
        </button>
      ))
    }
  </nav>
</article>

<script>
  // picking a work in the list puts it on the stage
  document.querySelectorAll<HTMLElement>('[data-sk-set]').forEach((set) => {
    const picks = Array.from(set.querySelectorAll<HTMLButtonElement>('[data-pick]'));
    const stages = Array.from(set.querySelectorAll<HTMLElement>('[data-stage]'));
    picks.forEach((b) =>
      b.addEventListener('click', () => {
        const i = b.dataset.pick;
        picks.forEach((p) => {
          const on = p === b;
          p.classList.toggle('is-on', on);
          p.setAttribute('aria-pressed', String(on));
        });
        stages.forEach((s) => (s.hidden = s.dataset.stage !== i));
        // the picked work's write-up drops open under it; the others fold away
        set.querySelectorAll<HTMLElement>('[data-about]').forEach((a) => a.classList.toggle('is-open', a.dataset.about === i));
      }),
    );
  });
</script>

<style>
  .sk {
    position: relative;
    padding: clamp(28px, 4vw, 64px) clamp(22px, 4vw, 64px) clamp(16px, 2vw, 28px); /* the scroll ends just under the other-sheet links */
  }
  /* the sheet's dimensions (skillDims.ts), drawn over it in px */
  .sk :global(.sk-dims) {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    overflow: visible;
    pointer-events: none;
  }
  .sk :global(.sk-dims .label-bg) {
    fill: var(--slate-3);
  }
  .sk[hidden] {
    display: none;
  }

  /* ---------- title + drawing ---------- */
  .sk-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px clamp(32px, 5vw, 80px);
    align-items: end;
  }
  .sk-title {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.2rem, 5.4vw, 4.75rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .sk-summary {
    margin-top: 18px;
    max-width: 38ch;
    font-size: clamp(1rem, 1.3vw, 1.1875rem);
    line-height: 1.45;
    color: var(--sand-2);
  }
  /* a patch of drafting grid with registration crosses, holding the turning wireframe */
  .sk-view {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(150px, 20vw, 240px);
    aspect-ratio: 1;
    margin-right: 52px; /* clear the close button's column */
    border: 1px solid var(--line-faint);
    background:
      linear-gradient(var(--line-faint) 1px, transparent 1px) -1px -1px / 20px 20px,
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px) -1px -1px / 20px 20px,
      rgb(var(--bg-rgb) / 0.35);
  }
  .sk-view :global(.wire) {
    width: 56%;
  }
  .x {
    position: absolute;
    width: 11px;
    height: 11px;
    background:
      linear-gradient(var(--sand-3), var(--sand-3)) 50% 0 / 1px 100% no-repeat,
      linear-gradient(var(--sand-3), var(--sand-3)) 0 50% / 100% 1px no-repeat;
  }
  .x-tl {
    top: -6px;
    left: -6px;
  }
  .x-tr {
    top: -6px;
    right: -6px;
  }
  .x-bl {
    bottom: -6px;
    left: -6px;
  }
  .x-br {
    bottom: -6px;
    right: -6px;
  }
  /* ---------- the facts, in a line ---------- */
  .sk-tb {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 0.3em;
    margin: clamp(28px, 5vh, 44px) 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--sand-2);
  }
  :global(.sk) :global(.sk-block-title) {
    font-size: 0.875rem;
    font-weight: 600;
    font-stretch: 100%;
    color: var(--sand-3);
  }
  .sk-link {
    padding: 0;
    border: 0;
    background: none;
    color: var(--sand);
    font: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: rgb(var(--ink-rgb) / 0.35);
    cursor: pointer;
    transition:
      color var(--dur-base) var(--ease-out),
      text-decoration-color var(--dur-base) var(--ease-out);
  }

  /* the camera kit (photography) sits under the title block as a labelled strip */
  .sk :global(.sk-block) {
    margin-top: clamp(28px, 5vh, 44px);
  }

  /* ---------- the work ---------- */
  .sk-set {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(220px, 4fr);
    gap: clamp(20px, 3vw, 40px);
    margin-top: clamp(36px, 6vh, 60px);
    align-items: start;
  }
  .sk-stage[hidden] {
    display: none;
  }
  /* dashed: not drawn yet */
  .sk-draft {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    aspect-ratio: 16 / 9;
    border: 1px dashed rgb(var(--ink-rgb) / 0.22);
    background:
      linear-gradient(var(--line-faint) 1px, transparent 1px) -1px -1px / 24px 24px,
      linear-gradient(90deg, var(--line-faint) 1px, transparent 1px) -1px -1px / 24px 24px;
  }
  .sk-draft-k {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  .sk-draft-s {
    font-size: 0.875rem;
    color: var(--sand-3);
  }

  .sk-list ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sk-list li {
    border-bottom: 1px solid var(--line-faint);
  }
  .sk-pick {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
    width: 100%;
    padding: 13px 0;
    border: 0;
    background: none;
    color: var(--sand-2);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: color var(--dur-base) var(--ease-out);
  }
  .sk-pick-t {
    font-size: 0.9375rem;
    font-weight: 500;
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sk-pick-k {
    font-size: 0.8125rem;
    color: var(--sand-3);
  }
  .sk-pick.is-pending .sk-pick-t {
    color: var(--sand-3);
  }
  .sk-pick.is-on {
    color: var(--sand);
  }
  .sk-pick.is-on .sk-pick-t {
    transform: translateX(4px);
  }
  /* the write-up under a picked work: folds open by animating its row from 0fr to 1fr */
  .sk-about {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sk-about > div {
    min-height: 0;
    overflow: hidden;
  }
  .sk-about.is-open {
    grid-template-rows: 1fr;
  }
  .sk-about p {
    margin: 0 0 14px 46px;
    padding: 12px 14px;
    border-left: 2px solid var(--accent);
    background: rgb(var(--ink-rgb) / 0.03);
    color: var(--sand-2);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .sk-about p.is-placeholder {
    color: var(--sand-3);
    font-style: italic;
  }
  @media (prefers-reduced-motion: reduce) {
    .sk-about {
      transition: none;
    }
  }
  .sk-pick:focus-visible {
    outline-offset: 2px;
  }

  /* ---------- next sheets ---------- */
  /* the other sheets, on one line across the sheet's width */
  .sk-next {
    display: flex;
    justify-content: space-between;
    gap: 10px clamp(10px, 1.4vw, 32px);
    margin-top: clamp(24px, 4vh, 40px);
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .sk-next-a {
    display: inline-flex;
    align-items: baseline;
    gap: clamp(6px, 0.7vw, 10px);
    white-space: nowrap;
    padding: 6px 0;
    border: 0;
    background: none;
    color: var(--sand);
    font: inherit;
    cursor: pointer;
  }
  .sk-next-n {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(0.6875rem, 0.95vw, 1rem); /* small enough that five fit on one line */
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  @media (hover: hover) {
    .sk-pick:hover {
      color: var(--sand);
    }
    .sk-link:hover,
    .sk-next-a:hover {
      color: var(--accent);
      text-decoration-color: currentColor;
    }
  }

  /* narrower than five fit: they wrap again, left-aligned */
  @media (max-width: 1240px) {
    .sk-next {
      flex-wrap: wrap;
      justify-content: flex-start;
      column-gap: 24px;
    }
    .sk-next-n {
      font-size: 0.875rem;
    }
  }
  @media (max-width: 900px) {
    .sk-set {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 600px) {
    .sk-head {
      grid-template-columns: minmax(0, 1fr);
    }
    .sk-title {
      font-size: clamp(1.6rem, 7.6vw, 2.6rem); /* "PHOTOGRAPHY" is the longest */
    }
    .sk-view {
      order: -1;
      width: 112px;
      margin: 0 0 4px;
    }
  }
  /* phones: the sheet's small labels read a notch larger, and its links are proper touch targets */
  @media (max-width: 600px) {
    .sk-pick-k {
      font-size: 0.8125rem;
    }
    .sk-link {
      padding: 8px 0;
    }
  }
</style>
