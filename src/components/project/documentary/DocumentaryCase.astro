---
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);

// a group research project, told through the part that was mine: the documentary. The card is a
// screening room: the chapters are reels, the facts sit on a slate, and it ends on the credits.
// PLACEHOLDER: every dashed slot and "to come" line waits for the real material.
const reels = [
  { key: 'research', title: 'The research', note: 'What the group set out to find' },
  { key: 'why', title: 'Why a film', note: 'What the documentary had to do' },
  { key: 'writing', title: 'Writing', note: 'Structure, script, interviews' },
  { key: 'shooting', title: 'Shooting', note: 'Locations, frames, light' },
  { key: 'film', title: 'The film', note: 'Watch it' },
  { key: 'credits', title: 'Credits', note: 'Thirteen people' },
];

const slate = [
  ['Project', 'Research project'],
  ['My role', 'Writer · Camera'],
  ['Team', '13 people'],
  ['Duration', project.duration],
].filter(([, v]) => v && !/TBD/i.test(v));

// the team, in credit order; mine is filled in, the other twelve wait for their names
const crew = [
  { name: 'Arnav Srinath', role: 'Documentary: written and shot by', me: true },
  ...Array.from({ length: 12 }, () => ({ name: 'Name to come', role: 'Research', me: false })),
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="dc" data-project={project.slug} data-theme="film" data-card-bg="#0e0d0c" aria-labelledby="dc-title" hidden>
  <!-- ============ the opening frame ============ -->
  <header class="dc-hero">
    <!-- the opening title card, in the camera's viewfinder -->
    <div class="dc-frame">
      <span class="dc-viewfinder" aria-hidden="true">
        <span class="dc-mark dc-tl"></span><span class="dc-mark dc-tr"></span>
        <span class="dc-mark dc-bl"></span><span class="dc-mark dc-br"></span>
        <span class="dc-rec"><i></i>Rec</span>
        <span class="dc-tc">00:00:00:00</span>
        <span class="dc-frame-slot">Opening still to come</span>
      </span>
      <div class="dc-titlecard">
        <p class="dc-kicker">{project.discipline} · A documentary</p>
        <h2 class="dc-title" id="dc-title">{project.title}</h2>
      </div>
    </div>

    <div class="dc-hero-copy">
      <p class="dc-lede">{project.summary}</p>
      <dl class="dc-slate">
        {
          slate.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <!-- the reels: a strip of film, one frame per chapter -->
  <nav class="dc-rail" aria-label="Chapters">
    <ol>
      {
        reels.map((r, i) => (
          <li>
            <a href={`#dc-${r.key}`} data-phase-link={r.key}>
              <span class="dc-rail-no">R{pad(i + 1)}</span>
              {r.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    reels.map((r, i) => (
      <section class:list={['dc-reel', `dc-${r.key}`]} id={`dc-${r.key}`} data-phase={r.key} aria-labelledby={`dc-${r.key}-t`}>
        <header class="dc-rhead">
          <p class="dc-rno">Reel {pad(i + 1)}</p>
          <h3 class="dc-h" id={`dc-${r.key}-t`}>
            {r.title}
          </h3>
          <p class="dc-rnote">{r.note}</p>
        </header>

        {r.key === 'research' && (
          <div class="dc-split">
            <p class="dc-copy dc-todo">The question the group researched, how the thirteen of you split the work, and what you found.</p>
            <div class="dc-slot dc-wide">Research material to come</div>
          </div>
        )}

        {r.key === 'why' && (
          <div class="dc-split">
            <p class="dc-copy dc-todo">Why the findings needed a film, who it was made for, and what it had to make people feel or understand.</p>
            <blockquote class="dc-quote dc-todo">A line from the film, or the brief, to come.</blockquote>
          </div>
        )}

        {r.key === 'writing' && (
          <div class="dc-split">
            <p class="dc-copy dc-todo">How you shaped the story: the structure, the script, and the interview questions.</p>
            <div class="dc-pages">
              <div class="dc-slot dc-page">Script page</div>
              <div class="dc-slot dc-page">Script page</div>
            </div>
          </div>
        )}

        {r.key === 'shooting' && (
          <>
            <p class="dc-copy dc-todo">Where and how you shot it: the kit, the locations, and the choices behind the frames.</p>
            <div class="dc-stills">
              {Array.from({ length: 4 }, (_, k) => (
                <figure class="dc-still">
                  <div class="dc-slot">Still {pad(k + 1)}</div>
                  <figcaption>Frame {pad(k + 1)} · caption to come</figcaption>
                </figure>
              ))}
            </div>
          </>
        )}

        {r.key === 'film' && (
          <div class="dc-screen">
            <div class="dc-slot dc-player">The documentary to come</div>
            <p class="dc-screen-bar">
              <span>Running time to come</span>
              <span>Written and shot by Arnav Srinath</span>
            </p>
          </div>
        )}

        {r.key === 'credits' && (
          <ol class="dc-crew">
            {crew.map((c) => (
              <li class:list={{ 'is-me': c.me, 'dc-todo': !c.me }}>
                <span>{c.role}</span>
                <b>{c.name}</b>
              </li>
            ))}
          </ol>
        )}
      </section>
    ))
  }

  <nav class="dc-others pc-others" aria-label="Other case studies">
    <p class="dc-rno">Next project</p>
    <div class="dc-others-grid">
      {
        others.map((o) => (
          <button type="button" class="dc-other" data-switch-project={o.slug} data-magnet>
            <span>{o.discipline}</span>
            <b>{o.title}</b>
          </button>
        ))
      }
    </div>
  </nav>
</article>

<style>
  .dc {
    --dc-bg: #0e0d0c;
    --dc-panel: #161513;
    --dc-line: rgb(236 226 206 / 0.12);
    --dc-ink: #ece2ce;
    --dc-ink-2: #b4ab99;
    --dc-ink-3: #827a6c;
    --dc-tungsten: #f2b35b; /* its own warm light, independent of the site accent */
    --dc-rec: #ff4b3e;
    --dc-pad: clamp(24px, 6vw, 96px);
    position: relative;
    color: var(--dc-ink);
    background: var(--dc-bg);
    overflow-x: clip;
  }

  /* ---------- the opening frame ---------- */
  .dc-hero {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding: clamp(56px, 9vh, 96px) var(--dc-pad) clamp(40px, 7vh, 72px);
  }
  .dc-frame {
    position: relative;
    aspect-ratio: 2.39;
    border-radius: 4px;
    background:
      radial-gradient(120% 90% at 50% 40%, rgb(242 179 91 / 0.08), transparent 60%),
      var(--dc-panel);
    box-shadow: 0 0 0 1px var(--dc-line);
  }
  .dc-mark {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid var(--dc-ink-2);
  }
  .dc-tl { top: 14px; left: 14px; border-width: 1.5px 0 0 1.5px; }
  .dc-tr { top: 14px; right: 14px; border-width: 1.5px 1.5px 0 0; }
  .dc-bl { bottom: 14px; left: 14px; border-width: 0 0 1.5px 1.5px; }
  .dc-br { bottom: 14px; right: 14px; border-width: 0 1.5px 1.5px 0; }
  .dc-rec,
  .dc-tc {
    position: absolute;
    top: 20px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dc-ink-2);
  }
  .dc-rec {
    left: 48px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dc-rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dc-rec);
    animation: dc-blink 1.2s steps(1) infinite;
  }
  .dc-tc {
    right: 48px;
  }
  .dc-frame-slot {
    position: absolute;
    inset: 0 0 45%;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  @keyframes dc-blink {
    50% {
      opacity: 0;
    }
  }

  .dc-titlecard {
    position: absolute;
    left: clamp(22px, 4vw, 48px);
    right: clamp(22px, 4vw, 48px);
    bottom: clamp(26px, 4.5vw, 52px);
  }
  .dc-hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 12px clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .dc-kicker {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-tungsten);
  }
  .dc-title {
    font-size: clamp(1.5rem, 5.6vw, 4.75rem);
    font-stretch: 125%;
    font-weight: 640;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .dc-lede {
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--dc-ink-2);
  }
  /* the slate: the clapperboard's facts, ruled in chalk */
  .dc-slate {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--dc-line);
    border-radius: 4px;
  }
  .dc-slate div {
    padding: 14px 16px;
    border-bottom: 1px solid var(--dc-line);
  }
  .dc-slate div:nth-child(odd) {
    border-right: 1px solid var(--dc-line);
  }
  .dc-slate div:nth-last-child(-n + 2):nth-child(odd),
  .dc-slate div:last-child {
    border-bottom: 0;
  }
  /* an odd fact out takes the whole last row */
  .dc-slate div:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    border-right: 0;
  }
  .dc-slate dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  .dc-slate dd {
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* ---------- the reels ---------- */
  .dc-rail {
    position: sticky;
    top: 0;
    z-index: 3;
    padding: 0 var(--dc-pad);
    background: rgb(14 13 12 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block: 1px solid var(--dc-line);
  }
  /* sprocket holes along both edges of the strip */
  .dc-rail::before,
  .dc-rail::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 5px;
    background: radial-gradient(circle, rgb(236 226 206 / 0.14) 1.6px, transparent 2px) 0 50% / 16px 5px repeat-x;
    pointer-events: none;
  }
  .dc-rail::before {
    top: 3px;
  }
  .dc-rail::after {
    bottom: 3px;
  }
  .dc-rail ol {
    display: flex;
    gap: 4px;
    margin: 0;
    padding: 14px 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dc-rail a {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 3px;
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--dc-ink-3);
    text-decoration: none;
    transition:
      color 0.2s ease-out,
      background-color 0.2s ease-out;
  }
  .dc-rail-no {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.06em;
  }
  .dc-rail a:global(.is-active) {
    color: var(--dc-bg);
    background: var(--dc-tungsten);
  }
  @media (hover: hover) {
    .dc-rail a:hover:not(:global(.is-active)) {
      color: var(--dc-ink);
    }
  }

  .dc-reel {
    padding: clamp(64px, 11vh, 120px) var(--dc-pad) 0;
    scroll-margin-top: 64px;
  }
  .dc-rhead {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 4px 20px;
    align-items: baseline;
    margin-bottom: clamp(24px, 4vh, 40px);
    padding-bottom: 18px;
    border-bottom: 1px solid var(--dc-line);
  }
  .dc-rno {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-tungsten);
  }
  .dc-h {
    font-size: clamp(1.75rem, 3.6vw, 3rem);
    font-stretch: 125%;
    font-weight: 640;
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .dc-rnote {
    grid-column: 2;
    font-size: 0.9375rem;
    color: var(--dc-ink-3);
  }

  .dc-split {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .dc-copy {
    max-width: 58ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--dc-ink-2);
  }
  /* copy still to be written: set in mono so a placeholder never passes for the real thing */
  .dc-todo {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--dc-ink-3);
  }
  .dc-quote {
    margin: 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--dc-tungsten);
    line-height: 1.5;
  }

  /* dashed = not shot yet: where the material will sit */
  .dc-slot {
    display: grid;
    place-items: center;
    min-height: 160px;
    padding: 16px;
    border: 1px dashed rgb(236 226 206 / 0.22);
    border-radius: 4px;
    background: rgb(236 226 206 / 0.02);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  .dc-wide {
    aspect-ratio: 16 / 10;
  }
  .dc-pages {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }
  .dc-page {
    aspect-ratio: 1 / 1.414;
  }
  .dc-stills {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 24px);
    margin-top: clamp(24px, 4vh, 40px);
  }
  .dc-still {
    margin: 0;
  }
  .dc-still .dc-slot {
    aspect-ratio: 16 / 9;
  }
  .dc-still figcaption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--dc-ink-3);
  }

  /* the screen: the film, letterboxed in the dark */
  .dc-screen {
    padding: clamp(16px, 3vw, 40px);
    border-radius: 6px;
    background: #050505;
    box-shadow: 0 40px 90px -40px rgb(242 179 91 / 0.25);
  }
  .dc-player {
    aspect-ratio: 16 / 9;
  }
  .dc-screen-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 14px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }

  /* the credits: centred, as at the end of a film */
  .dc-crew {
    display: grid;
    gap: 18px;
    max-width: 560px;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    text-align: center;
  }
  .dc-crew li {
    display: grid;
    gap: 4px;
  }
  .dc-crew span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  .dc-crew b {
    font-size: 1.125rem;
    font-weight: 600;
  }
  .dc-crew li.is-me {
    margin-bottom: 18px;
  }
  .dc-crew li.is-me span {
    color: var(--dc-tungsten);
  }
  .dc-crew li.is-me b {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-stretch: 125%;
    font-weight: 640;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .dc-crew li.dc-todo b {
    font-weight: 400;
    color: var(--dc-ink-3);
  }

  .dc-others {
    margin: clamp(80px, 14vh, 140px) var(--dc-pad) 0;
    padding: 32px 0 clamp(100px, 14vh, 140px);
    border-top: 1px solid var(--dc-line);
  }
  .dc-others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }
  .dc-other {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--dc-line);
    border-radius: 4px;
    background: var(--dc-panel);
    color: var(--dc-ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease-out;
  }
  .dc-other span {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  .dc-other b {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  @media (hover: hover) {
    .dc-other:hover {
      border-color: var(--dc-tungsten);
    }
  }

  @media (max-width: 820px) {
    .dc-hero-copy,
    .dc-split {
      grid-template-columns: minmax(0, 1fr);
    }
    .dc-frame {
      aspect-ratio: 4 / 3.4;
    }
    .dc-rec {
      left: 40px;
    }
    .dc-tc {
      right: 40px;
    }
  }
  @media (max-width: 560px) {
    .dc-stills {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dc-rec i {
      animation: none;
    }
  }
</style>
