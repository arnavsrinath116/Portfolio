<script>
  // the film loads only when asked for: the Drive player takes the viewfinder's place, and is
  // removed again when the card closes or switches, so nothing keeps playing in the background
  const card = document.querySelector<HTMLElement>('[data-dc]');
  const frame = card?.querySelector<HTMLElement>('[data-dc-frame]');
  const play = card?.querySelector<HTMLButtonElement>('[data-dc-play]');
  if (card && frame && play) {
    play.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.className = 'dc-player';
      f.src = play.dataset.filmSrc!;
      f.title = 'The Man the God Wore, the documentary';
      f.allow = 'autoplay; fullscreen';
      f.allowFullscreen = true;
      frame.append(f);
      frame.classList.add('is-playing');
      f.focus();
    });
    const stop = () => {
      frame.querySelector('iframe')?.remove();
      frame.classList.remove('is-playing');
    };
    document.addEventListener('pm:hidden', stop);
    document.addEventListener('pm:shown', (e) => {
      if ((e as CustomEvent).detail?.slug !== card.dataset.project) stop();
    });
  }

  // the report reader: a dialog over the card with the browser's PDF viewer inside. Phones can't
  // show a PDF in a frame, so there the button opens it in the browser's own viewer instead.
  const reader = card?.querySelector<HTMLDialogElement>('[data-dc-reader]');
  const doc = reader?.querySelector<HTMLIFrameElement>('iframe');
  if (card && reader && doc) {
    const inFrame = () => !matchMedia('(pointer: coarse) and (max-width: 900px)').matches;
    card.querySelectorAll('[data-dc-read]').forEach((b) =>
      b.addEventListener('click', () => {
        if (!inFrame()) return void window.open(doc.dataset.src, '_blank', 'noopener');
        if (!doc.src) doc.src = doc.dataset.src!;
        reader.showModal();
      }),
    );
    reader.querySelector('[data-dc-reader-close]')?.addEventListener('click', () => reader.close());
    // clicking the dimmed edge closes it
    reader.addEventListener('click', (e) => {
      if (e.target === reader) reader.close();
    });
    // the card traps Tab and closes on Escape; inside the reader, the dialog handles both itself
    reader.addEventListener('keydown', (e) => e.stopPropagation());
    document.addEventListener('pm:hidden', () => reader.open && reader.close());
  }
</script>

