---
import { withBase } from '../../../lib/url';
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const img = (n: string) => withBase(`/projects/theyyam/${n}.webp`);

// The Man the God Wore: a thirteen-person DIP field study of Theyyam in Kannur, told through the
// part that was mine, the documentary. The card is a screening room: the film plays first, in the
// camera's viewfinder; then the reels run the ritual, the question, the fieldwork, the filmmaking,
// what we found, and the credits. Everything here comes from the report and the two presentations.
// PLACEHOLDER: lines set in mono (.dc-todo) wait for Arnav's own account of writing and shooting.
const FILM = 'https://drive.google.com/file/d/18LXtGkTumYXwmwiRuVJ8TjdpPyq_WjGt/preview';

const reels = [
  { key: 'ritual', title: 'The ritual', note: 'Where a man becomes a god' },
  { key: 'question', title: 'The question', note: 'What we went to Kannur to find' },
  { key: 'field', title: 'In the field', note: 'Nine days, ten groves, thirty-five voices' },
  { key: 'making', title: 'Making the film', note: 'Writing it, shooting it' },
  { key: 'found', title: 'What we found', note: 'Belief, still burning' },
  { key: 'credits', title: 'Credits', note: 'Thirteen of us' },
];

const slate = [
  ['Programme', 'Discover India · FLAME University'],
  ['Fieldwork', 'Kannur, Kerala · 20–28 Feb 2026'],
  ['My role', 'Documentary co-lead · writer & camera'],
  ['Team', '13 students · mentor Prof. Priya Joshi'],
];

// the full ritual arc, as all thirteen of us watched it
const arc = [
  { t: 'The Thottam', d: 'Before the costume, the performer sings the deity’s story. Its origin, in its own words.', src: 'ch1-performer', alt: 'A performer in black and white, head thrown back, body marked with white paint' },
  { t: 'The face', d: 'Mugathezhuthu: four to six hours of natural pigment. Each deity has its own face.', src: 'face-paints', alt: 'A grid of twenty-five painted Theyyam faces, each pattern different' },
  { t: 'The mirror', d: 'Mukhadarshanam. He looks into a mirror and no longer finds himself there.', src: 'mirror', alt: 'A performer in face paint looking into a hand mirror' },
  { t: 'The crown', d: 'The mudi goes on, and with it the deity is believed to enter the body.', src: 'red-costume', alt: 'A Theyyam performer in full red costume, headdress and breastplate' },
  { t: 'Urayal', d: 'The drums rise, the voice changes, the eyes go somewhere else. The god arrives.', src: 'ch3-fire-crown', alt: 'A performer with a towering headdress of flaming torches before a crowd' },
  { t: 'The oracle', d: 'Now the deity: devotees, upper castes among them, bow and bring their troubles.', src: 'ch6-goddess', alt: 'Close-up of a goddess Theyyam: red painted face, silver eyes, red headdress' },
];

const sounds = [
  ['The crowd', 'before, during and after the transformation'],
  ['Chilambu', 'the ankle bells: the performer’s steps against the deity’s'],
  ['Chenda', 'the drums, as tempo and volume climb toward Urayal'],
  ['Thottam', 'the sung origin story'],
  ['The voice', 'the shift in the performer’s voice as the god takes it'],
];

const diagrams = [
  { src: 'dia-kantakarnan', t: 'Kantakarnan' },
  { src: 'dia-bhagavathy', t: 'Panayakkatu Bhagavathy' },
  { src: 'dia-pottan', t: 'Pottan' },
];

const findings = [
  { big: 'Transformation is lived, not a metaphor.', d: 'Performers describe the self leaving the body so the god can take it. The congregation treats it that way too.' },
  { big: 'A living archive for communities never permitted to write.', d: 'The Thottam carries history and migration through song, passed down inside performing families.' },
  { big: 'It turns caste upside down, then sets it back.', d: 'For the length of the ritual, upper castes bow to a performer from a marginalised community. After it, the order returns.' },
  { big: 'Tourism and phones threaten it, and keep it visible.', d: 'Staged shows strip the ritual of its sacred logic; the same cameras give it new ways to survive.' },
];

// the team, as credited in the report; the documentary team first
const crew = [
  { name: 'Simran Vyas', role: 'Documentary lead' },
  { name: 'Arnav Srinath', role: 'Documentary co-lead · writer & camera', me: true },
  { name: 'Bhanu Tarun Krishna Veeramachaneni', role: 'Documentary · writing' },
  { name: 'Soumya Gupta', role: 'Group representative' },
  { name: 'Aliya Premji', role: 'Co-group representative' },
  { name: 'Srishti Sudharsan', role: 'Writing lead' },
  { name: 'Radha Kulkarni', role: 'Writing co-lead · logistics' },
  { name: 'Richa Sajai', role: 'Writing' },
  { name: 'Divyanshi Nigam', role: 'Writing' },
  { name: 'Nitiksha Thukrul', role: 'Writing' },
  { name: 'Muktak Joshi', role: 'Logistics lead' },
  { name: 'Vikhyat Upadhyay', role: 'Finance lead' },
  { name: 'Suhani Aggarwal', role: 'Finance co-lead · logistics' },
];
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="dc" data-project={project.slug} data-theme="film" data-card-bg="#0e0d0c" aria-labelledby="dc-title" hidden data-dc>
  <!-- ============ the film first, in the camera's viewfinder ============ -->
  <header class="dc-hero">
    <div class="dc-frame" data-dc-frame>
      <img class="dc-poster" src={img('poster')} alt="" width="1333" height="558" loading="lazy" decoding="async" />
      <span class="dc-viewfinder" aria-hidden="true">
        <span class="dc-mark dc-tl"></span><span class="dc-mark dc-tr"></span>
        <span class="dc-mark dc-bl"></span><span class="dc-mark dc-br"></span>
        <span class="dc-rec"><i></i>Rec</span>
        <span class="dc-tc">Kannur · Feb 2026</span>
      </span>
      <div class="dc-titlecard">
        <p class="dc-kicker">{project.discipline} · A documentary</p>
        <h2 class="dc-title" id="dc-title">{project.title}</h2>
      </div>
      <button type="button" class="dc-play" data-dc-play data-film-src={FILM} data-magnet>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
        Watch the film
      </button>
    </div>

    <div class="dc-hero-copy">
      <p class="dc-lede">
        In North Kerala, a man puts on paint, a crown and a costume, and the village believes he becomes a god. Thirteen of us spent
        nine days in Kannur studying that transformation. I co-led the documentary: <em>I wrote it and shot it.</em>
      </p>
      <dl class="dc-slate">
        {
          slate.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </header>

  <!-- the reels: a strip of film, one frame per chapter -->
  <nav class="dc-rail" aria-label="Chapters">
    <ol>
      {
        reels.map((r, i) => (
          <li>
            <a href={`#dc-${r.key}`} data-phase-link={r.key}>
              <span class="dc-rail-no">R{pad(i + 1)}</span>
              {r.title}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  {
    reels.map((r, i) => (
      <section class:list={['dc-reel', `dc-${r.key}`]} id={`dc-${r.key}`} data-phase={r.key} aria-labelledby={`dc-${r.key}-t`}>
        <header class="dc-rhead">
          <p class="dc-rno">Reel {pad(i + 1)}</p>
          <h3 class="dc-h" id={`dc-${r.key}-t`}>
            {r.title}
          </h3>
          <p class="dc-rnote">{r.note}</p>
        </header>

        {r.key === 'ritual' && (
          <>
            <div class="dc-split">
              <div class="dc-copy">
                <p>
                  <b>Theyyam</b> is a ritual of the Kavus, the sacred groves of North Malabar, older than Brahmanical Hinduism and rooted
                  in fear of the forces of nature. Its scholars call it the <em>Theatre of the Earth</em>: costumes of coconut leaf, colours
                  from the soil.
                </p>
                <p>
                  The performer does not represent the deity. For the length of the ritual, he is it. He comes from a community long
                  pushed to the margins, and yet the upper castes bow to him.
                </p>
              </div>
              <figure class="dc-fig">
                <img src={img('ch4-red-face')} alt="A Theyyam performer in red face paint and headdress, seen through flowers" width="992" height="1200" loading="lazy" decoding="async" />
              </figure>
            </div>
            <div class="dc-split dc-split-flip">
              <figure class="dc-fig">
                <img src={img('ch2-phone')} alt="A phone held up in the dark, filming a Theyyam performance" width="992" height="1200" loading="lazy" decoding="async" />
              </figure>
              <div class="dc-copy">
                <p class="dc-pull">And it is changing.</p>
                <p>
                  Tourism reframed it as folk art and moved it onto stages. Phones carry it everywhere, cut loose from the grove. And
                  the Tharavaads, the ancestral family houses that keep the tradition alive, are quietly coming apart.
                </p>
              </div>
            </div>
          </>
        )}

        {r.key === 'question' && (
          <>
            <div class="dc-split">
              <div class="dc-copy">
                <p>
                  We went looking for one moment: <b>Urayal</b>, when the performer stops being a man and the deity arrives. Before the
                  field, our question was how the ritual’s choreography (sound, rhythm, movement and text) makes that crossing happen.
                </p>
                <p>The research we read kept leaving the same things out.</p>
              </div>
              <blockquote class="dc-quote">
                How does transformation in Theyyam bring together origin, embodiment, time and modernity in a single ritual?
                <cite>The question we ended on</cite>
              </blockquote>
            </div>
            <ol class="dc-gaps">
              <li><b>The performer’s own voice.</b> Theyyam is written about from the outside; what he goes through is almost never asked.</li>
              <li><b>The Thottam.</b> The sung origin stories are cited everywhere and translated almost nowhere.</li>
              <li><b>The families.</b> What tourism and commodification do to the people who carry it is barely examined.</li>
            </ol>
            <p class="dc-shift">
              <span>Before the field</span>
              <s>Kasaragodi Nritya, Theyyam evvam Kavyagaram: a study of folk art and tradition</s>
              <span>After it</span>
              <b>The Man the God Wore</b>
            </p>
            <p class="dc-note">On the ground, access to performers in the middle of the ritual was limited, so the study widened from one moment to the whole system around it.</p>
          </>
        )}

        {r.key === 'field' && (
          <>
            <ul class="dc-counts">
              <li><b>9</b>days in Kannur</li>
              <li><b>10+</b>Kavus visited</li>
              <li><b>35</b>interviews</li>
              <li><b>13</b>of us, every one at a full ritual</li>
            </ul>
            <p class="dc-copy dc-lead">
              Performers, drummers, Kavu owners, folk-studies professors, writers and families, in Malayalam and English. Alongside them,
              all of us watched the full arc of a live Theyyam, with a checklist we built to serve both the report and the film.
            </p>
            <ol class="dc-arc">
              {arc.map((s, k) => (
                <li>
                  <figure class="dc-arc-fig">
                    <img src={img(s.src)} alt={s.alt} loading="lazy" decoding="async" />
                  </figure>
                  <p class="dc-arc-no">{pad(k + 1)}</p>
                  <h4>{s.t}</h4>
                  <p>{s.d}</p>
                </li>
              ))}
            </ol>
            <div class="dc-split dc-sounds">
              <div>
                <p class="dc-label">Five sounds we recorded</p>
                <ol class="dc-sound-list">
                  {sounds.map(([k, v]) => (
                    <li>
                      <b>{k}</b>
                      {v}
                    </li>
                  ))}
                </ol>
              </div>
              <figure class="dc-fig">
                <img src={img('chenda')} alt="A chenda drum on a wooden stand in a temple courtyard, in black and white" width="675" height="1200" loading="lazy" decoding="async" />
                <figcaption>The chenda: its tempo marks the onset of Urayal.</figcaption>
              </figure>
            </div>
            <div class="dc-dias">
              <p class="dc-label">The shrine that walks: three costumes, drawn for the report</p>
              <ul>
                {diagrams.map((x) => (
                  <li>
                    <img src={img(x.src)} alt={`Hand-illustrated diagram of the ${x.t} Theyyam costume, each part labelled`} width="824" height="1100" loading="lazy" decoding="async" />
                    <span>{x.t}</span>
                  </li>
                ))}
              </ul>
            </div>
          </>
        )}

        {r.key === 'making' && (
          <>
            <div class="dc-split">
              <div class="dc-copy">
                <p>
                  The report could describe Urayal. The film had to let people hear the drums climb and see the face in the mirror.
                </p>
                <p class="dc-todo">To come from Arnav: how the film was structured and written, what you shot it on, and one decision on the ground that shaped it.</p>
              </div>
              <figure class="dc-fig">
                <img src={img('fire-performer')} alt="A Theyyam performer surrounded by burning embers at night" width="676" height="1200" loading="lazy" decoding="async" />
              </figure>
            </div>
            <div class="dc-stills">
              {[
                ['ch5-lamp', 'Oil lamps inside a shrine'],
                ['ch7-grove', 'A performer in a grass skirt before a temple'],
                ['poster', 'A figure silhouetted against a ritual fire'],
              ].map(([src, alt]) => (
                <figure class="dc-still">
                  <img src={img(src)} alt={alt} loading="lazy" decoding="async" />
                </figure>
              ))}
            </div>
          </>
        )}

        {r.key === 'found' && (
          <>
            <ol class="dc-finds">
              {findings.map((f) => (
                <li>
                  <b>{f.big}</b>
                  <p>{f.d}</p>
                </li>
              ))}
            </ol>
            <p class="dc-pull dc-coda">
              The deeper threat is quieter: when the Tharavaad falls apart, the networks that sustain the performing families go with it.
            </p>
            <ul class="dc-outputs">
              <li><b>A documentary</b>written and shot in Kannur</li>
              <li><b>A 100-page report</b>for FLAME’s Discover India Program</li>
              <li><b>A final presentation</b>to the university</li>
            </ul>
          </>
        )}

        {r.key === 'credits' && (
          <>
            <ol class="dc-crew">
              {crew.map((c) => (
                <li class:list={{ 'is-me': c.me }}>
                  <span>{c.role}</span>
                  <b>{c.name}</b>
                </li>
              ))}
            </ol>
            <p class="dc-thanks">Research &amp; field mentor: Prof. Priya Joshi. With thanks to Dr. Rajesh Komath, and to every family in Kannur who fed us before they answered our questions.</p>
          </>
        )}
      </section>
    ))
  }

  <nav class="dc-others pc-others" aria-label="Other case studies">
    <p class="dc-rno">Next project</p>
    <div class="dc-others-grid">
      {
        others.map((o) => (
          <button type="button" class="dc-other" data-switch-project={o.slug} data-magnet>
            <span>{o.discipline}</span>
            <b>{o.title}</b>
          </button>
        ))
      }
    </div>
  </nav>
</article>

<script>
  // the film loads only when asked for: the Drive player takes the viewfinder's place, and is
  // removed again when the card closes or switches, so nothing keeps playing in the background
  const card = document.querySelector<HTMLElement>('[data-dc]');
  const frame = card?.querySelector<HTMLElement>('[data-dc-frame]');
  const play = card?.querySelector<HTMLButtonElement>('[data-dc-play]');
  if (card && frame && play) {
    play.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.className = 'dc-player';
      f.src = play.dataset.filmSrc!;
      f.title = 'The Man the God Wore, the documentary';
      f.allow = 'autoplay; fullscreen';
      f.allowFullscreen = true;
      frame.append(f);
      frame.classList.add('is-playing');
      f.focus();
    });
    const stop = () => {
      frame.querySelector('iframe')?.remove();
      frame.classList.remove('is-playing');
    };
    document.addEventListener('pm:hidden', stop);
    document.addEventListener('pm:shown', (e) => {
      if ((e as CustomEvent).detail?.slug !== card.dataset.project) stop();
    });
  }
</script>

<style>
  .dc {
    --dc-bg: #0e0d0c;
    --dc-panel: #161513;
    --dc-line: rgb(236 226 206 / 0.12);
    --dc-ink: #ece2ce;
    --dc-ink-2: #b4ab99;
    --dc-ink-3: #8a8274;
    --dc-tungsten: #f2b35b; /* its own warm light, independent of the site accent */
    --dc-rec: #ff4b3e;
    --dc-pad: clamp(24px, 6vw, 96px);
    position: relative;
    color: var(--dc-ink);
    background: var(--dc-bg);
    overflow-x: clip;
  }
  .dc em {
    font-style: normal;
    color: var(--dc-tungsten);
  }
  .dc img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- the film, in the viewfinder ---------- */
  .dc-hero {
    display: grid;
    gap: clamp(28px, 4vw, 48px);
    padding: clamp(56px, 9vh, 96px) var(--dc-pad) clamp(40px, 7vh, 72px);
  }
  .dc-frame {
    position: relative;
    aspect-ratio: 2.39;
    overflow: hidden;
    border-radius: 4px;
    background: #050505;
    box-shadow: 0 0 0 1px var(--dc-line);
    transition: aspect-ratio 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .dc-frame.is-playing {
    aspect-ratio: 16 / 9;
  }
  .dc-poster {
    position: absolute;
    inset: 0;
    height: 100% !important;
    object-fit: cover;
    object-position: 50% 45%;
    opacity: 0.85;
  }
  /* a soft dark ground under the title card */
  .dc-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(5 5 5 / 0.85), rgb(5 5 5 / 0.1) 55%, transparent);
    pointer-events: none;
  }
  .dc-viewfinder {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .dc-mark {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 0 solid rgb(236 226 206 / 0.7);
  }
  .dc-tl { top: 14px; left: 14px; border-width: 1.5px 0 0 1.5px; }
  .dc-tr { top: 14px; right: 14px; border-width: 1.5px 1.5px 0 0; }
  .dc-bl { bottom: 14px; left: 14px; border-width: 0 0 1.5px 1.5px; }
  .dc-br { bottom: 14px; right: 14px; border-width: 0 1.5px 1.5px 0; }
  .dc-rec,
  .dc-tc {
    position: absolute;
    top: 20px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(236 226 206 / 0.8);
  }
  .dc-rec {
    left: 48px;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dc-rec i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dc-rec);
    animation: dc-blink 1.2s steps(1) infinite;
  }
  .dc-tc {
    right: 48px;
  }
  @keyframes dc-blink {
    50% {
      opacity: 0;
    }
  }
  .dc-titlecard {
    position: absolute;
    z-index: 2;
    left: clamp(22px, 4vw, 48px);
    right: clamp(180px, 22vw, 300px);
    bottom: clamp(26px, 4.5vw, 52px);
  }
  .dc-kicker {
    margin-bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-tungsten);
  }
  .dc-title {
    font-size: clamp(1.5rem, 5.2vw, 4.5rem);
    font-stretch: 125%;
    font-weight: 640;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .dc-play {
    position: absolute;
    z-index: 3;
    right: clamp(22px, 4vw, 48px);
    bottom: clamp(26px, 4.5vw, 52px);
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px 14px 16px;
    border: 0;
    border-radius: 99px;
    background: var(--dc-tungsten);
    font: inherit;
    font-weight: 700;
    color: var(--dc-bg);
    cursor: pointer;
  }
  .dc-play svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .dc-play:focus-visible {
    outline: 2px solid var(--dc-ink);
    outline-offset: 3px;
  }
  @media (hover: hover) {
    .dc-play {
      transition: background-color 0.2s ease-out;
    }
    .dc-play:hover {
      background: var(--dc-ink);
    }
  }
  .dc-frame.is-playing :is(.dc-viewfinder, .dc-titlecard, .dc-play, .dc-poster),
  .dc-frame.is-playing::after {
    display: none;
  }
  .dc-frame :global(.dc-player) {
    position: absolute;
    inset: 0;
    z-index: 4;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .dc-hero-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 12px clamp(28px, 5vw, 72px);
    align-items: start;
  }
  .dc-lede {
    max-width: 56ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: var(--dc-ink-2);
  }
  /* the slate: the clapperboard's facts, ruled in chalk */
  .dc-slate {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--dc-line);
    border-radius: 4px;
  }
  .dc-slate div {
    padding: 14px 16px;
    border-bottom: 1px solid var(--dc-line);
  }
  .dc-slate div:nth-child(odd) {
    border-right: 1px solid var(--dc-line);
  }
  .dc-slate div:nth-last-child(-n + 2):nth-child(odd),
  .dc-slate div:last-child {
    border-bottom: 0;
  }
  .dc-slate dt,
  .dc-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dc-ink-3);
  }
  .dc-slate dd {
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.35;
  }

  /* ---------- the reels ---------- */
  .dc-rail {
    position: sticky;
    top: 0;
    z-index: 5;
    padding: 0 var(--dc-pad);
    background: rgb(14 13 12 / 0.92);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-block: 1px solid var(--dc-line);
  }
  /* sprocket holes along both edges of the strip */
  .dc-rail::before,
  .dc-rail::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 5px;
    background: radial-gradient(circle, rgb(236 226 206 / 0.14) 1.6px, transparent 2px) 0 50% / 16px 5px repeat-x;
