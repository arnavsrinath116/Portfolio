---
import { withBase } from '../../../lib/url';
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const img = (n: string) => withBase(`/projects/theyyam/${n}.webp`);

// The Man the God Wore: a thirteen-person DIP field study of Theyyam in Kannur, and the documentary
// I co-led for it. The report and the film were made side by side, so the card tells them as one
// story: the film plays first, in the camera's viewfinder; then how we made both; then the report's
// eight chapters, each pairing what we found with what we saw and recorded; then the credits.
// Everything here comes from the report and the two presentations.
// PLACEHOLDER: lines set in mono (.dc-todo) wait for Arnav's own account of writing and shooting.
const FILM = 'https://drive.google.com/file/d/18LXtGkTumYXwmwiRuVJ8TjdpPyq_WjGt/preview';
// the full report, compressed for the web, with the signature page blanked
const PAPER = withBase('/projects/theyyam/the-man-the-god-wore.pdf');

// the report's eight chapters, in its own words; cover is the chapter's opening photograph
const chapters = [
  { key: 'earth', rail: 'Born of Earth', title: 'Born of Earth, Bound by Fear', sub: 'What Theyyam is', cover: 'ch-earth', alt: 'A Theyyam deity seated on the bare earth among embers, smoke rising behind' },
  { key: 'outside', rail: 'Looking in', title: 'Looking In From the Outside', sub: 'What we set out to find', cover: 'ch-outside', alt: 'A Theyyam performer in a vast red headdress, watched by a crowd' },
  { key: 'grove', rail: 'Who are you here?', title: 'Standing in the Grove, Who Are You Here?', sub: 'One ritual, seen three ways', cover: 'ch-grove', alt: 'A Theyyam performer ringed by burning torches at night, the congregation behind' },
  { key: 'shrine', rail: 'The shrine', title: 'The Shrine That Walks', sub: 'Costume, paint and place', cover: 'ch-shrine', alt: 'An assistant tying the costume onto a performer in red face paint' },
  { key: 'clock', rail: 'The clock', title: 'The Clock Stops at the Kavu', sub: 'Theyyam as living time', cover: 'ch-clock', alt: 'Oil lamps glowing in front of a performer’s painted face' },
  { key: 'goddess', rail: 'The goddess', title: 'The Goddess Wore a Man', sub: 'Gender, caste and who gets to be divine', cover: 'ch6-goddess', alt: 'Close-up of a goddess Theyyam: red painted face, silver eyes, red headdress' },
  { key: 'standing', rail: 'For how long?', title: 'The Grove Is Still Standing, But For How Long?', sub: 'Tourism, phones and the family house', cover: 'ch2-phone', alt: 'A phone held up in the dark, filming a Theyyam performance' },
  { key: 'burning', rail: 'Still burning', title: 'Belief, Still Burning', sub: 'What we found', cover: 'ch-burning', alt: 'A performer leaping through a ritual fire, sparks rising into the night' },
];

const kit: [string, string, string?][] = [
  ['11', 'iPhones'],
  ['1', 'Gimbal'],
  ['1', 'Canon EOS R50', 'my camera'],
  ['1', 'Canon EOS 500D'],
  ['1', 'Sony α7 III'],
  ['1', 'GoPro Hero 7'],
];

const slate = [
  ['Programme', 'Discover India · FLAME University'],
  ['Fieldwork', 'Kannur, Kerala · 20–28 Feb 2026'],
  ['My role', 'Documentary co-lead · writer & camera'],
  ['Team', '13 students · mentor Prof. Priya Joshi'],
];

// the full ritual arc, as all thirteen of us watched it
const arc = [
  { t: 'The Thottam', d: 'Before the costume, the performer sings the deity’s story: its origin, in its own words.', src: 'arc-thottam', alt: 'A performer in black and white, head thrown back, body marked with white paint' },
  { t: 'The face', d: 'Mugathezhuthu: four to six hours of natural pigment. Every deity has its own face.', src: 'arc-face', alt: 'A painted Theyyam face under a tall headdress, in black and white' },
  { t: 'The mirror', d: 'Mukhadarshanam. He looks into a mirror and no longer finds himself there.', src: 'mirror', alt: 'A performer in face paint looking into a hand mirror' },
  { t: 'The crown', d: 'The mudi goes on, and with it the deity is believed to enter the body.', src: 'arc-crown', alt: 'A Theyyam performer in full red costume, headdress and breastplate' },
  { t: 'Urayal', d: 'The drums climb, the voice changes, and the god arrives. Devotees bow and bring their troubles.', src: 'arc-urayal', alt: 'A performer with a towering headdress of flaming torches before a crowd at night' },
];

const sounds = [
  ['The crowd', 'before, during and after the transformation'],
  ['Chilambu', 'the ankle bells: the performer’s steps against the deity’s'],
  ['Chenda', 'the drums, as tempo and volume climb toward Urayal'],
  ['Thottam', 'the sung origin story'],
  ['The voice', 'the shift in the performer’s voice as the god takes it'],
];

const diagrams = [
  { src: 'dia-kantakarnan', t: 'Kantakarnan' },
  { src: 'dia-bhagavathy', t: 'Panayakkatu Bhagavathy' },
  { src: 'dia-pottan', t: 'Pottan' },
];

const findings = [
  { big: 'Transformation is lived, not a metaphor.', d: 'Performers describe the self leaving the body so the god can take it. The congregation treats it that way too.' },
  { big: 'A living archive for communities never permitted to write.', d: 'The Thottam carries history and migration through song, passed down inside performing families.' },
  { big: 'It turns caste upside down, then sets it back.', d: 'For the length of the ritual, upper castes bow to a performer from a marginalised community. After it, the order returns.' },
  { big: 'Tourism and phones threaten it, and keep it visible.', d: 'Staged shows strip the ritual of its sacred logic; the same cameras give it new ways to survive.' },
];

// the team, as credited in the report, grouped by what each of us did; the documentary team first.
// photo: a face cropped from the Group 42 photo (/projects/theyyam/team/); without one, initials
type Member = { name: string; role: string; photo?: string; me?: boolean };
const teams: { title: string; people: Member[] }[] = [
  {
    title: 'Documentary',
    people: [
      { name: 'Simran Vyas', role: 'Documentary lead' },
      { name: 'Arnav Srinath', role: 'Co-lead · writer & camera', me: true },
      { name: 'Bhanu Tarun Krishna Veeramachaneni', role: 'Documentary · writing' },
    ],
  },
  {
    title: 'Leading the group',
    people: [
      { name: 'Soumya Gupta', role: 'Group representative' },
      { name: 'Aliya Premji', role: 'Co-group representative' },
    ],
  },
  {
    title: 'Writing the report',
    people: [
      { name: 'Srishti Sudharsan', role: 'Writing lead' },
      { name: 'Radha Kulkarni', role: 'Writing co-lead · logistics' },
      { name: 'Richa Sajai', role: 'Writing' },
      { name: 'Divyanshi Nigam', role: 'Writing' },
      { name: 'Nitiksha Thukrul', role: 'Writing' },
    ],
  },
  {
    title: 'Logistics & finance',
    people: [
      { name: 'Muktak Joshi', role: 'Logistics lead' },
      { name: 'Vikhyat Upadhyay', role: 'Finance lead' },
      { name: 'Suhani Aggarwal', role: 'Finance · logistics' },
    ],
  },
];
const initials = (n: string) =>
  n
    .split(' ')
    .filter((w) => w[0] === w[0].toUpperCase())
    .slice(0, 2)
    .map((w) => w[0])
    .join('');
const pad = (n: number) => String(n).padStart(2, '0');
---

<article class="dc" data-project={project.slug} data-theme="film" data-card-bg="#0e0d0c" aria-labelledby="dc-title" hidden data-dc>
  <!-- ============ the film first, in the camera's viewfinder ============ -->
  <header class="dc-hero">
    <div class="dc-frame" data-dc-frame>
      <img class="dc-poster" src={img('hero')} alt="" width="2400" height="1004" decoding="async" />
      <span class="dc-viewfinder" aria-hidden="true">
        <span class="dc-mark dc-tl"></span><span class="dc-mark dc-tr"></span>
        <span class="dc-mark dc-bl"></span><span class="dc-mark dc-br"></span>
        <span class="dc-rec"><i></i>Rec</span>
        <span class="dc-tc">Kannur · Feb 2026</span>
      </span>
      <div class="dc-titlecard">
        <p class="dc-kicker">{project.discipline} · A documentary</p>
        <h2 class="dc-title" id="dc-title">{project.title}</h2>
      </div>
      <button type="button" class="dc-play" data-dc-play data-film-src={FILM} data-magnet>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
        Watch the film
      </button>
    </div>

    <div class="dc-hero-copy">
      <p class="dc-lede">
        In North Kerala, a man puts on paint, a crown and a costume, and the village believes he becomes a god. Thirteen of us spent
        nine days in Kannur studying that transformation, and made a report and a film of it side by side. I co-led the documentary:{' '}
        <em>I wrote it and shot it.</em>
      </p>
      <dl class="dc-slate">
        {
          slate.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))
        }
      </dl>
      <div class="dc-paper-acts">
        <button type="button" class="dc-btn" data-dc-read data-magnet>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5C6.5 4.5 9.5 4.5 12 6c2.5-1.5 5.5-1.5 8-.5v13c-2.5-1-5.5-1-8 .5-2.5-1.5-5.5-1.5-8-.5z M12 6v13.5"></path></svg>
          Read the full report
        </button>
        <a class="dc-btn dc-btn-ghost" href={PAPER} download="The Man the God Wore - Group 42 DIP report.pdf" data-magnet>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg>
          Download PDF
        </a>
        <span class="dc-paper-meta">100 pages · 4.3 MB</span>
      </div>
      <!-- the programme it was made for, credited with its own marks -->
      <div class="dc-made">
        <span class="dc-label">Made for</span>
        <span class="dc-logos">
          <span class="dc-plate"><img src={withBase('/projects/theyyam/logos/discover-india.webp')} alt="Discover India Program" width="1038" height="597" loading="lazy" decoding="async" /></span>
          <span class="dc-plate"><img src={withBase('/projects/theyyam/logos/flame.webp')} alt="FLAME University" width="349" height="139" loading="lazy" decoding="async" /></span>
        </span>
      </div>
    </div>
  </header>

  <!-- the report, read in place; on phones it opens in the browser's own viewer instead -->
  <dialog class="dc-reader" data-dc-reader aria-labelledby="dc-reader-t" data-lenis-prevent>
    <header class="dc-reader-bar">
      <p class="dc-reader-t" id="dc-reader-t">
        <span>The full report</span>
        <b>The Man the God Wore</b>
      </p>
      <a class="dc-btn" href={PAPER} download="The Man the God Wore - Group 42 DIP report.pdf">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v11m0 0-4.5-4.5M12 15l4.5-4.5M5 19.5h14"></path></svg>
        Download
      </a>
      <button type="button" class="dc-reader-x" data-dc-reader-close aria-label="Close the report">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </header>
    <iframe class="dc-reader-doc" title="The Man the God Wore, the full report" data-src={PAPER}></iframe>
  </dialog>

  <!-- the film strip: one frame per chapter -->
  <nav class="dc-rail" aria-label="Chapters">
    <ol>
      <li><a href="#dc-making" data-phase-link="making">How we made it</a></li>
      {
        chapters.map((c, i) => (
          <li>
            <a href={`#dc-${c.key}`} data-phase-link={c.key}>
              <span class="dc-rail-no">{pad(i + 1)}</span>
              {c.rail}
            </a>
          </li>
        ))
      }
      <li><a href="#dc-credits" data-phase-link="credits">Credits</a></li>
    </ol>
  </nav>

  <!-- ============ how we made it: one study, told twice ============ -->
  <section class="dc-reel dc-making" id="dc-making" data-phase="making" aria-labelledby="dc-making-t">
    <header class="dc-rhead">
      <p class="dc-rno">Before the chapters</p>
      <h3 class="dc-h" id="dc-making-t">One study, told twice</h3>
      <p class="dc-rnote">The report and the film, made side by side</p>
    </header>
    <div class="dc-twin">
      <div class="dc-copy">
        <p>
          The report and the documentary weren’t two projects. They came out of the same nine days and the same field checklist:
          what we had to ask, what we had to see and what we had to record. The writers followed the argument; the documentary team
          followed the ritual, from the first song to the oracle.
        </p>
        <p>
          So the film and the report tell one story, in the report’s eight chapters below. Each one sets what we <b>found</b> beside
          what we <b>saw and recorded</b>.
        </p>
      </div>
      <ul class="dc-counts">
        <li><b>9</b>days in Kannur</li>
        <li><b>10+</b>Kavus visited</li>
        <li><b>35</b>interviews</li>
        <li><b>13</b>of us, every one at a full ritual</li>
      </ul>
    </div>
    <div class="dc-twin dc-mine">
      <div class="dc-copy">
        <p class="dc-label">My part</p>
        <p>
          I co-led the documentary with Simran Vyas. <b>I wrote it and I shot it.</b> The report could describe Urayal; the film had to
          let people hear the drums climb and see the face in the mirror.
        </p>
        <p class="dc-todo">To come from Arnav: how the film was structured and written, and one decision on the ground that shaped it.</p>
      </div>
      <div>
        <p class="dc-label">What we shot on</p>
        <ul class="dc-kit">
          {kit.map(([n, k, note]) => (
            <li>
              <b>{n}</b>
              <span>
                {k}
                {note && <i>{note}</i>}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ the eight chapters ============ -->
  {
    chapters.map((c, i) => (
      <section class:list={['dc-ch', `dc-ch-${c.key}`, { 'is-flip': i % 2 === 1 }]} id={`dc-${c.key}`} data-phase={c.key} aria-labelledby={`dc-${c.key}-t`}>
        <div class="dc-ch-grid">
          <figure class="dc-ch-cover">
            <img src={img(c.cover)} alt={c.alt} loading="lazy" decoding="async"  />
            <figcaption>Chapter {pad(i + 1)}</figcaption>
          </figure>
          <div class="dc-ch-body">
            <header class="dc-ch-head">
              <p class="dc-rno">Chapter {pad(i + 1)} · {c.sub}</p>
              <h3 class="dc-ch-t" id={`dc-${c.key}-t`}>
                {c.title}
              </h3>
            </header>

            {c.key === 'earth' && (
              <>
                <blockquote class="dc-verse">
                  “Those who worship with their eyes will be worshipped with eyes.”
                  <cite>Kandu vazhipadu cheyyunnavare kandu vazhipadu cheyyum · the verse the report opens on</cite>
                </blockquote>
                <div class="dc-copy">
                  <p>
                    Theyyam is not theatre, a festival or a folk dance, though it has been labelled all three. It is a ritual of the{' '}
                    <b>Kavus</b>, the sacred groves of North Malabar, older than Brahmanical Hinduism. Its scholars call it the{' '}
                    <em>Theatre of the Earth</em>.
                  </p>
                  <p>
                    Many of its gods were born of fear: of tigers, snakes, fire, smallpox. The performer, the <b>Kolam-dhari</b>, does
                    not represent the deity. For the length of the ritual it lives in his body, and the village brings it real
                    troubles: illness, family quarrels, injustice.
                  </p>
                  <p>
                    Most performers come from castes long pushed to the margins: Malayan, Vannan, Velan, Pulaya. While the god is in
                    them, the upper castes bow.
                  </p>
                </div>
              </>
            )}

            {c.key === 'outside' && (
              <>
                <div class="dc-copy">
                  <p>
                    We went looking for one moment: <b>Urayal</b>, when the performer stops being a man and the deity arrives. Before
                    the field, our question was how the ritual’s choreography (sound, rhythm, movement and text) makes that crossing
                    happen. The research we read kept leaving the same things out.
                  </p>
                </div>
                <ol class="dc-gaps">
                  <li><b>The performer’s own voice.</b> Theyyam is written about from the outside; what he goes through is almost never asked.</li>
                  <li><b>The Thottam.</b> The sung origin stories are cited everywhere and translated almost nowhere.</li>
                  <li><b>The families.</b> What tourism does to the people who carry it is barely examined.</li>
                </ol>
                <div class="dc-copy">
                  <p>
                    So we went to ask. Thirty-five interviews across five groups: performers, drummers, Kavu owners, folk-studies
                    scholars and families, found through one another. Interviews in Malayalam were translated, then everything was
                    coded in Taguette.
                  </p>
                </div>
              </>
            )}

            {c.key === 'grove' && (
              <ul class="dc-povs">
                <li>
                  <span class="dc-label">The congregation</span>
                  <p>
                    <b>Darshan</b>: not only seeing the god, but being seen by it. In the field we watched heads bow, hands fold and
                    eyes stay fixed as the performance turned.
                  </p>
                </li>
                <li>
                  <span class="dc-label">The performer</span>
                  <p>
                    He doesn’t choose Theyyam. It is inherited, with the deities his family serves; boys grow up around the chenda
                    long before they may perform. In the mirror, <b>Mukhadarshanam</b>, he sees he is no longer himself.
                  </p>
                </li>
                <li>
                  <span class="dc-label">The deity</span>
                  <p>
                    <b>Urayal</b>, from the Malayalam “to reside”: the god resides in the body. Most performers remember nothing of
                    what they said. Then the paint comes off, and he returns to the respect denied him.
                  </p>
                </li>
              </ul>
            )}

            {c.key === 'shrine' && (
              <div class="dc-copy">
                <p>
                  The costume isn’t worn, it’s embodied. It goes on piece by piece, telling the deity’s story, and by the time the last
                  ornament is in place the transformation has already begun. The face, <b>Mugathezhuthu</b>, takes four to six hours.
                </p>
                <p>
                  At the Kerala Folklore Academy, one red costume was covered in small raised white dots. They weren’t decoration:
                  they were the pustules of smallpox. <em>The god born of a fear wears it.</em>
                </p>
                <p>
                  Around it all, the Kavu and the <b>Tharavaad</b>, the grove and the ancestral family house, hold the ritual in
                  place.
                </p>
              </div>
            )}

            {c.key === 'clock' && (
              <div class="dc-copy">
                <p>
                  Theyyam looks like a calendar ritual, but it makes its own time. The <b>Thottam</b> doesn’t describe the deity’s
                  origin, it makes it present: who they were, where they came from, how they moved from Kavu to Kavu. Travelling
                  histories, carried in the body from childhood, never in writing.
                </p>
                <p>
                  At Urayal, time collapses. The god in front of you is the same being as the one in the song, so a family’s illness
                  or a quarrel over land becomes part of an older moral order.
                </p>
                <p>That is why sound mattered to the film as much as image.</p>
              </div>
            )}

            {c.key === 'goddess' && (
              <>
                <div class="dc-copy">
                  <p>
                    Of more than four hundred Theyyams in North Malabar, most are goddesses, and not gentle ones: Shakti in its
                    fierce form. Many began as wronged women, one who read scriptures she was forbidden, another who sang when she was
                    not allowed.
                  </p>
                  <p>
                    When a man becomes a goddess, it isn’t imitation. For the ritual, gender itself is suspended. Then it returns,
                    exactly as caste does, and women stay outside the performance, except in Devakooth.
                  </p>
                </div>
                <p class="dc-pull">It doesn’t overturn the hierarchy. It suspends it, then sets it back.</p>
              </>
            )}

            {c.key === 'standing' && (
              <div class="dc-copy">
                <p>
                  Tourism sells Theyyam as a holiday package: rituals shortened, staged outside the calendar, performers flown abroad.
                  What survives is the costume, the fire and the drums. Visually extraordinary, and no longer Theyyam.
                </p>
                <p>
                  Phones preserve it and distort it. A Thottam each performer adapts becomes one fixed recording; younger Kolam-dharis
                  now choose how they are seen, and answer to followers too.
                </p>
                <p>
                  And quietly, the <b>Tharavaads</b> that hold performing families together are coming apart.
                </p>
              </div>
            )}

            {c.key === 'burning' && (
              <div class="dc-copy">
                <p>
                  Theyyam, as we saw it across every Kavu in Kannur, resists every attempt to define it. What we found on the ground
                  went well past what the reading had prepared us for.
                </p>
              </div>
            )}
          </div>
        </div>

        {c.key === 'grove' && (
          <ol class="dc-arc" aria-label="The ritual, start to finish">
            {arc.map((s, k) => (
              <li>
                <figure class="dc-arc-fig">
                  <img src={img(s.src)} alt={s.alt} loading="lazy" decoding="async" />
                </figure>
                <p class="dc-arc-no">{pad(k + 1)}</p>
                <h4>{s.t}</h4>
                <p>{s.d}</p>
              </li>
            ))}
          </ol>
        )}

        {c.key === 'outside' && (
          <p class="dc-shift">
            <span>Before the field</span>
            <s>Kasaragodi Nritya, Theyyam evvam Kavyagaram: a study of folk art and tradition</s>
            <span>After it</span>
            <b>The Man the God Wore</b>
          </p>
        )}

        {c.key === 'shrine' && (
          <div class="dc-dias">
            <p class="dc-label">Three costumes, drawn for the report</p>
            <ul>
              {diagrams.map((x) => (
                <li>
                  <img src={img(x.src)} alt={`Hand-illustrated diagram of the ${x.t} Theyyam costume, each part labelled`} width="824" height="1100" loading="lazy" decoding="async" />
                  <span>{x.t}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {c.key === 'clock' && (
          <div class="dc-sounds">
            <div>
              <p class="dc-label">Five sounds we recorded for the film</p>
              <ol class="dc-sound-list">
                {sounds.map(([k, v]) => (
                  <li>
                    <b>{k}</b>
                    {v}
                  </li>
                ))}
              </ol>
            </div>
            <figure class="dc-sound-fig">
              <img src={img('chenda')} alt="A chenda drum on a wooden stand in a temple courtyard, in black and white" width="675" height="1200" loading="lazy" decoding="async" />
              <figcaption>The chenda: its tempo marks the onset of Urayal.</figcaption>
            </figure>
          </div>
        )}

        {c.key === 'burning' && (
          <>
            <ol class="dc-finds">
              {findings.map((f) => (
                <li>
                  <b>{f.big}</b>
                  <p>{f.d}</p>
                </li>
              ))}
            </ol>
            <p class="dc-pull dc-coda">
              The deeper threat is quieter: when the Tharavaad falls apart, the networks that sustain the performing families go with it.
            </p>
            <ul class="dc-outputs">
              <li><b>A documentary</b>written and shot in Kannur</li>
              <li>
                <button type="button" class="dc-out-read" data-dc-read>
                  <b>A 100-page report</b>for FLAME’s Discover India Program · read it
                </button>
              </li>
              <li><b>A final presentation</b>to the university</li>
            </ul>
          </>
        )}
      </section>
    ))
  }

  <!-- ============ credits ============ -->
  <section class="dc-reel dc-credits" id="dc-credits" data-phase="credits" aria-labelledby="dc-credits-t">
    <header class="dc-rhead">
      <p class="dc-rno">End credits</p>
