---
/**
 * A journey map of Ananya ordering dinner on a work night, as things are
 * today: six steps, each with what happens, where it happens, and its high
 * and low points. A mood line runs under the steps. Everything in it comes
 * from the research: the interviews, the pain points and the persona.
 */
const steps = [
  {
    t: 'The day ends',
    d: 'She gets home late after a long, unpredictable day. Cooking for the family tonight isn’t going to happen.',
    touch: ['Commute home', 'The fridge', 'Family asking about dinner'],
    high: 'Relief at not having to cook',
    low: 'Guilt about feeding the family outside food again',
    mood: 3,
    feel: 'Relieved',
  },
  {
    t: 'Deciding what to eat',
    d: 'What she wants depends on her mood and who she’s eating with. She scrolls through apps looking for something that feels right.',
    touch: ['Swiggy', 'Zomato', 'Box8'],
    high: 'Her few trusted places make it quicker',
    low: 'Decision fatigue: lots of options, none like home',
    mood: 1.9,
    feel: 'Overwhelmed',
  },
  {
    t: 'Ordering',
    d: 'She picks a dish and tries to make it her way, with less oil and milder spice, through whatever the menu allows.',
    touch: ['Restaurant menu', 'Add-ons', 'Cooking instructions note'],
    high: 'Checkout takes a minute',
    low: '“Most apps aren’t accommodating of specific requests”',
    mood: 2.4,
    feel: 'Frustrated',
  },
  {
    t: 'Waiting',
    d: 'The app tracks the rider, but not the kitchen. She has no idea how the food is being made.',
    touch: ['Order tracking', 'Notifications', 'Rider’s call'],
    high: 'It arrives fast',
    low: 'No look into the kitchen: oil, spice and hygiene stay unknown',
    mood: 2,
    feel: 'Uneasy',
  },
  {
    t: 'Eating',
    d: 'Dinner is on the table and everyone is fed. But it rarely tastes like ghar ka khana.',
    touch: ['The packaging', 'The meal'],
    high: 'Hunger solved, no dishes to wash',
    low: 'Too oily, and the taste changes from order to order',
    mood: 3.4,
    feel: 'Content',
  },
  {
    t: 'After the meal',
    d: 'She rates it, or reorders a dish that worked last time, because that’s the only way she can trust the next one.',
    touch: ['Rating prompt', 'Previous orders'],
    high: 'Reordering a dish she already trusts',
    low: 'A rating doesn’t change how it’s made, so the guilt stays',
    mood: 1.6,
    feel: 'Guilty',
  },
];

// the mood line: one point per step, mood 1 (feels bad) to 4 (feels good), 2.5 neutral, as a smooth curve
// drawn at about the band's on-screen proportions, so stretching it to fit barely distorts it
const W = 1200;
const H = 100;
const pts = steps.map((s, i) => [((i + 0.5) / steps.length) * W, H - ((s.mood - 1) / 3) * (H - 16) - 8]);
// a feeling's name goes above a peak and below a dip, so it never sits on the line
const peak = (i: number) => steps[i].mood >= (steps[i - 1]?.mood ?? -1) && steps[i].mood >= (steps[i + 1]?.mood ?? -1);
const yOf = (m: number) => H - ((m - 1) / 3) * (H - 16) - 8;
const mid = yOf(2.5);
let d = `M${pts[0][0]} ${pts[0][1]}`;
for (let i = 0; i < pts.length - 1; i++) {
  const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
  const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
  const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
  d += ` C${c1[0].toFixed(1)} ${c1[1].toFixed(1)} ${c2[0].toFixed(1)} ${c2[1].toFixed(1)} ${p2[0].toFixed(1)} ${p2[1].toFixed(1)}`;
}
---

<div class="jm">
  <div class="jm-scroll">
    <ol class="jm-grid" style={`--n:${steps.length}`}>
      <!-- what each row is, down the left -->
      <li class="jm-rowk" style="--r:1">
        <b>The steps</b>
        <span class="jm-rowk-d">What she does, and the apps and things she touches</span>
      </li>
      <li class="jm-rowk jm-rowk-mood" style="--r:2">
        <b>How she feels</b>
        <span class="jm-axis jm-axis-hi">Good<small>relieved, in control</small></span>
        <span class="jm-axis jm-axis-mid">Neutral</span>
        <span class="jm-axis jm-axis-lo">Bad<small>stressed, guilty</small></span>
      </li>
      <li class="jm-rowk" style="--r:3">
        <b>Highs and lows</b>
        <span><i class="jm-k-hi">+</i> what works for her<br /><i class="jm-k-lo">−</i> what lets her down</span>
      </li>

      {
        steps.map((s, i) => (
          <li class="jm-step" style={`--c:${i + 2}`}>
            <p class="jm-no">{String(i + 1).padStart(2, '0')}</p>
            <h4 class="jm-t">{s.t}</h4>
            <p class="jm-d">{s.d}</p>
            <p class="jm-label">Touchpoints</p>
            <ul class="jm-touch">
              {s.touch.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </li>
        ))
      }

      <!-- the mood line, under all six steps: good at the top, bad at the bottom, neutral dashed through the middle -->
      <li class="jm-mood">
        <p class="jm-sr">How she feels at each step: {steps.map((s, i) => `${i + 1}, ${s.t}: ${s.feel}`).join('; ')}.</p>
        <div class="jm-mood-in" aria-hidden="true">
          <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none">
            <path class="jm-mood-mid" d={`M0 ${mid} H${W}`} />
            <path class="jm-mood-line" d={d} />
          </svg>
          {
            pts.map(([x, y], i) => (
              <span
                class:list={['jm-dot', { 'is-low': steps[i].mood < 2.5, 'is-high': steps[i].mood > 2.5, 'is-under': !peak(i) }]}
                style={`left:${(x / W) * 100}%;top:${(y / H) * 100}%`}
              >
                <em>{steps[i].feel}</em>
              </span>
            ))
          }
        </div>
      </li>

      {
        steps.map((s, i) => (
          <li class="jm-hl" style={`--c:${i + 2}`}>
            <p class="jm-high">
              <span aria-hidden="true">+</span>
              <span class="jm-sr">High: </span>
              {s.high}
            </p>
            <p class="jm-low">
              <span aria-hidden="true">−</span>
              <span class="jm-sr">Low: </span>
              {s.low}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
  <p class="jm-hint" aria-hidden="true">Scroll sideways for every step →</p>
</div>

<style>
  .jm {
    --jm-col: minmax(170px, 1fr);
    --jm-key: 132px;
  }
  .jm-scroll {
    overflow-x: auto;
    overflow-y: hidden;
    padding-bottom: 6px;
    scrollbar-width: thin;
  }
  .jm-grid {
    display: grid;
    grid-template-columns: var(--jm-key) repeat(var(--n), var(--jm-col));
    grid-auto-flow: dense;
    column-gap: 14px;
    min-width: 1190px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* the steps: one white card each, along the top row */
  .jm-step {
    grid-row: 1;
    grid-column: var(--c);
    display: flex;
    flex-direction: column;
    padding: 18px 18px 20px;
    border-radius: calc(22px * var(--sq)) calc(22px * var(--sq)) 0 0;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  .jm-no {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--ck-green);
  }
  .jm-t {
    margin-top: 6px;
    font-size: 1.125rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .jm-d {
    margin-top: 8px;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ck-ink-2);
  }
  .jm-label {
    margin-top: auto;
    padding-top: 16px;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ck-ink-3);
  }
  .jm-touch {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
  }
  .jm-touch li {
    padding: 5px 10px;
    border-radius: 99px;
    corner-shape: round;
    background: var(--ck-bg);
    box-shadow: 0 0 0 1px var(--ck-rule);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /* the row keys: what each band of the map is, held on the left as the map scrolls */
  .jm-rowk {
    grid-row: var(--r);
    grid-column: 1;
    position: sticky;
    left: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 12px 18px 0;
    background: var(--ck-bg);
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--ck-ink-3);
  }
  .jm-rowk b {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ck-ink);
  }
  .jm-rowk i {
    display: inline-grid;
    place-items: center;
    width: 14px;
    height: 14px;
    margin-right: 4px;
    border-radius: 50%;
    corner-shape: round;
    font-style: normal;
    font-weight: 900;
    font-size: 0.625rem;
    color: #fff;
  }
  .jm-k-hi {
    background: var(--ck-green);
  }
  .jm-k-lo {
    background: var(--ck-turmeric-deep);
  }
  /* the mood row's key is the chart's axis: good, neutral, bad, level with the band */
  .jm-rowk-mood {
    position: sticky;
    padding: 0 12px 0 0;
    display: block;
  }
  .jm-rowk-mood b {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
  }
  .jm-axis {
    position: absolute;
    right: 12px;
    display: grid;
    justify-items: end;
    font-size: 0.75rem;
    font-weight: 800;
    line-height: 1.2;
    text-align: right;
    transform: translateY(-50%);
  }
  .jm-axis small {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--ck-ink-3);
  }
  /* the band's line box is inset 22px; these sit where mood 4, 2.5 and 1 fall in it */
  .jm-axis-hi {
    top: calc(22px + (100% - 44px) * 0.08);
    color: var(--ck-green);
  }
  .jm-axis-mid {
    top: calc(22px + (100% - 44px) * 0.5);
    color: var(--ck-ink-3);
  }
  .jm-axis-lo {
    top: calc(22px + (100% - 44px) * 0.92);
    color: var(--ck-turmeric-deep);
  }

  /* the mood line: a band across every step column, good at the top, bad at the bottom */
  .jm-mood {
    position: relative;
    grid-row: 2;
    grid-column: 2 / -1;
    height: 184px;
    border-radius: 0;
    background:
      linear-gradient(to bottom, rgb(51 113 64 / 0.08), transparent 45%, transparent 55%, rgb(244 182 63 / 0.16)),
      #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  /* the line and its dots share one box, so each dot sits on the line */
  .jm-mood-in {
    position: absolute;
    inset: 22px 0;
  }
  .jm-mood-mid {
    fill: none;
    stroke: var(--ck-ink-3);
    stroke-width: 1;
    stroke-dasharray: 4 5;
    vector-effect: non-scaling-stroke;
    opacity: 0.6;
  }
  .jm-mood svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .jm-mood-line {
    fill: none;
    stroke: var(--ck-ink);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .jm-dot {
    position: absolute;
    width: 16px;
    height: 16px;
    margin: -8px 0 0 -8px;
    border: 3px solid #fff;
    border-radius: 50%;
    corner-shape: round;
    background: var(--ck-ink);
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  .jm-dot.is-high {
    background: var(--ck-green);
  }
  .jm-dot.is-low {
    background: var(--ck-turmeric-deep);
  }
  /* the feeling, named beside its dot: above a peak, below a dip */
  .jm-dot em {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 6px);
    transform: translateX(-50%);
    font-style: normal;
    font-size: 0.75rem;
    font-weight: 800;
    white-space: nowrap;
    color: var(--ck-ink);
  }
  .jm-dot.is-under em {
    top: calc(100% + 6px);
    bottom: auto;
  }

  /* highs and lows, under each step */
  .jm-hl {
    grid-row: 3;
    grid-column: var(--c);
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 14px;
    border-radius: 0 0 calc(22px * var(--sq)) calc(22px * var(--sq));
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  .jm-high,
  .jm-low {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 8px;
    padding: 10px 12px;
    border-radius: calc(12px * var(--sq));
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .jm-high {
    background: var(--ck-green-soft);
  }
  .jm-low {
    background: var(--ck-turmeric-tint);
  }
  .jm-high > span:first-child,
  .jm-low > span:first-child {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    corner-shape: round;
    font-weight: 900;
    color: #fff;
  }
  .jm-high > span:first-child {
    background: var(--ck-green);
  }
  .jm-low > span:first-child {
    background: var(--ck-turmeric-deep);
  }
  .jm-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .jm-hint {
    display: none;
    margin-top: 10px;
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--ck-ink-3);
  }
  @media (max-width: 1120px) {
    .jm-hint {
      display: block;
    }
  }
  /* on a phone the keys shrink to a narrow rail, so a step still fits beside them */
  @media (max-width: 620px) {
    .jm {
      --jm-key: 78px;
      --jm-col: 200px;
    }
    .jm-grid {
      column-gap: 10px;
      min-width: 0;
    }
    .jm-rowk {
      padding-right: 6px;
      font-size: 0.625rem;
    }
    .jm-rowk-d {
      display: none;
    }
    .jm-rowk b {
      font-size: 0.5625rem;
      white-space: normal !important;
    }
    .jm-rowk-mood b {
      right: 6px;
    }
    .jm-axis {
      right: 6px;
    }
    .jm-axis small {
      display: none;
    }
  }
</style>
