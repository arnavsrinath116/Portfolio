  }

  /* assumptions board */
  .ck-assume {
    display: grid;
    align-content: center;
    gap: clamp(22px, 4vh, 40px);
  }
  .ck-notes {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 18px);
  }
  .ck-note {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 14px;
    background: var(--ck-turmeric-tint);
    font-size: clamp(0.8125rem, 1.05vw, 0.9375rem);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    box-shadow: 0 10px 18px -12px rgb(20 23 26 / 0.45);
  }
  .ck-note.is-risky {
    background: #fff;
    box-shadow:
      inset 0 0 0 2px var(--ck-turmeric-deep),
      0 10px 18px -12px rgb(20 23 26 / 0.45);
  }
  .ck-note-tag {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 2px 8px;
    border-radius: 99px;
    background: var(--ck-turmeric-deep);
    color: #fff;
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .ck-tick {
    position: absolute;
    top: -12px;
    right: -12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ck-green);
    color: #fff;
    font-size: 1rem;
    font-weight: 900;
  }

  /* observations */
  .ck-obs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
  }
  .ck-obs li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 16px;
    padding: 26px 18px;
    border-radius: 22px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    text-align: center;
  }
  .ck-obs img,
  .ck-ico {
    width: 92px;
    height: 92px;
    object-fit: contain;
  }
  .ck-ico {
    fill: none;
    stroke: var(--ck-ink);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---------- define ---------- */
  .ck-persona-card {
    display: grid;
    grid-template-columns: minmax(160px, 300px) 1fr;
    align-items: center;
    gap: clamp(24px, 5vw, 72px);
    padding: clamp(26px, 4vw, 56px);
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule), 0 30px 60px -40px rgb(20 23 26 / 0.4);
  }
  .ck-persona-fig {
    width: 100%;
    height: auto;
  }
  .ck-persona-name {
    margin-top: 14px;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .ck-persona-quote {
    margin-top: 18px;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--ck-green);
  }
  .ck-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 12px;
    margin-top: 34px;
  }
  .ck-chips li {
    padding: 11px 18px;
    border-radius: 999px;
    background: var(--ck-turmeric-tint);
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .ck-persona-meta {
    margin-top: 30px;
    padding-top: 18px;
    border-top: 1px solid var(--ck-rule);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ck-ink-3);
  }

  .ck-spec {
    display: grid;
    align-content: center;
    gap: 28px;
  }
  .ck-spec-track {
    position: relative;
    height: 18px;
    border-radius: 99px;
    background: rgb(20 23 26 / 0.08);
  }
  .ck-spec-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--p, 4%);
    border-radius: 99px;
    background: linear-gradient(90deg, var(--ck-green), var(--ck-turmeric));
  }
  .ck-spec-knob {
    position: absolute;
    top: 50%;
    left: var(--p, 4%);
    width: 46px;
    height: 46px;
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 0 3px var(--ck-ink),
      0 10px 22px -10px rgb(20 23 26 / 0.5);
  }
  .ck-spec-ends {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }
  .ck-spec-ends p {
    display: grid;
    gap: 2px;
    color: var(--ck-ink-2);
    font-weight: 600;
  }
  .ck-spec-ends p:last-child {
    text-align: right;
  }
  .ck-spec-ends b {
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    font-weight: 800;
    color: var(--ck-ink);
  }
  .ck-spec-verdict {
    justify-self: center;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    text-align: center;
  }

  .ck-needs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 24px);
  }
  .ck-needs li {
    display: grid;
    gap: 16px;
    align-content: start;
    padding: 26px 22px 30px;
    border-radius: 22px;
    background: var(--ck-green);
    color: #fff;
    font-size: clamp(1.1rem, 1.6vw, 1.375rem);
    font-weight: 800;
    line-height: 1.15;
  }
  .ck-needs span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--ck-turmeric);
    color: var(--ck-ink);
    font-size: 1rem;
  }

  .ck-hmw {
    display: grid;
    align-content: center;
    gap: clamp(26px, 5vh, 48px);
  }
  .ck-hmw-q {
    max-width: 22ch;
    font-size: clamp(2rem, 5vw, 4.4rem);
    font-weight: 900;
    line-height: 1.02;
    letter-spacing: -0.04em;
  }
  .ck-hmw-q .w {
    opacity: 0.16;
  }
  .ck-insight {
    max-width: 36ch;
    padding-left: 22px;
    border-left: 4px solid var(--ck-turmeric);
    font-size: clamp(1.2rem, 2.1vw, 1.75rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .ck-shift {
    display: grid;
    align-content: center;
    justify-items: center;
    text-align: center;
  }
  .ck-shift-a {
    position: relative;
    font-size: clamp(1.8rem, 4.4vw, 3.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .ck-strike {
    position: absolute;
    left: -2%;
    top: 54%;
    width: 104%;
    height: 6px;
    border-radius: 99px;
    background: var(--ck-ink);
    transform-origin: left;
    transform: scaleX(0);
  }
  .ck-shift-arrow {
    width: clamp(160px, 22vw, 300px);
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--ck-turmeric);
    stroke-width: 9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ck-shift-b {
    font-size: clamp(2.2rem, 6vw, 5.4rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .ck-recipe {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(32px, 5vw, 64px);
    border-radius: 6px;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--ck-rule),
      0 30px 60px -40px rgb(20 23 26 / 0.45);
  }
  .ck-recipe-goal {
    margin-top: 14px;
    font-size: clamp(1.6rem, 3.2vw, 2.6rem);
    font-weight: 900;
    line-height: 1.08;
    text-wrap: balance;
    letter-spacing: -0.03em;
  }
  .ck-steps {
    display: grid;
    margin-top: 36px;
    border-top: 1px solid var(--ck-rule);
  }
  /* one step per line, like a recipe: a hairline between each */
  .ck-steps li {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 0;
    border-bottom: 1px solid var(--ck-rule);
    line-height: 1.35;
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    font-weight: 700;
  }
  .ck-box {
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: var(--ck-green);
    box-shadow: inset 0 0 0 2px var(--ck-green);
    position: relative;
  }
  .ck-box::after {
    content: '';
    position: absolute;
    left: 8px;
    top: 4px;
    width: 7px;
    height: 13px;
    border: solid #fff;
    border-width: 0 3px 3px 0;
    rotate: 45deg;
  }

  /* ---------- develop ---------- */
  .ck-ideas {
    display: grid;
    align-content: center;
    gap: clamp(18px, 3vh, 32px);
  }
  .ck-wall {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 16px);
  }
  .ck-idea {
    position: relative;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    padding: 10px;
    rotate: var(--r);
    background: #fff;
    font-size: clamp(0.75rem, 0.98vw, 0.9375rem);
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    box-shadow:
      0 0 0 1px var(--ck-rule),
      0 10px 18px -12px rgb(20 23 26 / 0.4);
  }
  .ck-idea:nth-child(even) {
    background: var(--ck-turmeric-tint);
  }
  .ck-idea.is-keep {
    box-shadow:
      0 0 0 3px var(--ck-green),
      0 10px 18px -12px rgb(20 23 26 / 0.4);
  }
  .ck-idea-x {
    position: absolute;
    left: 8%;
    top: 50%;
    width: 84%;
    height: 4px;
    border-radius: 99px;
    background: var(--ck-ink);
    rotate: -18deg;
    transform-origin: left;
    transform: scaleX(0);
  }
  .ck-idea-tag {
    position: absolute;
    left: 50%;
    bottom: -14px;
    translate: -50% 0;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--ck-green);
    color: #fff;
    font-size: 0.6875rem;
    white-space: nowrap;
  }

  /* three directions: wide cards in place of the sticky-note wall */
  .ck-dirs {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
  }
  .ck-dirs .ck-idea {
    aspect-ratio: auto;
    place-items: start;
    align-content: start;
    gap: 10px;
    padding: clamp(18px, 2vw, 28px);
    border-radius: 14px;
    text-align: left;
    font-weight: 500;
  }
  .ck-dir-t {
    font-size: clamp(1.05rem, 1.5vw, 1.375rem);
    font-weight: 700;
    line-height: 1.15;
  }
  .ck-dir-why {
    font-size: 0.9375rem;
    color: var(--ck-ink-2);
  }
  .ck-dir-v {
    font-size: 0.875rem;
    font-weight: 700;
  }
  .ck-dirs .is-keep .ck-dir-v {
    color: var(--ck-green);
  }
  .ck-dirs .ck-idea-x {
    left: 6%;
    top: 22px;
    width: 70%;
    height: 3px;
    rotate: -4deg;
  }

  @media (max-width: 900px) {
    .ck-wall.ck-dirs {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .ck-dirs .ck-idea {
      padding: 16px 18px;
      font-size: 0.875rem;
    }
  }

  .ck-sketches {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
    align-items: center;
  }
  .ck-sketches img {
    width: 100%;
    height: auto;
    border-radius: 6px;
    box-shadow: 0 24px 40px -26px rgb(20 23 26 / 0.55);
  }
  .ck-sketches img:nth-child(1) {
    rotate: -3deg;
  }
  .ck-sketches img:nth-child(3) {
    rotate: 2.5deg;
  }

  /* mid-fi wireframes: the same phone frame as the final screens, captioned like the journey */
  .ck-wires {
    --ph-w: clamp(140px, 17vw, 236px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(14px, 3vw, 48px);
  }
  .ck-wire {
    display: grid;
    justify-items: center;
    gap: 18px;
  }
  .ck-wire p {
    display: grid;
    justify-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 0.9375rem;
  }
  .ck-grid-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ck-ink-2);
    text-align: center;
  }
  .ck-grid-swatch {
    flex: none;
    width: 22px;
    height: 14px;
    border-radius: 3px;
    background: repeating-linear-gradient(90deg, rgb(255 0 0 / 0.18) 0 4px, transparent 4px 7px);
    box-shadow: 0 0 0 1px rgb(255 0 0 / 0.25);
  }
  /* the page dropped after testing: dimmed, labelled, not stamped over */
  .ck-wire.is-cut :global(img) {
    opacity: 0.45;
    filter: grayscale(1);
  }
  .ck-cut-tag {
    white-space: nowrap;
    padding: 4px 10px;
    border-radius: 99px;
    background: var(--ck-ink);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ck-pivot {
    display: grid;
    align-content: center;
    gap: clamp(16px, 3vh, 28px);
  }
  .ck-pivot-row {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(14px, 3vw, 40px);
    margin-top: 10px;
  }
  .ck-pivot-card {
    position: relative;
    display: grid;
    gap: 8px;
    padding: clamp(20px, 3vw, 40px);
    border-radius: 24px;
    background: #fff;
    box-shadow: 0 0 0 1.5px var(--ck-rule);
    font-weight: 600;
    color: var(--ck-ink-2);
  }
  .ck-pivot-label {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ck-ink-3);
  }
  .ck-pivot-q {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ck-ink);
  }
  .ck-pivot-card .ck-strike {
    top: 50%;
    left: 6%;
    width: 88%;
  }
  .ck-toggle {
    width: 88px;
    height: 48px;
    padding: 5px;
    border-radius: 99px;
    background: var(--ck-green);
  }
  .ck-toggle span {
    display: block;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: #fff;
  }
  .ck-pivot-chips {
    margin-top: 6px;
  }

  /* ---------- deliver ---------- */
  .ck-brand {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: clamp(18px, 3vw, 40px);
  }
  .ck-swatches {
    display: grid;
    gap: 12px;
  }
  .ck-swatches li {
    display: grid;
    align-content: end;
    gap: 2px;
    min-height: 120px;
    padding: 18px 22px;
    border-radius: 20px;
    font-weight: 600;
    transform-origin: left;
  }
  .ck-swatches b {
    font-size: 1.5rem;
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .sw-green {
    background: var(--ck-green);
    color: #fff;
  }
  .sw-white {
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  .sw-turmeric {
    background: var(--ck-turmeric);
  }
  .ck-type {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 6px;
    padding: 28px 32px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
    font-weight: 600;
    color: var(--ck-ink-2);
  }
  .ck-type p {
    display: grid;
  }
  .ck-type b {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--ck-ink);
  }
  .ck-type-aa {
    font-size: clamp(5rem, 11vw, 9rem);
    font-weight: 900;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--ck-ink) !important;
  }
  .ck-kit-wrap > .ck-kicker {
    margin-bottom: 10px;
  }
  .ck-mood {
    grid-column: 1 / -1;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .ck-journey {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 20px;
    padding-left: 0;
    padding-right: 0;
  }
  .ck-journey-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 0 var(--ck-pad);
  }
  .ck-journey-count {
    font-size: 1rem;
    font-weight: 700;
    color: var(--ck-ink-3);
    font-variant-numeric: tabular-nums;
  }
  .ck-journey-count b {
    font-size: 1.75rem;
    color: var(--ck-green);
  }
  .ck-journey-track {
    --ph-w: clamp(170px, min(20vw, 30svh), 260px);
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(28px, 4vw, 64px);
    width: max-content;
    padding: 0 var(--ck-pad);
  }
  .ck-journey-line {
    position: absolute;
    left: var(--ck-pad);
    right: var(--ck-pad);
    top: 50%;
    height: 3px;
    z-index: -1;
    background: var(--ck-green);
    transform-origin: left;
  }
  .ck-journey-step {
    display: grid;
    justify-items: center;
    gap: 16px;
  }
  .ck-journey-step p {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px 6px 6px;
    border-radius: 99px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
    font-weight: 700;
    white-space: nowrap;
  }
  .ck-journey-step p span {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--ck-turmeric);
    font-size: 0.75rem;
    font-weight: 900;
  }

  .ck-phones {
    --ph-w: clamp(150px, 19vw, 250px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: clamp(14px, 3vw, 44px);
  }
  .ck-phones-4 {
    --ph-w: clamp(130px, 16vw, 220px);
  }
  .ck-phones :global(.ck-p2) {
    margin-top: 48px;
  }
  .ck-phones :global(.ck-p4) {
    margin-top: 48px;
  }

  .ck-merch-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
    align-items: center;
  }
  .ck-merch-grid img {
    width: 100%;
    height: auto;
    border-radius: 18px;
    box-shadow: 0 24px 46px -30px rgb(20 23 26 / 0.5);
  }
  .ck-merch-grid img:nth-child(1) { grid-column: 1 / 4; }
  .ck-merch-grid img:nth-child(2) { grid-column: 4 / 7; }
  .ck-merch-grid img:nth-child(3) { grid-column: 1 / 3; }
  .ck-merch-grid img:nth-child(4) { grid-column: 3 / 5; }
  .ck-merch-grid img:nth-child(5) { grid-column: 5 / 7; }

  /* ---------- dessert ---------- */
  .ck-again {
    padding: clamp(100px, 18vh, 200px) var(--ck-pad) clamp(40px, 7vh, 80px);
    text-align: center;
    font-size: clamp(2.4rem, 7vw, 6rem);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .ck-finale {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 18px;
    min-height: min(var(--stage-h), 680px);
    margin: 0 var(--ck-pad);
    border-radius: 28px;
    overflow: hidden;
    background: var(--ck-turmeric);
    text-align: center;
  }
  .ck-finale-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .ck-finale-mark {
    position: relative;
    width: min(620px, 74%);
    height: auto;
    filter: brightness(0) invert(1);
  }
  .ck-finale p {
    position: relative;
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    font-weight: 800;
    color: var(--ck-ink);
  }
  .ck-said {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .ck-said li {
    padding: 22px;
    border-radius: 22px 22px 22px 6px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--ck-rule);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
