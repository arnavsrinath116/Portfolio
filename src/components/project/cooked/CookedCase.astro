---
import Phone from './Phone.astro';
import CookedFlow from './CookedFlow.astro';
import CookedKit from './CookedKit.astro';
import CookedPersona from './CookedPersona.astro';
import CookedJourney from './CookedJourney.astro';
import Prototype from '../../Prototype.astro';
import { skills } from '../../../data/skills';
import { withBase } from '../../../lib/url';
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const img = (n: string) => withBase(`/projects/cooked/${n}.webp`);
// the same clickable Figma prototype the UI design skill shows
const proto = skills.find((s) => s.slug === 'ui-design')?.works.find((w) => w.title === 'Cooked app')?.prototype;

// facts shown in the hero; placeholders stay hidden until they're real
const facts = [
  ['Discipline', project.discipline],
  ['Duration', project.duration],
  ['Role', project.role],
  ['Team', project.team],
  ['Tools', project.tools.join(' · ')],
].filter(([, v]) => v && !/TBD/i.test(v));

// The story runs in one order: the problem, the brief we set ourselves, the app we made, how we
// got there (research, then design), and how it landed. The answer is never more than a scroll away
const chapters = [
  { key: 'problem', label: 'The problem' },
  { key: 'brief', label: 'The brief' },
  { key: 'app', label: 'The app' },
  { key: 'research', label: 'Research' },
  { key: 'design', label: 'Design' },
  { key: 'result', label: 'The result' },
];
const no = (key: string) => String(chapters.findIndex((c) => c.key === key) + 1).padStart(2, '0');

// the hero's three screens: what the app does, one step each
const heroShots = [
  { src: 'ui-search', cap: 'Pick the dish first', alt: 'Search dishes: a grid of dishes to choose from' },
  { src: 'ui-customise', cap: 'Your spice, your oil', alt: 'Customise dish: spice level and cooking oil' },
  { src: 'ui-chefs', cap: 'Chefs who make it best', alt: 'Select chefs: home chefs with ratings, distance and experience' },
];

const stats = [
  { n: '80–90%', t: 'default to convenience-first', to: 0.9 },
  { n: '70%', t: 'want more control', to: 0.7 },
  { n: '60%+', t: 'compromise on food quality when ordering', to: 0.6 },
];

const hmw = 'How might we give people the same confidence they feel eating home‑cooked food, even when someone else is cooking it?';
const hmwKey = new Set(['same', 'confidence', 'home‑cooked', 'food,', 'someone', 'else']);

const goals = ['Shift control to the chef', 'Make control feel natural, not effortful', 'Build trust through human connection', 'Give control without complexity'];

const journey = [
  { src: 'ui-home', cap: 'Home', alt: 'Home screen with quick actions to find chefs or search dishes, and a repeat-last-meal list' },
  { src: 'ui-search', cap: 'Pick a dish', alt: 'Search dishes screen with a grid of dishes' },
  { src: 'ui-filter', cap: 'Filter by mood', alt: 'Dish filters: quick picks, cuisine, mood, gourmet' },
  { src: 'ui-customise', cap: 'Make it yours', alt: 'Customise dish: spice level and cooking oil choices' },
  { src: 'ui-chefs', cap: 'Choose a chef', alt: 'Select chefs list with ratings, distance and experience' },
  { src: 'ui-profile', cap: 'Meet the chef', alt: 'Chef profile for Maria, Italian and Mediterranean' },
  { src: 'ui-sent', cap: 'Request sent', alt: 'Request sent, waiting for the chef to confirm' },
  { src: 'ui-confirmed', cap: 'Chef confirmed', alt: 'Chef confirmed with date, time and location' },
  { src: 'ui-summary', cap: 'Review', alt: 'Order summary with customisations and price breakdown' },
  { src: 'ui-success', cap: 'Booked', alt: 'Payment successful with booking details' },
];

const quotes = [
  { q: 'Since I’m the one eating it, I should have a say in how it’s made.', by: 'D.' },
  { q: 'Most apps aren’t accommodating of specific requests.', by: 'N.' },
  { q: 'I order online because I have no choice.', by: 'Interview' },
  { q: 'I want someone to cook closer to how it’s made at home.', by: 'N.' },
  { q: 'These apps restrict me.', by: 'Interview' },
  { q: 'When people give out that control, it’s very difficult to come back.', by: 'R.' },
];

const assumptions = [
  { t: 'People feel they lose control when they order food', keep: true },
  { t: 'Trust isn’t a barrier to outsourcing cooking' },
  { t: 'Users would want visibility into the cooking process', risky: true },
  { t: 'Convenience matters, but not at the cost of trust or health', keep: true },
  { t: 'Hiring full-time help is feasible for urban homes' },
  { t: 'People care deeply about ingredients, oil and hygiene', keep: true },
  { t: 'Traditional families will let someone new cook for them', risky: true },
  { t: 'Home-style food beats restaurant-style', keep: true },
  { t: 'People get lost in choices while ordering' },
  { t: 'Existing apps don’t balance convenience with culture', keep: true },
];

const needs = ['Home-like comfort', 'To know, without being too involved', 'Trust & safety', 'Guilt-free eating'];

// the directions we weighed: two that were cut, one that went forward
const directions = [
  { t: 'Teach them to cook', why: 'A companion app: step-by-step recipes and short videos.', verdict: 'Cut: it still asks a tired person to cook.', cut: true },
  { t: 'Guide the household cook', why: 'Exact instructions on the phone of the cook a family already has.', verdict: 'Cut: it only works where there’s full-time help.', cut: true },
  { t: 'Book a chef, made your way', why: 'A home chef cooks to preferences you set once, dish by dish.', verdict: 'Kept: control without the effort.', keep: true },
];

const wires = [
  { src: 'ui-wf2-onboarding', cap: 'Diet', alt: 'Mid-fi wireframe: dietary preference step' },
  { src: 'ui-wf2-home', cap: 'Home', alt: 'Mid-fi wireframe: home with quick actions and previous orders, shown with its layout grid', grid: true },
  { src: 'ui-wf2-avoid', cap: 'What to avoid', alt: 'Mid-fi wireframe: what to avoid step, later cut', cut: true },
  { src: 'ui-wf2-cuisine', cap: 'Cuisine', alt: 'Mid-fi wireframe: select cuisine' },
];

const changes = ['Hourly pricing, 1–1.5 h minimum', 'Basic · Expert · Gourmet cooks', 'Pure-veg cook filter', 'Fewer onboarding steps', 'Visible ID & hygiene checks', '“What to avoid” cut as redundant'];

const said = [
  ['Loved', 'customise your dish', ''],
  ['', '“What’s your mood today?”', 'felt unique'],
  ['Liked the', 'personalisation', ''],
  ['Wants', 'proof', 'of hygiene, not just a checklist'],
];
---

<article class="ck" data-project="cooked" data-theme="light" data-card-bg="#f4f5f2" aria-labelledby="cooked-title" hidden data-ck>
  <!-- the green line: it draws itself down the margins as you read, its pen tip at the reading point -->
  <svg class="ck-line" aria-hidden="true" data-ck-line><path class="ck-line-path"></path><circle class="ck-line-halo" r="11"></circle><circle class="ck-line-tip" r="5"></circle></svg>

  <!-- ===================== hero: the answer first ===================== -->
  <header class="ck-hero" data-pc-rise>
    <img class="ck-hero-frame" src={img('doodle-frame')} alt="" width="1652" height="952" loading="lazy" data-ck-preload />
    <div class="ck-hero-inner">
      <p class="ck-kicker">A UX/UI case study</p>
      <h2 class="ck-wordmark" id="cooked-title"><img src={img('wordmark')} alt="Cooked!" width="1600" height="347" loading="lazy" data-ck-preload /></h2>
      <p class="ck-tag">Your food, your way</p>
      <dl class="ck-pa">
        <div>
          <dt>The problem</dt>
          <dd>Ordering in means giving up a say in how your food is made: the oil, the spice, the hygiene.</dd>
        </div>
        <div>
          <dt>What we made</dt>
          <dd>Cooked, an app to book a home chef who cooks the dish you pick <em>your way</em>. Set up once and kept for every order.</dd>
        </div>
      </dl>
      <dl class="ck-facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="ck-hero-acts">
        {proto && <a class="ck-btn" href="#cooked-proto" data-jump data-magnet>Try the prototype</a>}
        <a class="ck-btn ck-btn-ghost" href="#cooked-app" data-jump data-magnet>See the app</a>
      </div>
    </div>
    <ol class="ck-hero-app" aria-label="The app in three steps">
      {
        heroShots.map((h, i) => (
          <li class={`ck-hs ck-hs-${i + 1}`}>
            <Phone src={h.src} alt={h.alt} />
            <span class="ck-hs-cap"><b>{i + 1}</b>{h.cap}</span>
          </li>
        ))
      }
    </ol>
  </header>

  <!-- the chapter rail: a slim column of dots on the card's right edge, marks the chapter you're in -->
  <div class="ck-dock-wrap" data-ck-dock>
    <nav class="ck-dock" aria-label="Case study chapters">
      <span class="ck-dock-now" aria-hidden="true" data-dock-now></span>
      <ol>
        {
          chapters.map((c) => (
            <li>
              <a href={`#cooked-${c.key}`} data-phase-link={c.key}>
                <span class="ck-dock-tag">
                  <span class="ck-dock-label">{c.label}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <!-- ===================== 01 the problem ===================== -->
  <section class="ck-ch" id="cooked-problem" data-phase="problem" aria-labelledby="cooked-problem-t">
    <header class="ck-chead">
      <p class="ck-course"><span>{no('problem')}</span>The problem</p>
      <h3 class="ck-ctitle" id="cooked-problem-t">You order in.<br />You lose control.</h3>
      <img class="ck-chead-art" src={img('doodles-bread')} alt="" width="900" height="900" loading="lazy" />
    </header>

    <div class="ck-block ck-imagine" data-ck-in>
      <div class="ck-imagine-copy">
        <p class="ck-big">A long day. You’re tired. So you order in, and you have no real say in how it’s made.</p>
        <p class="ck-body">Convenience wins every weeknight, and with it goes what home cooking gives you: knowing what went in, how much oil, how much spice, and who made it.</p>
      </div>
      <figure class="ck-seesaw" data-seesaw>
        <svg viewBox="0 0 800 420" role="img" aria-label="A seesaw tipped down on the convenience side, with control raised up">
          <path d="M400 268 L478 380 L322 380 Z" class="ss-pivot"></path>
          <rect x="290" y="380" width="220" height="14" rx="4" class="ss-base"></rect>
          <g transform="rotate(-11 400 260)" data-beam>
            <rect x="90" y="252" width="620" height="16" rx="8" class="ss-beam"></rect>
            <rect x="128" y="226" width="18" height="30" rx="4" class="ss-post"></rect>
            <rect x="654" y="226" width="18" height="30" rx="4" class="ss-post"></rect>
          </g>
          <g transform="translate(0 50)" data-ss-left>
            <text x="137" y="196" class="ss-big">Convenience</text>
            <text x="137" y="222" class="ss-small">quick · easy · no thinking</text>
          </g>
          <g transform="translate(0 -50)" data-ss-right>
            <text x="663" y="196" class="ss-big ss-green">Control</text>
            <text x="663" y="222" class="ss-small">what home cooking gives you</text>
          </g>
        </svg>
      </figure>
    </div>

    <div class="ck-block ck-split" data-ck-in>
      <div>
        <h4 class="ck-h">Who’s at the table</h4>
        <div class="ck-who">
          <figure><img src={img('pro')} alt="" width="400" height="420" loading="lazy" /><figcaption>Working professionals</figcaption></figure>
          <figure><img src={img('parent')} alt="" width="400" height="417" loading="lazy" /><figcaption>Parents</figcaption></figure>
        </div>
      </div>
      <div>
        <h4 class="ck-h">The numbers</h4>
        <ul class="ck-stats">
          {
            stats.map((s) => (
              <li>
                <b>{s.n}</b>
                <span class="ck-bar"><i style={`--to: ${s.to}`} /></span>
                {s.t}
              </li>
            ))
          }
        </ul>
        <p class="ck-market"><b>$55.58B</b> India’s food delivery market, still climbing <small>2024 → 2034 · IMARC, Nexdigm</small></p>
        <p class="ck-source">NielsenIQ · IMARC · Kadence · Market Xcel · Expert Market Research · IBEF</p>
      </div>
    </div>
  </section>

  <!-- ===================== 02 the brief ===================== -->
  <section class="ck-ch" id="cooked-brief" data-phase="brief" aria-labelledby="cooked-brief-t">
    <header class="ck-chead">
      <p class="ck-course"><span>{no('brief')}</span>The brief</p>
      <h3 class="ck-ctitle" id="cooked-brief-t">Taking the order</h3>
      <img class="ck-chead-art" src={img('doodles-green')} alt="" width="900" height="900" loading="lazy" />
    </header>

    <div class="ck-block ck-hmw" data-ck-in>
      <p class="ck-kicker">How might we</p>
      <p class="ck-hmw-q" data-hmw>
        {hmw.split(' ').map((w) => <span class:list={['w', { k: hmwKey.has(w) }]}>{w} </span>)}
      </p>
      <p class="ck-insight">People don’t lack the desire for control. They lack a <em>system</em> that makes control <em>effortless</em>.</p>
    </div>

    <div class="ck-block ck-split ck-brief" data-ck-in>
      <div class="ck-shift" data-shift>
        <p class="ck-shift-a"><span>Food being delivered to me</span><i class="ck-strike" data-strike></i></p>
        <svg class="ck-shift-arrow" viewBox="0 0 40 40" aria-hidden="true" data-draw><path d="M20 6v26"></path><path d="M10 23l10 10 10-10"></path></svg>
        <p class="ck-shift-b">My food being <em>made for me</em>.</p>
      </div>
      <div class="ck-recipe">
        <p class="ck-kicker">The recipe</p>
        <p class="ck-recipe-goal">Outsource cooking, without giving up control.</p>
        <ol class="ck-steps">
          {goals.map((g, i) => <li><span>{i + 1}</span>{g}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== 03 the app ===================== -->
  <section class="ck-ch" id="cooked-app" data-phase="app" aria-labelledby="cooked-app-t">
    <header class="ck-chead">
      <p class="ck-course"><span>{no('app')}</span>The app</p>
      <h3 class="ck-ctitle" id="cooked-app-t">Service</h3>
      <img class="ck-chead-art" src={img('logo-c')} alt="" width="377" height="342" loading="lazy" />
    </header>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">Set up once. Skip anytime.</h4>
        <p class="ck-body">Diet, budget and the way you like things cooked are asked once, and every order starts from them. Each step can be skipped.</p>
      </div>
      <div class="ck-phones">
        <Phone src="ui-role" alt="Role choice: consumer or chef" />
        <Phone src="ui-diet" alt="Dietary preference, step 1 of 4" />
        <Phone src="ui-budget" alt="Budget range slider, the last onboarding step" />
      </div>
    </div>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">Book a chef, food first</h4>
        <p class="ck-body">Start from what you want to eat, make it yours, then choose from the home chefs who cook it best. Ten steps from craving to booked.</p>
      </div>
      <ol class="ck-journey">
        {
          journey.map((s, i) => (
            <li>
              <Phone src={s.src} alt={s.alt} />
              <p><span>{String(i + 1).padStart(2, '0')}</span>{s.cap}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">For the chefs: trust is earned up front</h4>
        <p class="ck-body">Chefs verify their ID, declare their hygiene practice and set an hourly price before they can take a booking.</p>
      </div>
      <div class="ck-phones ck-phones-4">
        <Phone src="ui-chef-id" alt="Chef ID verification" />
        <Phone src="ui-chef-hygiene" alt="Chef hygiene declaration checklist" />
        <Phone src="ui-chef-pricing" alt="Chef hourly pricing and minimum booking hours" />
        <Phone src="ui-chef-dash" alt="Chef dashboard with requests, rating and earnings" />
      </div>
    </div>

    {
      proto && (
        <div class="ck-block ck-proto" id="cooked-proto" data-ck-in>
          <div class="ck-bhead">
            <h4 class="ck-h">Try it yourself</h4>
            <p class="ck-body">The clickable Figma prototype: onboarding, browsing chefs and dishes, and a chef’s sign-up.</p>
          </div>
          <Prototype prototype={proto} title="Cooked" kind="Onboarding, browsing chefs and dishes, and a chef’s sign-up" />
        </div>
      )
    }
  </section>

  <!-- ===================== 04 research ===================== -->
  <section class="ck-ch" id="cooked-research" data-phase="research" aria-labelledby="cooked-research-t">
    <header class="ck-chead">
      <p class="ck-course"><span>{no('research')}</span>How we got there: research</p>
      <h3 class="ck-ctitle" id="cooked-research-t">Back to the ingredients</h3>
      <img class="ck-chead-art" src={img('doodles-turmeric')} alt="" width="900" height="900" loading="lazy" />
    </header>

    <ul class="ck-pantry" data-ck-in>
      <li><b>4</b>interviews</li>
      <li><b>11</b>questions</li>
      <li><b>20</b>assumptions</li>
      <li><b>6</b>market reports</li>
    </ul>

    <div class="ck-block" data-ck-in>
      <h4 class="ck-h">What we heard</h4>
      <ul class="ck-quotes">
        {
          quotes.map((x) => (
            <li>
              <q>{x.q}</q>
              <span>{x.by}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">What we assumed</h4>
        <p class="ck-caption"><b>20</b> on the board → <b>5</b> worth testing</p>
      </div>
      <ul class="ck-notes">
        {
          assumptions.map((a) => (
            <li class:list={['ck-note', { 'is-keep': a.keep, 'is-risky': a.risky }]}>
              {a.t}
              {a.risky && <span class="ck-note-tag">risky</span>}
              {a.keep && <span class="ck-tick" aria-label="carried forward">✓</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ck-block" data-ck-in>
      <h4 class="ck-h">What we noticed</h4>
      <ul class="ck-obs">
        <li><img src={img('head-mood')} alt="" width="306" height="306" loading="lazy" />Food follows mood and company</li>
        <li>
          <svg viewBox="0 0 120 120" aria-hidden="true" class="ck-ico"><circle cx="66" cy="62" r="40"></circle><path d="M66 36 V62 L84 74"></path><path d="M8 48 H24 M4 64 H22 M10 80 H26"></path></svg>
          People want control, but give it up for time
        </li>
        <li>
          <svg viewBox="0 0 120 120" aria-hidden="true" class="ck-ico"><path d="M18 60 a42 42 0 0 1 42 -42 c11.8 0 23 4.7 31.4 12.8 L102 41 M102 18 v23 h-23 M102 60 a42 42 0 0 1 -42 42 c-11.8 0 -23 -4.7 -31.4 -12.8 L18 79 M41 79 H18 v23"></path></svg>
          Trust comes from repeat, familiar meals
        </li>
        <li><img src={img('wok')} alt="" width="359" height="359" loading="lazy" />Home recipes are loved most</li>
      </ul>
    </div>

    <div class="ck-block" data-ck-in>
      <div class="ck-persona-card">
        <img class="ck-persona-fig" src={img('seeker')} alt="" width="400" height="400" loading="lazy" />
        <div>
          <p class="ck-kicker">Persona</p>
          <h4 class="ck-persona-name">The Control Seeker</h4>
          <p class="ck-persona-quote">“I want my food to be made my way.”</p>
          <ul class="ck-chips">
            <li>Customises before choosing</li>
            <li>Wants a taste they know</li>
            <li>Checks ingredients &amp; prep</li>
            <li>Wants a look into the kitchen</li>
          </ul>
          <p class="ck-persona-meta">Archetype: Ananya, 32 · Mumbai · long workdays · husband + 1 child · orders in 3–5× a week</p>
        </div>
      </div>
      <CookedPersona />
    </div>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">A weeknight dinner, today</h4>
        <p class="ck-body">Ananya ordering in after work, step by step, mapped from our interviews and her pain points.</p>
      </div>
      <CookedJourney />
    </div>

    <div class="ck-block ck-split" data-ck-in>
      <div>
        <h4 class="ck-h">Not everyone wants the same amount of control</h4>
        <div class="ck-spec">
          <div class="ck-spec-track" aria-hidden="true" data-spec><span></span></div>
          <div class="ck-spec-ends">
            <p><b>Control-seeker</b>ingredients, oil, hygiene</p>
            <p><b>Hands-off</b>just bring me food</p>
          </div>
        </div>
        <p class="ck-big ck-spec-verdict">So control is <em>optional</em>, with levels.</p>
      </div>
      <div>
        <h4 class="ck-h">What they’re hungry for</h4>
        <ol class="ck-needs">
          {needs.map((n, i) => <li><span>{i + 1}</span>{n}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== 05 design ===================== -->
  <section class="ck-ch" id="cooked-design" data-phase="design" aria-labelledby="cooked-design-t">
    <header class="ck-chead">
      <p class="ck-course"><span>{no('design')}</span>How we got there: design</p>
      <h3 class="ck-ctitle" id="cooked-design-t">Working out the recipe</h3>
      <img class="ck-chead-art" src={img('chef')} alt="" width="700" height="700" loading="lazy" />
    </header>

    <div class="ck-block" data-ck-in>
      <div class="ck-bhead">
        <h4 class="ck-h">Three directions</h4>
        <p class="ck-caption"><b>3</b> directions · <b>1</b> made it to the plate</p>
      </div>
      <ul class="ck-dirs">
        {
          directions.map((x) => (
            <li class:list={['ck-dir', { 'is-cut': x.cut, 'is-keep': x.keep }]}>
              <b>{x.t}</b>
              <span>{x.why}</span>
              <span class="ck-dir-v">{x.verdict}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="ck-block" data-ck-in>
      <h4 class="ck-h">Paper first</h4>
      <div class="ck-sketches">
        <img src={img('sketch-1')} alt="Paper sketches of the onboarding and home screens" width="1000" height="1375" loading="lazy" />
        <img src={img('sketch-2')} alt="Paper sketches of browsing, customising and booking screens" width="934" height="1400" loading="lazy" />
        <img src={img('sketch-3')} alt="Paper sketches of the chef-side screens" width="1000" height="1243" loading="lazy" />
      </div>
    </div>

    <div class="ck-block" data-ck-in>
      <h4 class="ck-h">The full user flow</h4>
      <CookedFlow />
    </div>

    <div class="ck-block" data-ck-in>
      <h4 class="ck-h">Wireframes, round one</h4>
      <div class="ck-phones ck-phones-4 ck-wires">
        {
          wires.map((s) => (
            <div class:list={['ck-wire', { 'is-cut': s.cut }]}>
