---
import Phone from './Phone.astro';
import CookedFlow from './CookedFlow.astro';
import CookedKit from './CookedKit.astro';
import { withBase } from '../../../lib/url';
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const img = (n: string) => withBase(`/projects/cooked/${n}.webp`);

// facts shown in the hero; placeholders stay hidden until they're real
const facts = [
  ['Discipline', project.discipline],
  ['Duration', project.duration],
  ['Role', project.role],
  ['Team', project.team],
  ['Tools', project.tools.join(' · ')],
].filter(([, v]) => v && !/TBD/i.test(v));

// the menu: each course is a stage of the double diamond, named for the kitchen
const courses = [
  { key: 'starter', label: 'Starter', stage: 'The problem' },
  { key: 'discover', label: 'Ingredients', stage: 'Discover' },
  { key: 'define', label: 'Recipe', stage: 'Define' },
  { key: 'develop', label: 'Kitchen', stage: 'Develop' },
  { key: 'deliver', label: 'Plating', stage: 'Deliver' },
  { key: 'outcome', label: 'Dessert', stage: 'Outcome' },
];

const quotes = [
  { q: 'Since I’m the one eating it, I should have a say in how it’s made.', by: 'D.' },
  { q: 'Most apps aren’t accommodating of specific requests.', by: 'N.' },
  { q: 'I order online because I have no choice.', by: 'Interview' },
  { q: 'I want someone to cook closer to how it’s made at home.', by: 'N.' },
  { q: 'These apps restrict me.', by: 'Interview' },
  { q: 'When people give out that control, it’s very difficult to come back.', by: 'R.' },
];

const assumptions = [
  { t: 'People feel they lose control when they order food', keep: true },
  { t: 'Trust isn’t a barrier to outsourcing cooking' },
  { t: 'Users would want visibility into the cooking process', risky: true },
  { t: 'Convenience matters, but not at the cost of trust or health', keep: true },
  { t: 'Hiring full-time help is feasible for urban homes' },
  { t: 'People care deeply about ingredients, oil and hygiene', keep: true },
  { t: 'Traditional families will let someone new cook for them', risky: true },
  { t: 'Home-style food beats restaurant-style', keep: true },
  { t: 'People get lost in choices while ordering' },
  { t: 'Existing apps don’t balance convenience with culture', keep: true },
];

// the directions we weighed: two that were cut, one that went forward
const directions = [
  { t: 'Teach them to cook', why: 'A companion app: step-by-step recipes and short videos.', verdict: 'Cut: it still asks a tired person to cook.', cut: true },
  { t: 'Guide the household cook', why: 'Exact instructions on the phone of the cook a family already has.', verdict: 'Cut: it only works where there’s full-time help.', cut: true },
  { t: 'Book a chef, made your way', why: 'A home chef cooks to preferences you set once, dish by dish.', verdict: 'Kept: control without the effort.', keep: true },
];

const hmw = 'How might we give people the same confidence they feel eating home‑cooked food, even when someone else is cooking it?';
const hmwKey = new Set(['same', 'confidence', 'home‑cooked', 'food,', 'someone', 'else']);

const journey = [
  { src: 'ui-home', cap: 'Home', alt: 'Home screen with quick actions to find chefs or search dishes, and a repeat-last-meal list' },
  { src: 'ui-search', cap: 'Pick a dish', alt: 'Search dishes screen with a grid of dishes' },
  { src: 'ui-filter', cap: 'Filter by mood', alt: 'Dish filters: quick picks, cuisine, mood, gourmet' },
  { src: 'ui-customise', cap: 'Make it yours', alt: 'Customise dish: spice level and cooking oil choices' },
  { src: 'ui-chefs', cap: 'Choose a chef', alt: 'Select chefs list with ratings, distance and experience' },
  { src: 'ui-profile', cap: 'Meet the chef', alt: 'Chef profile for Maria, Italian and Mediterranean' },
  { src: 'ui-sent', cap: 'Request sent', alt: 'Request sent, waiting for the chef to confirm' },
  { src: 'ui-confirmed', cap: 'Chef confirmed', alt: 'Chef confirmed with date, time and location' },
  { src: 'ui-summary', cap: 'Review', alt: 'Order summary with customisations and price breakdown' },
  { src: 'ui-success', cap: 'Booked', alt: 'Payment successful with booking details' },
];

---

<article class="ck" data-project="cooked" data-theme="light" data-card-bg="#f4f5f2" aria-labelledby="cooked-title" hidden data-ck>
  <svg class="ck-line" aria-hidden="true" data-ck-line><path class="ck-line-path"></path><circle class="ck-line-halo" r="11"></circle><circle class="ck-line-tip" r="5"></circle></svg>

  <!-- ===================== hero ===================== -->
  <header class="ck-hero" data-pc-rise data-ck-pt="0.5">
    <img class="ck-hero-frame" src={img('doodle-frame')} alt="" width="1652" height="952" loading="lazy" data-ck-preload />
    <div class="ck-hero-inner">
      <p class="ck-kicker">A UX/UI case study</p>
      <h2 class="ck-wordmark" id="cooked-title"><img src={img('wordmark')} alt="Cooked!" width="1600" height="347" loading="lazy" data-ck-preload /></h2>
      <p class="ck-tag">Your food, your way</p>
      <p class="ck-lede">An app that lets people outsource cooking, without giving up control of their food.</p>
      <dl class="ck-facts">
        {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
    </div>
    <p class="ck-cue" aria-hidden="true"><span class="ck-cue-dot"></span>Scroll to start cooking</p>
  </header>

  <!-- the menu: floats at the foot of the card, marks the course you're in -->
  <div class="ck-dock-wrap" data-ck-dock>
    <nav class="ck-dock" aria-label="Case study courses">
      <ol>
        {
          courses.map((c) => (
            <li>
              <a href={`#cooked-${c.key}`} data-phase-link={c.key}>
                <span class="ck-dock-tag">
                  <span class="ck-dock-label">{c.label}</span>
                  <span class="ck-dock-stage">{c.stage}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <!-- ===================== starter: the problem ===================== -->
  <section class="ck-ch" id="cooked-starter" data-phase="starter" aria-label="Starter: the problem">
    <div class="ck-scene" style="--len: 3.2" data-scene="imagine" data-ck-rail>
      <div class="ck-stage">
        <p class="ck-beat ck-beat-1" data-b1>Ordering in is easy.</p>
        <p class="ck-beat ck-beat-2" data-b2>Knowing how it’s made isn’t.<br /><span>Oil, spice, hygiene: you don’t get a say.</span></p>
        <div class="ck-beat ck-beat-3" data-b3>
          <p>Convenience wins. You give up&nbsp;<em data-control>control.</em></p>
        </div>
        <div class="ck-seesaw" data-seesaw>
          <svg viewBox="0 0 800 420" role="img" aria-label="A seesaw: convenience outweighs control">
            <g data-beam>
              <rect x="90" y="252" width="620" height="16" rx="8" class="ss-beam"></rect>
              <rect x="128" y="226" width="18" height="30" rx="4" class="ss-post"></rect>
              <rect x="654" y="226" width="18" height="30" rx="4" class="ss-post"></rect>
            </g>
            <path d="M400 268 L478 380 L322 380 Z" class="ss-pivot"></path>
            <rect x="290" y="380" width="220" height="14" rx="4" class="ss-base"></rect>
            <g data-ss-left>
              <text x="137" y="196" class="ss-big">Convenience</text>
              <text x="137" y="222" class="ss-small">quick · easy · no thinking</text>
            </g>
            <g data-ss-right>
              <text x="663" y="196" class="ss-big ss-green">Control</text>
              <text x="663" y="222" class="ss-small">what home cooking gives you</text>
            </g>
          </svg>
        </div>
      </div>
    </div>

    <div class="ck-block ck-who" data-ck-pt="0.86">
      <h3 class="ck-h" data-a="up">Who’s at the table</h3>
      <div class="ck-who-row">
        <figure data-a="pop"><img src={img("pro")} alt="" width="400" height="420" loading="lazy" /><figcaption>Working professionals</figcaption></figure>
        <figure data-a="pop"><img src={img("parent")} alt="" width="400" height="417" loading="lazy" /><figcaption>Parents</figcaption></figure>
      </div>
    </div>
  </section>

  <!-- ===================== 01 discover ===================== -->
  <section class="ck-ch" id="cooked-discover" data-phase="discover" aria-labelledby="cooked-discover-t">
    <header class="ck-chead" data-ck-pt="0.14">
      <p class="ck-course" data-a="up"><span>01</span>Discover</p>
      <h3 class="ck-ctitle" id="cooked-discover-t" data-a="up">Gathering the<br />ingredients</h3>
      <img class="ck-chead-art" src={img('doodles-turmeric')} alt="" width="900" height="900" loading="lazy" data-a="spin" />
    </header>

    <ul class="ck-pantry" data-ck-pt="0.9">
      <li data-a="up"><b data-count="4">4</b>interviews</li>
      <li data-a="up"><b data-count="11">11</b>questions</li>
      <li data-a="up"><b data-count="20">20</b>assumptions</li>
      <li data-a="up"><b data-count="6">6</b>market reports</li>
    </ul>

    <div class="ck-block ck-stats" data-ck-pt="0.1">
      <h3 class="ck-h" data-a="up">The numbers</h3>
      <ul class="ck-stat-list">
        <li data-a="up"><b><span data-count="90" data-prefix="80–">80–90</span>%</b><span class="ck-bar"><i style="--to: 0.9" data-a="fill"></i></span>default to convenience-first</li>
        <li data-a="up"><b><span data-count="70">70</span>%</b><span class="ck-bar"><i style="--to: 0.7" data-a="fill"></i></span>want more control</li>
        <li data-a="up"><b><span data-count="60">60</span>%+</b><span class="ck-bar"><i style="--to: 0.6" data-a="fill"></i></span>compromise on food quality when ordering</li>
      </ul>
      <div class="ck-market" data-a="up">
        <svg viewBox="0 0 420 200" aria-hidden="true" data-a="draw">
          <path d="M10 186 C 120 180, 200 168, 270 140 S 370 70, 410 12" class="ck-curve"></path>
          <circle cx="410" cy="12" r="6" class="ck-curve-dot"></circle>
        </svg>
        <p><b>$55.58B</b>India’s food delivery market, still climbing<br /><small>2024 → 2034 · IMARC, Nexdigm</small></p>
      </div>
      <img class="ck-stats-icons" src={img('food-icons')} alt="" width="700" height="700" loading="lazy" data-a="par" data-speed="60" />
      <p class="ck-source">NielsenIQ · IMARC · Kadence · Market Xcel · Expert Market Research · IBEF</p>
    </div>

    <div class="ck-block ck-heard" data-ck-pt="0.1" data-heard>
      <h3 class="ck-h">What we heard</h3>
      <div class="ck-heard-row">
        <img class="ck-heard-fig" src={img('seeker')} alt="" width="400" height="400" loading="lazy" />
        <ul class="ck-quotes">
          {
            quotes.map((x, i) => (
              <li class="ck-quote" style={`--r: ${[-2.5, 1.8, -1.2, 2.4, -1.8, 1.2][i]}deg`}>
                <q>{x.q}</q>
                <span>{x.by}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="ck-scene" style="--len: 1.4" data-scene="assumptions" data-ck-rail>
      <div class="ck-stage ck-assume">
        <h3 class="ck-h">What we assumed</h3>
        <ul class="ck-notes">
          {
            assumptions.map((a) => (
              <li class:list={['ck-note', { 'is-risky': a.risky, 'is-keep': a.keep }]} data-note data-keep={a.keep ? '' : undefined}>
                {a.t}
                {a.risky && <span class="ck-note-tag">risky</span>}
                {a.keep && <span class="ck-tick" aria-label="carried forward" data-tick>✓</span>}
              </li>
            ))
          }
        </ul>
        <p class="ck-caption" data-assume-cap><b>20</b> on the board → <b>5</b> worth testing</p>
      </div>
    </div>

    <div class="ck-block" data-ck-pt="0.88">
      <h3 class="ck-h" data-a="up">What we noticed</h3>
      <ul class="ck-obs">
        <li data-a="pop"><img src={img('head-mood')} alt="" width="306" height="306" loading="lazy" />Food follows mood and company</li>
        <li data-a="pop">
          <svg viewBox="0 0 120 120" aria-hidden="true" class="ck-ico"><circle cx="66" cy="62" r="40"></circle><path d="M66 36 V62 L84 74"></path><path d="M8 48 H24 M4 64 H22 M10 80 H26"></path></svg>
          People want control, but give it up for time
        </li>
        <li data-a="pop">
          <svg viewBox="0 0 120 120" aria-hidden="true" class="ck-ico"><path d="M18 60 a42 42 0 0 1 42 -42 c11.8 0 23 4.7 31.4 12.8 L102 41 M102 18 v23 h-23 M102 60 a42 42 0 0 1 -42 42 c-11.8 0 -23 -4.7 -31.4 -12.8 L18 79 M41 79 H18 v23"></path></svg>
          Trust comes from repeat, familiar meals
        </li>
        <li data-a="pop"><img src={img('wok')} alt="" width="359" height="359" loading="lazy" />Home recipes are loved most</li>
      </ul>
    </div>
  </section>

  <!-- ===================== 02 define ===================== -->
  <section class="ck-ch" id="cooked-define" data-phase="define" aria-labelledby="cooked-define-t">
    <header class="ck-chead" data-ck-pt="0.86">
      <p class="ck-course" data-a="up"><span>02</span>Define</p>
      <h3 class="ck-ctitle" id="cooked-define-t" data-a="up">Writing the<br />recipe</h3>
      <img class="ck-chead-art" src={img('doodles-green')} alt="" width="900" height="900" loading="lazy" data-a="spin" />
    </header>

    <div class="ck-block ck-persona" data-ck-pt="0.12">
      <div class="ck-persona-card" data-a="up">
        <img class="ck-persona-fig" src={img('seeker')} alt="" width="400" height="400" loading="lazy" />
        <div>
          <p class="ck-kicker">Persona</p>
          <h4 class="ck-persona-name">The Control Seeker</h4>
          <p class="ck-persona-quote">“I want my food to be made my way.”</p>
          <ul class="ck-chips" data-a="stagger">
            <li>Customises before choosing</li>
            <li>Wants a taste they know</li>
            <li>Checks ingredients &amp; prep</li>
            <li>Wants a look into the kitchen</li>
          </ul>
          <p class="ck-persona-meta">Archetype: Ananya, 32 · Mumbai · long workdays · husband + 1 child · orders in 3–5× a week</p>
        </div>
      </div>
    </div>

    <div class="ck-scene" style="--len: 2" data-scene="spectrum" data-ck-rail>
      <div class="ck-stage ck-spec">
        <h3 class="ck-h">Not everyone wants the same amount of control</h3>
        <div class="ck-spec-track" data-spec-track>
          <span class="ck-spec-fill" data-spec-fill></span>
          <span class="ck-spec-knob" data-spec-knob></span>
        </div>
        <div class="ck-spec-ends">
          <p><b>Control-seeker</b>ingredients, oil, hygiene</p>
          <p><b>Hands-off</b>just bring me food</p>
        </div>
        <p class="ck-spec-verdict" data-spec-verdict>So control is <em>optional</em>, with levels.</p>
      </div>
    </div>

    <div class="ck-block" data-ck-pt="0.88">
      <h3 class="ck-h" data-a="up">What they’re hungry for</h3>
      <ol class="ck-needs">
        <li data-a="pop"><span>1</span>Home-like comfort</li>
        <li data-a="pop"><span>2</span>To know, without being too involved</li>
        <li data-a="pop"><span>3</span>Trust &amp; safety</li>
        <li data-a="pop"><span>4</span>Guilt-free eating</li>
      </ol>
    </div>

    <div class="ck-scene" style="--len: 1.35" data-scene="hmw" data-ck-rail>
      <div class="ck-stage ck-hmw">
        <p class="ck-kicker">How might we</p>
        <p class="ck-hmw-q" aria-label={hmw}>
          {hmw.split(' ').map((w) => <span class:list={['w', { k: hmwKey.has(w) }]} aria-hidden="true">{w} </span>)}
        </p>
        <p class="ck-insight" data-insight>People don’t lack the desire for control. They lack a <em>system</em> that makes control <em>effortless</em>.</p>
      </div>
    </div>

    <div class="ck-scene" style="--len: 1.9" data-scene="shift" data-ck-rail>
      <div class="ck-stage ck-shift">
        <p class="ck-shift-a" data-shift-a>Food being delivered to me<span class="ck-strike" data-strike></span></p>
        <svg class="ck-shift-arrow" viewBox="0 0 300 160" aria-hidden="true">
          <path d="M20 20 C 30 120, 160 150, 270 110" data-arrow></path>
          <path d="M240 92 L272 110 L246 136" data-arrow-head></path>
        </svg>
        <p class="ck-shift-b" data-shift-b>My food being <em>made for me</em>.</p>
      </div>
    </div>

    <div class="ck-block ck-recipe-wrap" data-ck-pt="0.12">
      <div class="ck-recipe" data-a="up">
        <p class="ck-kicker">The recipe</p>
        <p class="ck-recipe-goal">Outsource cooking, without giving up control.</p>
        <ol class="ck-steps" data-a="stagger">
          <li><span class="ck-box"></span>Shift control to the chef</li>
          <li><span class="ck-box"></span>Make control feel natural, not effortful</li>
          <li><span class="ck-box"></span>Build trust through human connection</li>
          <li><span class="ck-box"></span>Give control without complexity</li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ===================== 03 develop ===================== -->
  <section class="ck-ch" id="cooked-develop" data-phase="develop" aria-labelledby="cooked-develop-t">
    <header class="ck-chead" data-ck-pt="0.14">
      <p class="ck-course" data-a="up"><span>03</span>Develop</p>
      <h3 class="ck-ctitle" id="cooked-develop-t" data-a="up">Testing in<br />the kitchen</h3>
      <img class="ck-chead-art ck-chead-wok" src={img('chef')} alt="" width="700" height="700" loading="lazy" data-a="spin" />
    </header>

    <div class="ck-scene" style="--len: 1.5" data-scene="ideas" data-ck-rail>
      <div class="ck-stage ck-ideas">
        <h3 class="ck-h">Three directions</h3>
        <ul class="ck-wall ck-dirs">
          {
            directions.map((x, i) => (
              <li class:list={['ck-idea', { 'is-cut': x.cut, 'is-keep': x.keep }]} data-idea style={`--r: ${[-1.5, 1, -0.5][i]}deg`}>
                <b class="ck-dir-t">{x.t}</b>
                <span class="ck-dir-why">{x.why}</span>
                <span class="ck-dir-v">{x.verdict}</span>
                {x.cut && <span class="ck-idea-x" data-cut />}
                {x.keep && <span class="ck-idea-tag" data-keep-tag>→ Built</span>}
              </li>
            ))
          }
        </ul>
        <p class="ck-caption" data-ideas-cap><b>3</b> directions · <b>1</b> made it to the plate</p>
      </div>
    </div>

    <div class="ck-block" data-ck-pt="0.86">
      <h3 class="ck-h" data-a="up">Paper first</h3>
      <div class="ck-sketches">
        <img src={img('sketch-1')} alt="Paper sketches of the onboarding and home screens" width="1000" height="1375" loading="lazy" data-a="left" />
        <img src={img('sketch-2')} alt="Paper sketches of browsing, customising and booking screens" width="934" height="1400" loading="lazy" data-a="up" />
        <img src={img('sketch-3')} alt="Paper sketches of the chef-side screens" width="1000" height="1243" loading="lazy" data-a="right" />
      </div>
    </div>

    <div class="ck-block ck-flow-wrap" data-ck-pt="0.1">
      <h3 class="ck-h" data-a="up">The full user flow</h3>
      <div data-a="up"><CookedFlow /></div>
    </div>

    <div class="ck-block" data-ck-pt="0.9">
      <h3 class="ck-h" data-a="up">Wireframes, round one</h3>
      <div class="ck-wires" data-a="stagger">
        {
          [
            { src: 'ui-wf2-onboarding', cap: 'Diet', alt: 'Mid-fi wireframe: dietary preference step' },
            { src: 'ui-wf2-home', cap: 'Home', alt: 'Mid-fi wireframe: home with quick actions and previous orders, shown with its layout grid', grid: true },
            { src: 'ui-wf2-avoid', cap: 'What to avoid', alt: 'Mid-fi wireframe: what to avoid step, later cut', cut: true },
            { src: 'ui-wf2-cuisine', cap: 'Cuisine', alt: 'Mid-fi wireframe: select cuisine' },
          ].map((s) => (
            <div class:list={['ck-wire', { 'is-cut': s.cut }]}>
              <Phone src={s.src} alt={s.alt} w={390} h={844} grid={s.grid} />
              <p>
                {s.cap}
                {s.cut && <span class="ck-cut-tag">Cut in testing</span>}
              </p>
            </div>
          ))
        }
      </div>
      <p class="ck-grid-note" data-a="up">
        <span class="ck-grid-swatch" aria-hidden="true"></span>Home’s layout grid: 4 columns · 24 px margins · 20 px gutters · 48 px top &amp; bottom
      </p>
    </div>

    <div class="ck-scene" style="--len: 1.4" data-scene="pivot" data-ck-rail>
      <div class="ck-stage ck-pivot">
        <p class="ck-kicker">The taste test</p>
        <h3 class="ck-h">Feedback flipped the menu</h3>
        <div class="ck-pivot-row">
          <div class="ck-pivot-card" data-pivot-a>
            <p class="ck-pivot-label">Chef-first</p>
            <p class="ck-pivot-q">“Which chef?”</p>
            <p>Pick a chef → then a dish</p>
            <span class="ck-strike" data-pivot-strike></span>
          </div>
          <div class="ck-toggle" aria-hidden="true"><span data-toggle-knob></span></div>
          <div class="ck-pivot-card" data-pivot-b>
            <p class="ck-pivot-label">Food-first</p>
            <p class="ck-pivot-q">“What do I want to eat?”</p>
            <p>Pick a dish → see chefs who specialise in it</p>
          </div>
        </div>
        <ul class="ck-chips ck-pivot-chips">
          <li data-pivot-chip>Hourly pricing, 1–1.5 h minimum</li>
          <li data-pivot-chip>Basic · Expert · Gourmet cooks</li>
          <li data-pivot-chip>Pure-veg cook filter</li>
          <li data-pivot-chip>Fewer onboarding steps</li>
          <li data-pivot-chip>Visible ID &amp; hygiene checks</li>
          <li data-pivot-chip>“What to avoid” cut as redundant</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== 04 deliver ===================== -->
  <section class="ck-ch" id="cooked-deliver" data-phase="deliver" aria-labelledby="cooked-deliver-t">
    <header class="ck-chead" data-ck-pt="0.86">
      <p class="ck-course" data-a="up"><span>04</span>Deliver</p>
      <h3 class="ck-ctitle" id="cooked-deliver-t" data-a="up">Plating up</h3>
      <img class="ck-chead-art" src={img('logo-c')} alt="" width="377" height="342" loading="lazy" data-a="spin" />
    </header>

