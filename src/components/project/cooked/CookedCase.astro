    top: 0;
    z-index: 30 !important;
    height: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease-out;
  }
  .ck-dock-wrap:global(.is-on) {
    opacity: 1;
  }
  .ck-dock {
    position: absolute;
    right: clamp(10px, 1.6vw, 22px);
    top: calc((100svh - var(--pm-inset, 20px) * 2) / 2);
    translate: 0 -50%;
  }
  .ck-dock-wrap:global(.is-on) .ck-dock {
    pointer-events: auto;
  }
  /* one panel: six even rows, names in one left-aligned column, dots in one line on the right.
     It rests folded to its dots; at each new course a pill beside it names just that course, and
     on hover or focus the panel names them all */
  .ck-dock ol {
    position: relative;
    display: grid;
    gap: 0;
  }
  /* liquid glass, as in Apple's Control Center: the page blurs and saturates behind it, a bright
     rim catches light along the top edge, a sheen falls across it, and it sits on a soft shadow */
  .ck-dock ol::before {
    content: '';
    position: absolute;
    inset: -7px -9px;
    border-radius: 18px;
    corner-shape: round;
    background:
      linear-gradient(150deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.12) 42%, rgb(255 255 255 / 0.04) 60%, rgb(255 255 255 / 0.22)),
      rgb(244 245 242 / 0.32);
    -webkit-backdrop-filter: blur(14px) saturate(1.8);
    backdrop-filter: blur(14px) saturate(1.8);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 0.95),
      inset 0 0 0 1px rgb(255 255 255 / 0.55),
      inset 0 -1px 1px rgb(20 23 26 / 0.06),
      0 0 0 0.5px rgb(20 23 26 / 0.14),
      0 14px 32px -14px rgb(20 23 26 / 0.35);
  }
  .ck-dock a {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 30px;
    padding: 0 2px;
    color: var(--ck-ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  /* the dot: small and quiet; the current course grows into a green pill */
  .ck-dock a::after {
    content: '';
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 99px;
    corner-shape: round;
    background: rgb(20 23 26 / 0.22);
    transition:
      height 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease-out;
  }
  .ck-dock a:global(.is-active)::after {
    height: 20px;
    background: var(--ck-green);
  }
  .ck-dock-tag {
    display: block;
    max-width: 0;
    margin: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      margin 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.25s ease-out;
  }
  /* hovering the panel, or focusing into it, names every course */
  .ck-dock:hover .ck-dock-tag,
  .ck-dock:focus-within .ck-dock-tag {
    max-width: 120px;
    margin: 0 14px 0 4px;
    opacity: 1;
  }
  /* at a new course, its name alone: a separate glass pill beside its dot, the size of the word.
