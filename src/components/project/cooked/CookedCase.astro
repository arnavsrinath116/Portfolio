  /* ---------- course rail: a slim column of dots on the card's right edge ---------- */
  /* the wrapper sticks to the top of the card's scroll; the rail hangs off it, mid-height */
  .ck-dock-wrap {
    position: sticky;
    top: 0;
    z-index: 30 !important;
    height: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease-out;
  }
  .ck-dock-wrap:global(.is-on) {
    opacity: 1;
  }
  .ck-dock {
    position: absolute;
    right: clamp(10px, 1.6vw, 22px);
    top: calc(var(--stage-h) / 2);
    translate: 0 -50%;
  }
  .ck-dock-wrap:global(.is-on) .ck-dock {
    pointer-events: auto;
  }
  .ck-dock ol {
    position: relative;
    display: grid;
    justify-items: end;
    gap: 2px;
  }
  /* a faint capsule behind the dots, so they read over photos and screens */
  .ck-dock ol::before {
    content: '';
    position: absolute;
    top: -6px;
    bottom: -6px;
    right: -6px;
    width: 20px;
    border-radius: 99px;
    background: rgb(255 255 255 / 0.78);
    box-shadow: 0 0 0 1px var(--ck-rule);
  }
  .ck-dock a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 0 6px 10px;
    color: var(--ck-ink-2);
    text-decoration: none;
    white-space: nowrap;
  }
  /* the dot: small and quiet; the current course grows into a green pill */
  .ck-dock a::after {
    content: '';
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 99px;
    background: rgb(20 23 26 / 0.22);
    transition:
      height 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s ease-out;
  }
  .ck-dock a:global(.is-active)::after {
    height: 26px;
    background: var(--ck-green);
  }
  /* names appear only on hover or keyboard focus: the rail never sits over the content */
  .ck-dock-tag {
    display: grid;
    justify-items: end;
    padding: 5px 10px;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 0 0 1px var(--ck-rule), 0 10px 22px -14px rgb(20 23 26 / 0.45);
    opacity: 0;
    translate: 6px 0;
    transition:
      opacity 0.25s ease-out,
      translate 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ck-dock a:hover .ck-dock-tag,
  .ck-dock a:focus-visible .ck-dock-tag {
    opacity: 1;
    translate: 0 0;
  }
  .ck-dock-label {
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--ck-ink);
  }
  .ck-dock-stage {
    font-size: 0.6875rem;
    color: var(--ck-ink-3);
  }

  /* ---------- starter: imagine + seesaw ---------- */
  .ck-beat {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    padding: 0 var(--ck-pad);
