<style>
  /* ---------- the Cooked world: light, warm, illustrated ---------- */
  .ck {
    --ck-bg: #f4f5f2;
    --ck-ink: #14171a;
    --ck-ink-2: rgb(20 23 26 / 0.72);
    --ck-ink-3: rgb(20 23 26 / 0.62);
