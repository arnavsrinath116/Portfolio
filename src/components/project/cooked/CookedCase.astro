  /* resets carry no weight (:where), so every component's own margins still apply */
  :where(.ck) :where(h2, h3, h4, p, ul, ol, dl, dd, figure) {
    margin: 0;
  }
  :where(.ck) :where(ul, ol) {
    padding: 0;
    list-style: none;
  }
  .ck em {
    font-style: normal;
    color: var(--ck-green);
  }

  /* ---------- green line ---------- */
  .ck-line {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }
  .ck-line-path {
    fill: none;
    stroke: var(--ck-green);
    stroke-width: 2.5;
    stroke-linecap: round;
  }
  .ck-line-tip {
    fill: var(--ck-green);
  }
  .ck-line-halo {
    fill: var(--ck-green-soft);
  }
  /* content sits above the line, so it weaves behind cards and phones */
  .ck-hero,
  .ck-ch {
    position: relative;
    z-index: 1;
  }

  /* ---------- shared type ---------- */
  .ck-kicker {
    font-size: 0.8125rem;
