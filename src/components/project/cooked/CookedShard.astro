---
/**
 * A piece pulled out of a Cooked screen, set beside the research it answers:
 * live HTML in the app's own styling (not a phone mockup), tilted a little
 * as if lifted off the screen. Kinds:
 * - repeat: Home's "Repeat last meal" list
 * - customise: the dish screen's spice and oil pickers (they respond)
 * - chef: a card from Select chefs
 * - hygiene: three lines of the chef's hygiene declaration
 */
import { withBase } from '../../../lib/url';

interface Props {
  kind: 'repeat' | 'customise' | 'chef' | 'hygiene';
  /** where in the app it comes from, shown above it */
  from: string;
  /** tilt in degrees */
  tilt?: number;
}
const { kind, from, tilt = 0 } = Astro.props;
const img = (n: string) => withBase(`/projects/cooked/${n}.webp`);

const meals = [
  { src: 'shard-carbonara', t: 'Italian Pasta Carbonara', chef: 'Chef Maria Rodriguez', d: 'March 15, 2026', p: '$75' },
  { src: 'shard-salmon', t: 'Grilled Salmon', chef: 'Chef James Chen', d: 'March 10, 2026', p: '$95' },
];
const spice = ['Mild', 'Medium', 'Hot', 'Extra Hot'];
const oils = ['Olive Oil', 'Vegetable Oil', 'Coconut Oil', 'Avocado Oil'];
const declare = ['I maintain proper food safety and handling practices', 'I have completed food safety training or certification', 'I follow proper kitchen hygiene standards'];
---

<figure class:list={['sh', `is-${kind}`]} style={`--tilt:${tilt}deg`}>
  <figcaption class="sh-from">From the app · {from}</figcaption>
  <div class="sh-card">
    {
      kind === 'repeat' && (
        <>
          <p class="sh-head">
            <b>Repeat Last Meal</b>
            <u>View All</u>
          </p>
          <ul class="sh-meals">
            {meals.map((m) => (
              <li>
                <img src={img(m.src)} alt="" width="54" height="54" loading="lazy" />
                <span>
                  <b>{m.t}</b>
                  <small>{m.chef}</small>
                  <small>{m.d}</small>
                </span>
                <b class="sh-price">{m.p}</b>
              </li>
            ))}
          </ul>
        </>
      )
    }
    {
      kind === 'customise' && (
        <div data-shard-pick>
          <p class="sh-label">Spice Level</p>
          <div class="sh-opts sh-opts-4" role="radiogroup" aria-label="Spice level">
            {spice.map((s, i) => (
              <button type="button" role="radio" class:list={['sh-opt', { 'is-on': i === 1 }]} aria-checked={i === 1 ? 'true' : 'false'} tabindex="-1">
                {s}
              </button>
            ))}
          </div>
          <p class="sh-label">Cooking Oil</p>
          <div class="sh-opts sh-opts-2" role="radiogroup" aria-label="Cooking oil">
            {oils.map((s, i) => (
              <button type="button" role="radio" class:list={['sh-opt', { 'is-on': i === 0 }]} aria-checked={i === 0 ? 'true' : 'false'} tabindex="-1">
                {s}
              </button>
            ))}
          </div>
        </div>
      )
    }
    {
      kind === 'chef' && (
        <div class="sh-chef">
          <img src={img('shard-maria')} alt="" width="64" height="64" loading="lazy" />
          <span>
            <b>Maria Rodriguez</b>
            <small>Italian &amp; Mediterranean</small>
            <span class="sh-chef-meta">
              <span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" />
                </svg>
                4.9 <i>(127)</i>
              </span>
              <span>2.5 km</span>
              <span>8 years</span>
            </span>
          </span>
        </div>
      )
    }
    {
      kind === 'hygiene' && (
        <>
          <p class="sh-caps">I declare the following</p>
          <ul class="sh-declare">
            {declare.map((d) => (
              <li>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="m8 12.3 2.7 2.7L16.3 9" />
                </svg>
                {d}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</figure>

<script>
  // the pickers work like the app's: one choice per row
  document.querySelectorAll<HTMLElement>('[data-shard-pick] [role="radiogroup"]').forEach((g) => {
    const opts = Array.from(g.querySelectorAll<HTMLButtonElement>('.sh-opt'));
    opts.forEach((o) =>
      o.addEventListener('click', () =>
        opts.forEach((x) => {
          x.classList.toggle('is-on', x === o);
          x.setAttribute('aria-checked', String(x === o));
        }),
      ),
    );
  });
</script>

<style>
  .sh {
    --sh-green: #2e7140;
    --sh-ink: #1a1a1a;
    --sh-grey: #6b6f76;
    --sh-line: #e2e3e6;
    margin: 0;
    width: var(--sh-w, 330px);
    max-width: 100%;
    transform: rotate(var(--tilt));
  }
  .sh-from {
    margin: 0 0 10px 6px;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ck-green);
  }
  .sh-card {
    padding: 18px;
    border-radius: 22px;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--ck-rule),
      0 28px 50px -28px rgb(20 23 26 / 0.45);
    color: var(--sh-ink);
  }

  /* repeat last meal */
  .sh-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .sh-head b {
    font-size: 1rem;
    font-weight: 700;
    color: #3d4452;
  }
  .sh-head u {
    font-size: 0.75rem;
    font-weight: 600;
    text-underline-offset: 3px;
  }
  .sh-meals {
    display: grid;
    gap: 10px;
  }
  .sh-meals li {
    display: grid;
    grid-template-columns: 54px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1.5px var(--sh-line);
  }
  .sh-meals img {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    object-fit: cover;
  }
  .sh-meals span {
    display: grid;
    line-height: 1.3;
  }
  .sh-meals b {
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .sh-meals small {
    font-size: 0.75rem;
    color: var(--sh-grey);
  }
  .sh-price {
    align-self: start;
  }

  /* spice and oil */
  .sh-label {
    margin: 0 0 10px;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .sh-label:not(:first-child) {
    margin-top: 18px;
  }
  .sh-opts {
    display: grid;
    gap: 8px;
  }
  .sh-opts-4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .sh-opts-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .sh-opt {
    padding: 11px 6px;
    border: 0;
    border-radius: 12px;
    background: #fff;
    box-shadow: inset 0 0 0 1.5px var(--sh-line);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.2;
    color: var(--sh-ink);
    cursor: pointer;
    transition:
      box-shadow 0.25s ease-out,
      color 0.25s ease-out,
      transform 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .sh-opt:active {
    transform: scale(0.96);
  }
  .sh-opt:global(.is-on) {
    box-shadow:
      inset 0 0 0 2px var(--sh-green),
      0 6px 14px -10px rgb(46 113 64 / 0.7);
    color: var(--sh-green);
  }

  /* chef card */
  .sh-chef {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    align-items: center;
    gap: 16px;
  }
  .sh-chef > img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }
  .sh-chef > span {
    display: grid;
    gap: 2px;
  }
  .sh-chef b {
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .sh-chef small {
    font-size: 0.8125rem;
    color: var(--sh-grey);
  }
  .sh-chef-meta {
    display: flex;
    gap: 14px;
    margin-top: 6px;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .sh-chef-meta span {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .sh-chef-meta span + span {
    font-weight: 500;
    color: var(--sh-grey);
  }
  .sh-chef-meta i {
    font-style: normal;
    font-weight: 500;
    color: var(--sh-grey);
  }
  .sh-chef-meta svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linejoin: round;
  }

  /* hygiene declaration */
  .sh-caps {
    margin: 0 0 12px 2px;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d4452;
  }
  .sh-declare {
    display: grid;
    gap: 8px;
  }
  .sh-declare li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 10px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #f0f0f1;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: #2b2f36;
  }
  .sh-declare svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: var(--sh-ink);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
