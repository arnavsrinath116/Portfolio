    <div class="bb-block" data-bb-in>
      <figure class="bb-team">
        <img src={img('team')} alt="Team BlackBox: Ramanik, Arnav and Srishti" width="1800" height="1013" loading="lazy" decoding="async" />
        <figcaption>
          <b>Team BlackBox</b>
          <span>Ramanik, Arnav and Srishti. The film and the deck were my teammates’ work; the code, the wiring and the box were mine.</span>
        </figcaption>
