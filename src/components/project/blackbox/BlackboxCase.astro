                <g transform={`translate(${h.dx} ${BY})`}>
                  <g clip-path={`url(#${h.clip})`} style={`--a:${h.a};--b:${h.a + 0.32}`}>
                    {bandOutline.map((d) => (
                      <>
                        <path class="bb-cut-base" d={d} />
