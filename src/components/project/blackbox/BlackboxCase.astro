</article>

<script>
  const card = document.querySelector<HTMLElement>('[data-bb]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---------------- the film: stops when the card closes or switches ----------------
  const film = card?.querySelector<HTMLVideoElement>('[data-bb-film]');
  if (card && film) {
    document.addEventListener('pm:shown', (e) => {
      if ((e as CustomEvent).detail?.slug !== card.dataset.project) film.pause();
    });
    document.addEventListener('pm:hidden', () => film.pause());
  }

  // ---------------- the rail: on once the hero has gone, names each new chapter briefly ----------------
  const wrap = card?.querySelector<HTMLElement>('[data-bb-rail]');
  const strip = wrap?.querySelector<HTMLElement>('.bb-rail');
  const now = strip?.querySelector<HTMLElement>('[data-bb-rail-now]');
  const hero = card?.querySelector<HTMLElement>('.bb-hero');
  if (card && wrap && strip && now && hero) {
    let sc: HTMLElement | null = null;
    let last = '';
    let quiet = 0;
    const hush = () => {
      clearTimeout(quiet);
      quiet = window.setTimeout(() => strip.classList.remove('is-telling'), 450);
    };
    const onScroll = () => {
      if (!sc) return;
      if (strip.classList.contains('is-telling')) hush();
      wrap.classList.toggle('is-on', hero.getBoundingClientRect().bottom < sc.getBoundingClientRect().top + sc.clientHeight * 0.45);
    };
    new MutationObserver(() => {
      const a = strip.querySelector<HTMLElement>('a.is-active');
      if (!a) return;
      const label = a.querySelector<HTMLElement>('.bb-rail-name');
      const n = label?.querySelector('.bb-rail-no')?.textContent ?? '';
      const name = `${n} ${(label?.textContent ?? '').slice(n.length)}`.replace(/\s+/g, ' ').trim();
      if (name === last) return;
      last = name;
      now.textContent = name;
      strip.style.setProperty('--now-y', `${a.offsetTop + a.offsetHeight / 2}px`);
      strip.classList.add('is-telling');
      hush();
    }).observe(strip, { subtree: true, attributes: true, attributeFilter: ['class'] });
    document.addEventListener('pm:shown', (e) => {
      const d = (e as CustomEvent).detail;
      sc?.removeEventListener('scroll', onScroll);
      sc = d?.slug === card.dataset.project ? (d.scroller as HTMLElement) : null;
      sc?.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    });
    document.addEventListener('pm:hidden', () => {
      sc?.removeEventListener('scroll', onScroll);
      sc = null;
      wrap.classList.remove('is-on');
    });
  }

  // ---------------- the two boxes ----------------
  // the logic is finalcodeciid.py's, line for line: three modes, a bounded dial (0–2), a press that
  // switches to messages, a double tap that sends "c", an incoming note that buzzes for a second,
  // shows its icon and waits for a single tap, which sends "t". The serial monitor prints what the
  // code prints.
  const sim = card?.querySelector<HTMLElement>('[data-bb-sim]');
  if (sim) {
    const ICONS = JSON.parse(sim.dataset.icons!) as Record<string, string>;
    const FRIENDS = ['icon_sword', 'icon_robot', 'icon_cat'];
    const MESSAGES = ['q_message1', 'icon_coffee', 'q_message3'];
    const ICON_MAP: Record<string, string> = { c: 'icon_coffee', t: 'reply_ok' };
    const NAMES: Record<string, string> = {
      icon_sword: 'a sword',
      icon_robot: 'a robot',
      icon_cat: 'a cat',
      q_message1: 'message one',
      icon_coffee: 'a coffee cup',
      q_message3: 'message three',
      reply_ok: 'a thumbs up',
    };
    const SELECTION = 0;
    const MESSAGE = 1;
    const REPLY = 2;
    const log = sim.querySelector<HTMLOListElement>('[data-log]')!;
    const signal = sim.querySelector<HTMLElement>('[data-signal]')!;
    const steps = Array.from(sim.querySelectorAll<HTMLElement>('[data-step]'));
    const done = new Set<string>();

    type Box = {
      who: 'you' | 'friend';
      el: HTMLElement;
      dots: HTMLElement[];
      matrix: HTMLElement;
      knob: HTMLElement;
      mode: number;
      val: number;
      taps: number;
      timer: number;
      buzz: number;
      other?: Box;
    };
    const make = (who: 'you' | 'friend'): Box => {
      const el = sim.querySelector<HTMLElement>(`[data-dev="${who}"]`)!;
      const matrix = el.querySelector<HTMLElement>('[data-matrix]')!;
      return { who, el, matrix, dots: Array.from(matrix.children) as HTMLElement[], knob: el.querySelector<HTMLElement>('[data-knob]')!, mode: SELECTION, val: 0, taps: 0, timer: 0, buzz: 0 };
    };
    const you = make('you');
    const friend = make('friend');
    you.other = friend;
    friend.other = you;

    const print = (b: Box, line: string) => {
      const li = document.createElement('li');
      li.innerHTML = `<span>${b.who === 'you' ? 'you' : 'friend'}</span>`;
      li.append(document.createTextNode(line));
      li.className = `is-${b.who}`;
      log.append(li);
      while (log.children.length > 7) log.firstElementChild?.remove();
    };
    const label = (b: Box, icon: string | null) =>
      b.matrix.setAttribute('aria-label', `${b.who === 'you' ? 'Your box’s' : 'Your friend’s box’s'} display: ${icon ? NAMES[icon] : 'blank'}`);
    const draw = (b: Box, icon: string | null) => {
      const bits = icon ? ICONS[icon] : '';
      b.dots.forEach((d, i) => d.classList.toggle('on', bits[i] === '#'));
      b.matrix.classList.toggle('is-lit', !!icon);
      label(b, icon);
    };
    const tick = () => {
      const order = ['turn', 'press', 'browse', 'send', 'reply'];
      const next = order.find((k) => !done.has(k));
      steps.forEach((s) => {
        s.classList.toggle('is-done', done.has(s.dataset.step!));
        s.classList.toggle('is-now', s.dataset.step === next);
      });
    };
    const setKnob = (b: Box, drag = 0) => {
      b.knob.style.setProperty('--turn', `${b.val * 48 + drag}deg`);
      b.knob.setAttribute('aria-valuenow', String(b.val));
      b.knob.setAttribute('aria-valuetext', (b.mode === MESSAGE ? MESSAGES : FRIENDS)[b.val].replace(/^(icon_|q_)/, '').replace('_', ' '));
    };

    const turn = (b: Box, dir: number) => {
      const v = Math.max(0, Math.min(2, b.val + dir)); // RANGE_BOUNDED, 0 to 2
      if (v === b.val) return;
      b.val = v;
      print(b, `result = ${v}`);
      if (b.mode !== MESSAGE) {
        print(b, 'In selection mode');
        draw(b, FRIENDS[v]);
        if (b === you) done.add('turn');
      } else {
        print(b, 'In message mode');
        draw(b, MESSAGES[v]);
        if (b === you) done.add('browse');
      }
      setKnob(b);
      tick();
    };
    const press = (b: Box) => {
      print(b, 'button pressed');
      print(b, 'button released');
      b.mode = MESSAGE;
      b.knob.classList.add('is-pressed');
      setTimeout(() => b.knob.classList.remove('is-pressed'), 160);
      if (b === you) done.add('press');
      setKnob(b);
      tick();
    };
    const vibrate = (b: Box) => {
      if (reduce) {
        b.el.classList.add('is-ping');
        setTimeout(() => b.el.classList.remove('is-ping'), 1000);
        return;
      }
      clearTimeout(b.buzz);
      b.el.classList.remove('is-buzz');
      void b.el.offsetWidth;
      b.el.classList.add('is-buzz');
      b.buzz = window.setTimeout(() => b.el.classList.remove('is-buzz'), 1000); // sleep_ms(1000)
    };
    const receive = (b: Box, msg: string) => {
      print(b, `Friend: ${msg}`);
      const icon = ICON_MAP[msg];
      if (icon) {
        draw(b, icon);
        b.mode = REPLY;
        setKnob(b);
      }
      vibrate(b);
    };
    const send = (b: Box, msg: string) => {
      const to = b.other!;
      const go = () => receive(to, msg);
      if (reduce) return go();
      signal.textContent = msg;
      signal.animate(
        b === you
          ? [{ left: '0%', opacity: 0 }, { opacity: 1, offset: 0.15 }, { opacity: 1, offset: 0.85 }, { left: '100%', opacity: 0 }]
          : [{ left: '100%', opacity: 0 }, { opacity: 1, offset: 0.15 }, { opacity: 1, offset: 0.85 }, { left: '0%', opacity: 0 }],
        { duration: 520, easing: 'cubic-bezier(0.4, 0, 0.2, 1)' },
      ).onfinish = go;
    };
    const touch = (b: Box, n: number) => {
      print(b, `${b.mode} ${n}`); // print(mode, tap_count)
      if (b.mode === MESSAGE && n === 2) {
        print(b, 'Sending message: c');
        b.mode = SELECTION;
        draw(b, null);
        if (b === you) done.add('send');
        send(b, 'c');
      } else if (b.mode === REPLY && n === 1) {
        b.mode = SELECTION;
        draw(b, null);
        if (b === friend && done.has('send')) done.add('reply');
        send(b, 't');
      }
      setKnob(b);
      tick();
    };
    // MultiClickButton(max_time_between_clicks=350): the taps are counted once they stop
    const tap = (b: Box) => {
      b.taps += 1;
      clearTimeout(b.timer);
      b.timer = window.setTimeout(() => {
        const n = b.taps;
        b.taps = 0;
        touch(b, n);
      }, 350);
    };

    [you, friend].forEach((b) => {
      const pad = b.el.querySelector<HTMLButtonElement>('[data-pad]')!;
      pad.addEventListener('click', () => {
        pad.classList.remove('is-tap');
        void pad.offsetWidth;
        pad.classList.add('is-tap');
        tap(b);
      });

      // the dial: drag it round (or along) to turn, click it to press; arrows and Enter from the keyboard
      const STEP = 26;
      let px = 0;
      let py = 0;
      let acc = 0;
      let travel = 0;
      let held = false;
      b.knob.addEventListener('pointerdown', (e) => {
        held = true;
        px = e.clientX;
        py = e.clientY;
        acc = 0;
        travel = 0;
        b.knob.setPointerCapture(e.pointerId);
        b.knob.classList.add('is-held');
      });
      b.knob.addEventListener('pointermove', (e) => {
        if (!held) return;
        const d = e.clientX - px - (e.clientY - py); // right or up turns it on
        px = e.clientX;
        py = e.clientY;
        acc += d;
        travel += Math.abs(d);
        while (acc >= STEP) {
          acc -= STEP;
          turn(b, 1);
        }
        while (acc <= -STEP) {
          acc += STEP;
          turn(b, -1);
        }
        setKnob(b, (acc / STEP) * 18);
      });
      const release = () => {
        if (!held) return;
        held = false;
        b.knob.classList.remove('is-held');
        if (travel < 6) press(b);
        setKnob(b);
      };
      b.knob.addEventListener('pointerup', release);
      b.knob.addEventListener('pointercancel', () => {
        held = false;
        b.knob.classList.remove('is-held');
        setKnob(b);
      });
      b.knob.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowUp') turn(b, 1);
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') turn(b, -1);
        else if (e.key === 'Enter' || e.key === ' ') press(b);
        else return;
        e.preventDefault();
        e.stopPropagation();
      });
      // a click from the keyboard or a screen reader arrives without a pointer
      b.knob.addEventListener('click', (e) => {
        if ((e as PointerEvent).pointerType === '' || e.detail === 0) press(b);
      });
    });

    const reset = () => {
      [you, friend].forEach((b) => {
        clearTimeout(b.timer);
        clearTimeout(b.buzz);
        Object.assign(b, { mode: SELECTION, val: 0, taps: 0 });
        b.el.classList.remove('is-buzz', 'is-ping');
        draw(b, null);
        setKnob(b);
      });
      done.clear();
      log.replaceChildren();
      tick();
    };
    sim.querySelector('[data-reset]')?.addEventListener('click', reset);
    reset();
  }
</script>

