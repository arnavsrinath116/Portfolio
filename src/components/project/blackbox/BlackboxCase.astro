---
import { withBase } from '../../../lib/url';
import type { Project } from '../../../data/projects';
import { projects } from '../../../data/projects';
import type { SkillModel } from '../../../data/skills';
import ModelViewer from '../../ModelViewer.astro';
import { code, sheet, parts } from './data';

interface Props {
  project: Project;
}
const { project } = Astro.props;
const others = projects.filter((p) => p.slug !== project.slug);
const img = (n: string) => withBase(`/projects/blackbox/${n}.webp`);
const vid = (n: string) => withBase(`/projects/blackbox/${n}.mp4`);

// BlackBox: a week at CIID's "Design That Plays Back", in a team of three. A screenless box for
// passing notes in class, built on an Arduino Nano ESP32 in MicroPython and laser-cut from ply.
// The page tells it the way the film does: one note, passed across a classroom. Everything here comes
// from the team's deck and film, the code files and screenshots from the week (their own timestamps
// date the build log), the final code (finalcodeciid.py) and the laser-cut drawing (box (1).dxf).
// My part: the MicroPython code, the electronics and wiring, and the laser-cut enclosure.

// the LED matrix sat upside down in the box, so the code draws every icon upside down;
// on the page they are shown the way they lit up on the box: the right way round
const upright = (rows: readonly string[]) => [...rows].reverse().join('');
const ICONS = {
  icon_sword: upright(code.icon_sword),
  icon_robot: upright(code.icon_robot),
  icon_cat: upright(code.icon_cat),
  q_message1: upright(code.q_message1),
  icon_coffee: upright(code.icon_coffee),
  q_message3: upright(code.q_message3),
  reply_ok: upright(code.reply_ok),
};
const dots = Array.from({ length: 64 }, (_, i) => i);


// the problem, as the film opens: three frames of one classroom
const story = [
  { src: 'desk', alt: 'A student writing at a classroom desk, smiling at something he wants to share', t: 'Something to tell a friend across the room.' },
  { src: 'look', alt: 'The student turning round in his chair towards a friend at the back of the class', t: 'Turn round to say it, and the whole class sees.' },
  { src: 'friend', alt: 'The friend at the back of the class looking up from her laptop', t: 'Reach for a phone, and its screen lights up the room.' },
];

// the box in use, frame by frame from the film: the sender, the friend's box, the reply
const SEQ = 22;
const seqFrames = Array.from({ length: SEQ }, (_, i) => withBase(`/projects/blackbox/seq/${String(i).padStart(2, '0')}.webp`));
const beats = [
  { t: 'Turn, tap.', d: 'The dial picks a friend, then a message. Two taps on the pad send it.', from: 0, to: 9 },
  { t: 'Glow.', d: 'Their box buzzes once, and the icon lights up through the white top.', from: 9, to: 18 },
  { t: 'Reply.', d: 'One tap answers with a thumbs up.', from: 18, to: SEQ },
];

// the week, in the order the files say it happened: each time is a file's own timestamp
type Entry = { at: string; file?: string; t: string; code?: string };
const week: { day: string; date: string; items: Entry[] }[] = [
  {
    day: 'Mon',
    date: '13 Jul',
    items: [
      {
        at: '16:59',
        file: '1stCIIDpy',
        t: 'First MicroPython: the board’s own LED fades up and down, and two buttons switch its colours.',
        code: 'for i in range(100):\n  lamp.brightness = i\n  sleep_ms(50)',
      },
    ],
  },
  {
    day: 'Tue',
    date: '14 Jul',
    items: [
      { at: '10:16', file: 'screenshot', t: 'A strip of eight pixels, all lit one colour.', code: 'pixels.set_all_rgb(r, g, b, brightness)\npixels.show()' },
      {
        at: '12:07',
        file: '2ndCIID',
        t: 'A tilt sensor: turn the board upside down and a servo swings.',
        code: 'z = round(acceleration[2])\nif z == -1:\n  print("Upside Down")',
      },
      { at: '19:22', file: 'Music', t: 'A sound player. It never went in the box, which had to stay silent.' },
    ],
  },
  {
    day: 'Wed',
    date: '15 Jul',
    items: [
      { at: '14:16', file: 'screenshot', t: 'The touch pad, printing every touch.', code: 'if touch_sensor.value() == 1:\n    print("Digital Touch Detected!")' },
      { at: '15:51', file: 'button-VIB', t: 'A button that sets off the vibration motor.', code: "if event == Button.PRESSED:\n    print('button pressed')\n    motor.value(1)" },
      { at: '16:04', file: 'colorful_gerbil.py', t: 'The first message from one board to another, over ESP-NOW.', code: 'host, message = manager.get_message()' },
      { at: '18:41', file: 'dot matrix', t: 'The 8 × 8 matrix counts from 0 to 9.' },
      {
        at: '19:10',
        file: 'newq',
        t: 'Everything at once. Turn to pick a code from 0 to 9, touch to send it, and the other box buzzes.',
        code: 'esp.send_message(PEER, str(val_new))',
      },
    ],
  },
  {
    day: 'Thu',
    date: '16 Jul',
    items: [
      { at: '10:50', file: 'FinalCode1', t: 'The numbers give way to icons, drawn as text in the code.', code: 'def display_icon(display, icon, fill_char = "#"):' },
      { at: '19:29', file: 'box (1).dxf', t: 'The box, drawn flat for the laser cutter.' },
    ],
  },
  {
    day: 'Fri',
    date: '17 Jul',
    items: [
      { at: '13:58', file: 'finalcodeciid.py', t: 'The final code: three modes, two taps to send, one tap to reply.' },
      { at: 'Show', t: 'Two boxes talking, shown with the film and the deck.' },
    ],
  },
];

// the parts, with the pins they use in finalcodeciid.py
const pins = [
  { name: '8×8 LED matrix', chip: 'MAX7219', d: 'Shows the icons through the white top.', pins: ['SPI 1', 'D10'], wire: '#ff3b30' },
  { name: 'Rotary encoder', chip: 'with push switch', d: 'Turn to browse, press to switch modes.', pins: ['D8', 'D9', 'D7'], wire: '#f6c343' },
  { name: 'Touch sensor', chip: 'capacitive pad', d: 'Counts one tap or two.', pins: ['A2'], wire: '#4c8dff' },
  { name: 'Vibration motor', chip: 'coin motor', d: 'One second of buzz when a note arrives: felt, not heard.', pins: ['GPIO 1'], wire: '#3fbf6a' },
  { name: 'ESP-NOW radio', chip: 'on the board', d: 'Box to box, with no Wi-Fi network and no phone in between.', pins: ['built in'], wire: '#b07cff', air: true },
];

// Wednesday's notes were numbers; Thursday's were icons. A 7 as an 8×8 matrix draws it, and the coffee cup
const seven = ['.######.', '......##', '.....##.', '....##..', '...##...', '...##...', '...##...', '........'].join('');
const coffee = ICONS.icon_coffee;

// the exchange, as the code runs it on both boxes
const seq: { side: 'you' | 'friend' | 'msg'; t: string; d?: string; dir?: 'r' | 'l' }[] = [
  { side: 'you', t: 'Turn the dial', d: 'friend_icons' },
  { side: 'you', t: 'Press the dial', d: 'MESSAGE_MODE' },
  { side: 'you', t: 'Turn again', d: 'message_icons' },
  { side: 'you', t: 'Tap twice', d: 'send "c"' },
  { side: 'msg', t: '"c"', dir: 'r' },
  { side: 'friend', t: 'Buzz, show coffee', d: 'REPLY_MODE' },
  { side: 'friend', t: 'Tap once', d: 'send "t"' },
  { side: 'msg', t: '"t"', dir: 'l' },
  { side: 'you', t: 'Buzz, show thumbs up', d: 'REPLY_MODE' },
];

const learnings = [
  { t: 'Precision matters.', d: 'One wrong character in the code and the box doesn’t do its one job. Small slips have real effects.' },
  { t: 'Prototyping is its own skill.', d: 'Sizing it, fitting everything inside, and keeping it simple to look at took as much thought as the idea.' },
  { t: 'Define everything first.', d: 'Every mode, every tap and every message had to be decided before the code could hold together.' },
  { t: 'Code is structure.', d: 'Writing it showed me the how and why behind the product. End-to-end design is built, not just drawn.' },
];

// the second casing, drawn for 3D printing after CIID; the same model the 3D modelling sheet shows
const casing: SkillModel = { src: '/models/blackbox.glb', size: [64, 64, 72], parts: 6, fade: ['Shell', 'Lid'] };

// ---------------- the laser-cut drawing ----------------
// The sheet: both faces side by side, the 354 mm band below them, shortened with a break the way a long
// part is drawn, so it sits under the faces instead of running off the side.
const F = parts.face;
const B = parts.band;
const GAP = 10;
const ROW = F.w * 2 + GAP; // the width of the two faces, and of the broken band under them
const KEEP = (ROW - GAP) / 2; // how much of each end of the band is shown
const BY = F.h + 14; // where the band row starts
const sheetW = ROW;
const sheetH = BY + B.h;
// a drafting break: a zigzag across the band where it's cut short
const zig = (x: number) => {
  const y0 = BY - 3;
  const y1 = BY + B.h + 3;
  const m = (y0 + y1) / 2;
  return `M${x} ${y0}V${m - 6}l-2.6 3 5.2 3-2.6 3V${y1}`;
};

// The layers: the same parts as they stack, drawn in isometric. Plan (x, y) and height z in mm.
const pts = (d: string) =>
  d
    .split(/[ML]/)
    .map((s) => s.trim())
    .filter(Boolean)
    .map((s) => s.split(/\s+/).map(Number) as [number, number]);
const facePts = pts(F.d);
const C30 = Math.cos(Math.PI / 6);
const iso = (x: number, y: number, z: number) => [(x - y) * C30, (x + y) * 0.5 - z];
const isoPath = (p: [number, number][], z: number) =>
  'M' + p.map(([x, y]) => iso(x, y, z).map((v) => v.toFixed(2)).join(' ')).join('L') + 'Z';
const BAND_H = 41; // the band's height between the tabs
const ring = Array.from({ length: 11 }, (_, i) => isoPath(facePts, (i * BAND_H) / 10));
// the matrix board sits under the white top, centred
const MX = (F.w - 32) / 2;
const MY = (F.h - 32) / 2;
const matrixBoard = isoPath(
  [
    [MX - 2, MY - 2],
    [MX + 34, MY - 2],
    [MX + 34, MY + 34],
    [MX - 2, MY + 34],
  ],
  0,
);
const matrixDots = Array.from({ length: 64 }, (_, i) => {
  const cx = MX + 2 + (i % 8) * 4;
  const cy = MY + 2 + Math.floor(i / 8) * 4;
  const [x, y] = iso(cx, cy, 0);
  return { x: x.toFixed(2), y: y.toFixed(2), on: coffee[i] === '#' };
});
// where each layer's leader starts: its far right corner
// the band, split into its cut paths: the outline, and the hinge cuts in the two ends the sheet shows
const bandOutline = B.d.split('M').filter(Boolean).map((d) => 'M' + d.trim());
const hingeCuts = B.hinges.split('M').filter(Boolean).map((d) => 'M' + d.trim());
const shownHinges = hingeCuts.filter((d) => {
  const x = parseFloat(d.slice(1));
  return x < KEEP || x > B.w - KEEP;
});
const SHIFT = KEEP + GAP - (B.w - KEEP); // moves the band's far end to sit beside its near end
// numbered callouts for the stack: where each layer's leader starts, before it's pulled apart
const callout = (x: number, y: number, z: number) => iso(x, y, z).map((v) => +v.toFixed(1));
const layers = [
  { n: 1, k: -136, at: callout(F.w, F.h * 0.25, BAND_H), label: 'White top', note: 'turns bare LEDs into soft pixels' },
  { n: 2, k: -64, at: callout(MX + 34, MY + 10, BAND_H - 6), label: '8 × 8 LED matrix', note: 'MAX7219, mounted upside down' },
  { n: 3, k: 0, at: callout(F.w, F.h * 0.4, BAND_H * 0.5), label: 'Ply band', note: '354 mm, four rows of living hinges' },
  { n: 4, k: 40, at: callout(F.w, F.h * 0.4, 0), label: 'Ply base', note: 'finger joints lock the band to it' },
];
const KX = 128; // the x where the callout numbers sit

const chapters = [
  ['class', 'The problem'],
  ['idea', 'The brief'],
  ['box', 'What we made'],
  ['build', 'How I built it'],
  ['after', 'What I learned'],
];
const no = (key: string) => String(chapters.findIndex(([k]) => k === key) + 1).padStart(2, '0');
const label = (key: string) => chapters.find(([k]) => k === key)![1];
---

<article class="bb" data-project={project.slug} data-theme="led" data-card-bg="#0a0a0a" aria-labelledby="bb-title" hidden data-bb>
  <!-- the signal: a red line that runs down the card as you read, its tip a lit LED -->
  <svg class="bb-line" aria-hidden="true" data-bb-line><path class="bb-line-glow"></path><path class="bb-line-path"></path><circle class="bb-line-halo" r="14"></circle><circle class="bb-line-tip" r="4.5"></circle></svg>

  <!-- ============ the box, lit ============ -->
  <header class="bb-hero">
    <div class="bb-hero-copy">
      <h2 class="bb-title" id="bb-title">
        <img src={img('logo')} alt="BlackBox" width="550" height="325" decoding="async" />
      </h2>
      <p class="bb-tag">Secret notes, reimagined.</p>
      <p class="bb-lede">
        A screenless box for passing notes in class. Turn the dial, tap twice, and your friend’s box buzzes once and lights up. Three of
        us built two working boxes in a week at CIID. <em>I wrote the code, wired the electronics and laser-cut the box.</em>
      </p>
      <p class="bb-slate">Design That Plays Back at CIID, July 2026. With Ramanik and Srishti.</p>
      <div class="bb-acts">
        <a class="bb-btn" href="#bb-try" data-jump data-magnet>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5"></circle><path d="M12 4.5V9"></path></svg>
          Pass a note
        </a>
        <a class="bb-btn bb-btn-ghost" href="#bb-film" data-jump data-magnet>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
          Watch the film
        </a>
      </div>
    </div>
    <figure class="bb-reel" data-bb-reel>
      <img
        src={img('render')}
        alt="The second BlackBox casing, rendered from its CAD: a black shell with the lid lifted, the LED matrix lit red inside"
        width="1120"
        height="1160"
        decoding="async"
      />
    </figure>
  </header>

  <!-- the chapter rail: a column of LEDs on the card's right edge; the current chapter's is lit -->
  <div class="bb-rail-wrap" data-bb-rail>
    <nav class="bb-rail" aria-label="Chapters">
      <span class="bb-rail-now" aria-hidden="true" data-bb-rail-now></span>
      <ol>
        {
          chapters.map(([k, name]) => (
            <li>
              <a href={`#bb-${k}`} data-phase-link={k}>
                <span class="bb-rail-name">{name}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>

  <!-- ===================== in class ===================== -->
  <section class="bb-ch" id="bb-class" data-phase="class" aria-labelledby="bb-class-t">
    <header class="bb-chead" data-bb-chead>
      <p class="bb-course"><i aria-hidden="true"></i><span>{no('class')}</span>{label('class')}</p>
      <h3 class="bb-ctitle" id="bb-class-t">Talking gets you caught.</h3>
    </header>

    <div class="bb-block" data-bb-in>
      <p class="bb-big bb-lead-line">You have something to tell a friend on the other side of the room, in the middle of a lesson.</p>
    </div>

    <ol class="bb-block bb-story" data-bb-in>
      {
        story.map((s, i) => (
          <li class="bb-frame" style={`--i:${i}`}>
            <figure>
              <span class="bb-frame-pic">
                <img src={img(s.src)} alt={s.alt} width="1600" height="900" loading="lazy" decoding="async" />
              </span>
              <figcaption>
                <span class="bb-frame-n">{i + 1}</span>
                <span class="bb-frame-t">{s.t}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ol>

    <div class="bb-block" data-bb-in>
      <p class="bb-verdict">There was no quiet way to reach a friend in class.</p>
    </div>
  </section>

  <!-- ===================== the brief ===================== -->
  <section class="bb-ch" id="bb-idea" data-phase="idea" aria-labelledby="bb-idea-t">
    <header class="bb-chead" data-bb-chead>
      <p class="bb-course"><i aria-hidden="true"></i><span>{no('idea')}</span>{label('idea')}</p>
      <h3 class="bb-ctitle" id="bb-idea-t">Bring back the passed note.</h3>
    </header>

    <div class="bb-block bb-idea" data-bb-in>
      <div class="bb-idea-copy">
        <p class="bb-big">A passed note is silent, private and meant for one person.</p>
        <p class="bb-body">
          The week at CIID, <b>Design That Plays Back</b>, asked for a physical device with no screen, built with an Arduino and
          MicroPython. Ours would keep everything a paper note gets right and lose the paper: something you could use without looking down at
          it, that nobody else in the room would notice.
        </p>
      </div>
      <figure class="bb-idea-fig">
        <img src={img('idea')} alt="The student in class with a finger raised, an idea lightbulb drawn beside him" width="1600" height="900" loading="lazy" decoding="async" />
      </figure>
    </div>

    <div class="bb-block" data-bb-in>
      <ul class="bb-rules" aria-label="Three rules for the box">
        <li><i aria-hidden="true"></i>No screen.</li>
        <li><i aria-hidden="true"></i>No sound.</li>
        <li><i aria-hidden="true"></i>No getting caught.</li>
      </ul>
    </div>
  </section>

  <!-- ===================== the box ===================== -->
  <section class="bb-ch" id="bb-box" data-phase="box" aria-labelledby="bb-box-t">
    <header class="bb-chead" data-bb-chead>
      <p class="bb-course"><i aria-hidden="true"></i><span>{no('box')}</span>{label('box')}</p>
      <h3 class="bb-ctitle" id="bb-box-t">Turn. Tap. Glow.</h3>
    </header>

    <!-- the box in use: the film's frames play as you scroll past -->
    <div class="bb-block bb-play" data-bb-in data-bb-play data-frames={JSON.stringify(seqFrames)}>
      <figure class="bb-play-fig">
        <img src={seqFrames[0]} alt="From the film: a hand taps the touch pad beside the box, and a pixel icon glows red through its white top" width="1120" height="630" loading="lazy" decoding="async" data-bb-frame />
        <figcaption><span>From the film</span><span data-bb-frame-n>01 / {SEQ}</span></figcaption>
      </figure>
      <ol class="bb-beats">
        {
          beats.map((b) => (
            <li data-from={b.from / SEQ} data-to={b.to / SEQ}>
              <b>{b.t}</b>
              <span>{b.d}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <!-- try it: the two boxes, running the code's own logic -->
    <div class="bb-block" id="bb-try" data-bb-in>
      <div class="bb-bhead">
        <h4 class="bb-h">Pass one yourself.</h4>
        <p class="bb-body">
          These two boxes run the logic of the code we shipped: the same icons, the same three modes, the same taps. Turn your dial, press
          it, turn it again, then tap your pad twice.
        </p>
      </div>
      <div class="bb-sim" data-bb-sim data-icons={JSON.stringify(ICONS)}>
        <div class="bb-sim-stage">
          {
            (['you', 'friend'] as const).map((who) => (
              <div class="bb-dev" data-dev={who}>
                <div class="bb-dev-box">
                  <span class="bb-ply" aria-hidden="true" />
                  <span class="bb-frost">
                    <span class="bb-matrix" role="img" aria-label={who === 'you' ? 'Your box’s display: blank' : 'Your friend’s box’s display: blank'} data-matrix>
                      {dots.map(() => (
                        <i />
                      ))}
                    </span>
                  </span>
                  <span class="bb-buzz" aria-hidden="true" />
                  <button
                    type="button"
                    class="bb-knob"
                    role="slider"
                    aria-label={who === 'you' ? 'Your dial: drag or use arrow keys to turn, Enter to press' : 'Your friend’s dial: drag or use arrow keys to turn, Enter to press'}
                    aria-valuemin="0"
                    aria-valuemax="2"
                    aria-valuenow="0"
                    data-knob>
                    <span />
                  </button>
                </div>
                <button type="button" class="bb-pad" aria-label={who === 'you' ? 'Your touch pad: tap once or twice' : 'Your friend’s touch pad: tap once or twice'} data-pad>
                  <span aria-hidden="true" />
                </button>
                <p class="bb-dev-name">{who === 'you' ? 'Your box' : 'Your friend’s box'}</p>
              </div>
            ))
          }
          <div class="bb-air" aria-hidden="true">
            <span>ESP-NOW</span>
            <i data-signal />
          </div>
        </div>

        <div class="bb-sim-foot">
          <div class="bb-steps-wrap">
            <ol class="bb-steps" data-steps>
              <li data-step="turn">Turn your dial to pick a friend.</li>
              <li data-step="press">Press your dial.</li>
              <li data-step="browse">Turn it again to pick a message.</li>
              <li data-step="send">Tap your pad twice to send it.</li>
              <li data-step="reply">On their box, tap once to reply.</li>
            </ol>
            <button type="button" class="bb-reset" data-reset>Start again</button>
          </div>
          <div class="bb-serial">
            <p class="bb-serial-h"><span>Serial monitor</span><span>what the code prints</span></p>
            <ol aria-live="polite" data-log></ol>
          </div>
        </div>
      </div>
      <p class="bb-note">
        In the build we showed, every message arrives as coffee: we wired that one end to end. The other two were drawn and could be
        browsed, but not yet sent.
      </p>
    </div>

    <!-- the film: the whole story, and the ending the note was for -->
    <div class="bb-block bb-film-block" id="bb-film" data-bb-in>
      <div class="bb-bhead">
        <h4 class="bb-h">The whole story, in forty seconds.</h4>
        <p class="bb-body">The film we showed with the two boxes: a note across the room, a coffee cup on a white top, and the drinks it was for.</p>
      </div>
      <figure class="bb-film">
        <video src={vid('film')} poster={img('cheers-film')} controls playsinline preload="none" aria-label="The BlackBox film" data-bb-film></video>
      </figure>
    </div>
  </section>

  <!-- ===================== the build ===================== -->
  <section class="bb-ch" id="bb-build" data-phase="build" aria-labelledby="bb-build-t">
    <header class="bb-chead" data-bb-chead>
      <p class="bb-course"><i aria-hidden="true"></i><span>{no('build')}</span>{label('build')}</p>
      <h3 class="bb-ctitle" id="bb-build-t">Five days, one part at a time.</h3>
    </header>

    <div class="bb-block" data-bb-in>
      <p class="bb-big bb-lead-line">Each part had to work on its own before it joined the rest. The files from the week still show the order it happened in.</p>
    </div>

    <!-- the build log: every time here is a file's own timestamp -->
    <ol class="bb-block bb-log" data-bb-in data-bb-log>
      {
        week.map((w) => (
          <li class="bb-day">
            <p class="bb-day-h">
              <b>{w.day}</b>
              <span>{w.date}</span>
            </p>
            <ol class="bb-day-list">
              {w.items.map((e) => (
                <li class="bb-entry">
                  <i class="bb-entry-led" aria-hidden="true" />
                  <span class="bb-entry-at">{e.at}</span>
                  <div class="bb-entry-body">
                    <p>{e.t}</p>
                    {e.file && <span class="bb-entry-file">{e.file}</span>}
                    {e.code && <pre class="bb-entry-code"><code>{e.code}</code></pre>}
                  </div>
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>

    <!-- inside: the pin map -->
    <div class="bb-block" id="bb-inside" data-bb-in>
