        </figure>

        <figure class="bb-stack" data-bb-stack>
          <svg viewBox="-92 -184 236 334" role="img" aria-label="How the cut parts stack, pulled apart: the white top, the LED matrix, the ply band bent round, and the ply base">
            <g class="bb-layer" style="--k:40">
              <path class="bb-l-ply" d={isoPath(facePts, 0)}></path>
            </g>
            <g class="bb-layer" style="--k:0">
              {ring.map((d, i) => <path class:list={['bb-l-ring', { 'is-edge': i === 0 || i === ring.length - 1 }]} d={d} />)}
            </g>
            <g class="bb-layer" style="--k:-64">
