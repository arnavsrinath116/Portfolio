  <!-- ===================== afterwards ===================== -->
  <section class="bb-ch" id="bb-after" data-phase="after" aria-labelledby="bb-after-t">
    <header class="bb-chead" data-bb-chead>
      <p class="bb-course"><i aria-hidden="true"></i><span>{no('after')}</span>{label('after')}</p>
      <h3 class="bb-ctitle" id="bb-after-t">What the box taught me.</h3>
