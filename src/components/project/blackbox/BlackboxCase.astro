        </p>
      </div>
      <div class="bb-cutrow">
        <figure class="bb-sheetfig" data-bb-cut>
          <svg viewBox={`-6 -18 ${sheetW + 12} ${sheetH + 44}`} role="img" aria-label="The laser-cut sheet: the two rounded faces side by side, and the 354 mm band below them, drawn shortened with a break">
            <defs>
              <clipPath id="bb-band-l"><rect x="-2" y="-4" width={KEEP + 2} height={B.h + 8}></rect></clipPath>
              <clipPath id="bb-band-r"><rect x={B.w - KEEP} y="-4" width={KEEP + 2} height={B.h + 8}></rect></clipPath>
            </defs>
            {
              [0, F.w + GAP].map((x, i) => (
                <g transform={`translate(${x} 0)`} style={`--a:${i * 0.22};--b:${0.3 + i * 0.22}`}>
                  <path class="bb-cut-base bb-cut-face" d={F.d} />
