                        <path class="bb-cut-line" d={d} pathLength="1" />
                      </>
                    ))}
                  </g>
                </g>
              ))
            }
            <path class="bb-cut-break" d={zig(KEEP + 2.5) + zig(KEEP + GAP - 2.5)}></path>
            <g class="bb-dim">
              <path d={`M0 -8H${F.w}M0 -11V-5M${F.w} -11V-5`}></path>
              <text x={F.w / 2} y="-12">{Math.round(F.w)} × {Math.round(F.h)} mm</text>
              <path d={`M0 ${sheetH + 9}H${sheetW}M0 ${sheetH + 6}V${sheetH + 12}M${sheetW} ${sheetH + 6}V${sheetH + 12}`}></path>
              <text x={sheetW / 2} y={sheetH + 20}>band {Math.round(B.w)} mm, drawn short</text>
