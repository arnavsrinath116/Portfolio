    border-radius: calc(10px * var(--sq));
    background:
      radial-gradient(circle, rgb(255 255 255 / 0.08) 1.2px, transparent 1.6px) 0 0 / 12px 12px,
      linear-gradient(170deg, #0e6f78, #0a4d55);
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.12),
      0 20px 40px -20px rgb(0 0 0 / 0.8);
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    color: rgb(255 255 255 / 0.7);
    z-index: 0;
  }
  .bb-pins li {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(40px, 1fr) calc(var(--board) * 0.62);
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--bb-line);
    margin-right: calc(var(--board) * 0.38);
  }
  .bb-pins li:last-child {
    border-bottom: 0;
  }
  .bb-part {
    display: grid;
    gap: 4px;
    padding-right: 16px;
  }
  .bb-part b {
    font-size: 1.125rem;
    font-weight: 800;
    font-stretch: var(--bb-wide);
    letter-spacing: -0.015em;
  }
  .bb-chip {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-ink-3);
  }
  .bb-part-d {
    color: var(--bb-ink-2);
    line-height: 1.5;
    font-size: 0.9375rem;
  }
  .bb-wire {
    position: relative;
    height: 3px;
  }
  .bb-wire i {
    position: absolute;
    inset: 0;
    border-radius: 3px;
    background: var(--wire);
    transform-origin: left center;
    box-shadow: 0 0 10px -2px var(--wire);
  }
  .is-air .bb-wire i {
    background: repeating-linear-gradient(90deg, var(--wire) 0 6px, transparent 6px 11px);
    box-shadow: none;
  }
  .bb-pinset {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: flex-start;
    padding-left: 8px;
  }
  .bb-pinset code {
    padding: 3px 7px;
    border-radius: calc(4px * var(--sq));
    background: rgb(0 0 0 / 0.55);
    box-shadow: inset 0 0 0 1px var(--wire);
    font-size: 0.75rem;
    color: #fff;
    white-space: nowrap;
  }

  /* ---------- the film ---------- */
  .bb-film {
    margin: 0;
    overflow: hidden;
    border-radius: calc(14px * var(--sq));
    background: #000;
    box-shadow: 0 0 0 1px var(--bb-line);
  }
  .bb-film video {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #000;
  }

  /* ---------- pixels ---------- */
  .bb-sheet {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(8px, 1.2vw, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bb-sheet li {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 9%;
    padding: 14%;
    aspect-ratio: 1;
    border-radius: calc(10px * var(--sq));
    background: var(--bb-panel);
    box-shadow: inset 0 0 0 1px var(--bb-line);
  }
  .bb-sheet i,
  .bb-flip-grid i {
    border-radius: 50%;
    corner-shape: round;
    background: rgb(255 255 255 / 0.05);
    transition:
      background-color 0.25s ease-out,
      box-shadow 0.25s ease-out;
  }
  .bb-sheet:not(:global(.is-armed)) i:global(.on),
  .bb-sheet li:global(.is-lit) i:global(.on),
  .bb-flip-grid i:global(.on) {
    background: var(--bb-led);
    box-shadow: 0 0 6px 1px var(--bb-led-soft);
  }
  .bb-flip {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    margin-top: clamp(56px, 9vh, 96px);
  }
  .bb-flip-copy p + p {
    max-width: 46ch;
    margin: 16px 0 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--bb-ink-2);
  }
  .bb-flip-copy code {
    padding: 1px 6px;
    border-radius: calc(4px * var(--sq));
    background: var(--bb-panel-2);
    color: var(--bb-led);
  }
  .bb-flip-pair {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(14px, 2.4vw, 32px);
  }
  .bb-ascii {
    margin: 0;
    padding: 16px 18px;
    border-radius: calc(10px * var(--sq));
    background: #070707;
    box-shadow: inset 0 0 0 1px var(--bb-line);
    font-size: clamp(0.8125rem, 1.3vw, 1rem);
    line-height: 1.35;
    letter-spacing: 0.2em;
    color: var(--bb-ink);
  }
  .bb-ascii-h {
    letter-spacing: 0;
    color: var(--bb-ink-3);
  }
  .bb-arrow {
    font-size: 1.5rem;
    color: var(--bb-led);
  }
  .bb-flip-led {
    display: grid;
    place-items: center;
    padding: clamp(14px, 2vw, 24px);
    border-radius: calc(14px * var(--sq));
    background: var(--bb-panel);
    box-shadow: inset 0 0 0 1px var(--bb-line);
    perspective: 700px;
  }
  .bb-flip-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 9%;
    width: min(100%, 240px);
    aspect-ratio: 1;
    /* drawn upside down, as in the code; the scroll turns it the right way up */
    rotate: x var(--flip, 180deg);
  }

  /* ---------- one system ---------- */
  .bb-sys {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
  }
  .bb-seq {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24px;
    row-gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* the two lanes: a line down each box's column */
  .bb-seq::before,
  .bb-seq::after {
    content: '';
    position: absolute;
    top: 34px;
    bottom: 0;
    width: 1px;
    background: var(--bb-line);
  }
  .bb-seq::before {
    left: calc(25% - 6px);
  }
  .bb-seq::after {
    left: calc(75% + 6px);
  }
  .bb-lane {
    position: relative;
    z-index: 1;
    padding-bottom: 10px;
    text-align: center;
    font-size: 0.8125rem;
    color: var(--bb-ink-3);
  }
  .bb-ev {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: calc(10px * var(--sq));
    background: var(--bb-panel-2);
    box-shadow: inset 0 0 0 1px var(--bb-line);
    transition:
      box-shadow 0.3s ease-out,
      opacity 0.3s ease-out;
  }
  .bb-ev.is-you {
    grid-column: 1;
  }
  .bb-ev.is-friend {
    grid-column: 2;
  }
  .bb-ev.is-msg {
    grid-column: 1 / -1;
    padding: 0;
    background: none;
    box-shadow: none;
  }
  .bb-ev b {
    font-size: 0.9375rem;
    font-weight: 700;
  }
  .bb-ev code {
    font-size: 0.75rem;
    color: var(--bb-ink-3);
  }
  .bb-ev:global(.is-lit):not(.is-msg) {
    box-shadow:
      inset 0 0 0 1px rgb(255 59 48 / 0.6),
      0 0 24px -8px var(--bb-led-soft);
  }
  .bb-msg {
    position: relative;
    display: block;
    height: 30px;
    margin: 0 calc(25% - 6px);
  }
  .bb-msg::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    border-top: 1px dashed rgb(255 59 48 / 0.5);
  }
  .bb-msg::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--bb-led);
    border-right: 1px solid var(--bb-led);
    translate: 0 -50%;
  }
  .to-r .bb-msg::after {
    right: 0;
    rotate: 45deg;
  }
  .to-l .bb-msg::after {
    left: 0;
    rotate: -135deg;
  }
  .bb-msg code {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    padding: 2px 8px;
    border-radius: 999px;
    corner-shape: round;
    background: var(--bb-bg);
    box-shadow: inset 0 0 0 1px rgb(255 59 48 / 0.5);
    font-size: 0.75rem;
    color: var(--bb-led);
  }
  .bb-msg i {
    position: absolute;
    top: 50%;
    left: var(--p, 0%);
    width: 8px;
    height: 8px;
    translate: -50% -50%;
    border-radius: 50%;
    corner-shape: round;
    background: var(--bb-led);
    box-shadow: 0 0 10px 2px var(--bb-led-soft);
    opacity: var(--o, 0);
  }
  .bb-loop {
    margin: 0;
  }
  .bb-loop pre {
    margin: 0;
    padding: 18px 20px;
    border-radius: calc(12px * var(--sq));
    background: #070707;
    box-shadow: inset 0 0 0 1px var(--bb-line);
    overflow-x: auto;
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--bb-ink);
  }
  .bb-loop .k {
    color: #ff8a80;
  }
  .bb-loop .c {
    color: var(--bb-ink-3);
  }
  .bb-loop .n {
    color: #f6c343;
  }

  .bb-others {
    margin: clamp(88px, 14vh, 140px) var(--bb-pad) 0;
    padding: 32px 0 clamp(100px, 14vh, 140px);
    border-top: 1px solid var(--bb-line);
  }
  .bb-others-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 16px;
  }
  .bb-other {
    display: grid;
    gap: 6px;
    padding: 18px 20px;
    border: 1px solid var(--bb-line);
    border-radius: calc(8px * var(--sq));
    background: var(--bb-panel);
    color: var(--bb-ink);
    text-align: left;
    cursor: pointer;
    transition: border-color 0.2s ease-out;
  }
  .bb-other span {
    font-size: 0.8125rem;
    color: var(--bb-ink-3);
  }
  .bb-other b {
    font-size: 1.0625rem;
    font-weight: 600;
  }
  @media (hover: hover) {
    .bb-other:hover {
      border-color: var(--bb-led);
    }
  }


  /* ---------- the signal: a red line down the margins ---------- */
  .bb-line {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    overflow: visible;
    pointer-events: none;
  }
  .bb-line path {
    fill: none;
    stroke: var(--bb-led);
    stroke-linecap: round;
  }
  .bb-line-path {
    stroke-width: 2;
  }
  .bb-line-glow {
    stroke-width: 9;
    opacity: 0.16;
  }
  .bb-line-tip {
    fill: #ffd9d6;
    stroke: var(--bb-led);
    stroke-width: 2;
  }
  .bb-line-halo {
    fill: rgb(255 59 48 / 0.28);
  }
  /* content sits above the line, so it runs behind the photos and panels */
  .bb-hero,
  .bb-ch,
  .bb-others {
    position: relative;
    z-index: 1;
  }

  /* ---------- hero ---------- */
  .bb-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    padding: clamp(48px, 8vh, 88px) var(--bb-pad) 0;
  }
  .bb-title {
    margin: 0;
    line-height: 0;
  }
  .bb-title img {
    width: clamp(200px, 26vw, 380px);
    height: auto;
  }
  .bb-tag {
    margin: clamp(16px, 2.4vh, 24px) 0 0;
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    letter-spacing: -0.025em;
    line-height: 1;
    text-wrap: balance;
  }
  .bb-lede {
    max-width: 48ch;
    margin: 18px 0 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--bb-ink-2);
    text-wrap: pretty;
  }

  /* ---------- chapters ---------- */
  .bb-ch {
    scroll-margin-top: 0;
  }
  .bb-chead {
    position: relative;
    display: grid;
    gap: 12px;
    padding: clamp(80px, 12vh, 128px) var(--bb-pad) 0;
  }
  .bb-course {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bb-ink-3);
    transition: color 0.4s ease-out;
  }
  .bb-course span {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    color: var(--bb-ink-3);
  }
  .bb-course i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    corner-shape: round;
    background: rgb(255 255 255 / 0.14);
    transition:
      background-color 0.3s ease-out,
      box-shadow 0.4s ease-out;
  }
  /* the chapter's LED switches on when the signal reaches it */
  .bb-chead:not(:global(.is-armed)) .bb-course,
  .bb-chead:global(.is-lit) .bb-course {
    color: var(--bb-led);
  }
  .bb-chead:not(:global(.is-armed)) .bb-course i,
  .bb-chead:global(.is-lit) .bb-course i,
  .bb-others .bb-course i {
    background: var(--bb-led);
    box-shadow: 0 0 12px 2px var(--bb-led-soft);
  }
  .bb-ctitle {
    max-width: 16ch;
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 4.25rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    line-height: 0.96;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .bb-block {
    padding: clamp(36px, 6vh, 64px) var(--bb-pad) 0;
  }
  .bb-big {
    max-width: 34ch;
    margin: 0;
    font-size: clamp(1.25rem, 2.1vw, 1.75rem);
    font-weight: 700;
    font-stretch: var(--bb-wide);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .bb-lead-line {
    max-width: 34ch;
    color: var(--bb-ink-2);
  }
  .bb-body {
    max-width: 62ch;
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--bb-ink-2);
    text-wrap: pretty;
  }
  .bb-body b {
    color: var(--bb-ink);
    font-weight: 600;
  }
  /* a part of a chapter: its heading on the left, what it's about on the right */
  .bb-bhead {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(16px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(24px, 4vh, 40px);
  }
  .bb-h {
    margin: 0;
    font-size: clamp(1.4rem, 2.5vw, 2.125rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    line-height: 1;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  /* ---------- the problem: three steps, the way the film opens ---------- */
  .bb-story {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 28px);
    margin: 0;
    list-style: none;
  }
  .bb-frame figure {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .bb-frame-pic {
    display: block;
    overflow: hidden;
    border-radius: calc(12px * var(--sq));
    background: var(--bb-panel);
  }
  .bb-frame-pic img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .bb-frame figcaption {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .bb-frame-n {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    corner-shape: round;
    box-shadow: inset 0 0 0 1px var(--bb-led);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--bb-led);
  }
  .bb-frame-t {
    font-size: clamp(1.0625rem, 1.5vw, 1.3125rem);
    font-weight: 700;
    font-stretch: var(--bb-wide);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .bb-verdict {
    max-width: 22ch;
    margin: 0 0 0 auto;
    font-size: clamp(1.6rem, 3.2vw, 2.75rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    line-height: 1;
    letter-spacing: -0.035em;
    text-align: right;
    text-wrap: balance;
  }

  /* ---------- the brief ---------- */
  .bb-idea {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }
  .bb-idea-copy {
    display: grid;
    gap: 22px;
  }
  .bb-idea-fig {
    margin: 0;
    overflow: hidden;
    border-radius: calc(14px * var(--sq));
  }
  .bb-idea-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: 60% 50%;
  }
  .bb-rules {
    display: grid;
    gap: 0.06em;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bb-rules li {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-size: clamp(1.9rem, 4.2vw, 3.5rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }
  .bb-rules i {
    flex: none;
    width: 0.24em;
    height: 0.24em;
    border-radius: 50%;
    corner-shape: round;
    background: var(--bb-led);
    box-shadow: 0 0 14px 3px var(--bb-led-soft);
  }

  /* ---------- the box: the film's frames, played by the scroll ---------- */
  .bb-play {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: clamp(24px, 3.6vw, 56px);
    align-items: center;
  }
  .bb-play-fig {
    margin: 0;
  }
  .bb-play-fig img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: calc(14px * var(--sq));
    background: var(--bb-panel);
  }
  .bb-play-fig figcaption,
  .bb-sheetfig figcaption,
  .bb-stack figcaption {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--bb-ink-3);
  }
  .bb-beats {
    display: grid;
    gap: clamp(22px, 4vh, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .bb-beats li {
    display: grid;
    gap: 8px;
    padding-left: 26px;
    position: relative;
    transition: opacity 0.35s ease-out;
  }
  .bb-beats li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    corner-shape: round;
    background: rgb(255 255 255 / 0.14);
    transition:
      background-color 0.3s ease-out,
      box-shadow 0.3s ease-out;
  }
  .bb-beats b {
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .bb-beats span {
    max-width: 30ch;
    line-height: 1.5;
    color: var(--bb-ink-2);
  }
  .bb-beats:global(.is-armed) li:not(:global(.is-on)) {
    opacity: 0.22;
  }
  .bb-beats:not(:global(.is-armed)) li::before,
  .bb-beats li:global(.is-on)::before {
    background: var(--bb-led);
    box-shadow: 0 0 12px 2px var(--bb-led-soft);
  }
  .bb-film-block .bb-bhead {
    align-items: end;
  }

  /* ---------- the build log ---------- */
  .bb-log {
    display: grid;
    margin: 0;
    list-style: none;
  }
  .bb-day {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(16px, 3vw, 48px);
    padding: clamp(22px, 3.4vh, 34px) 0;
    border-top: 1px solid var(--bb-line);
  }
  .bb-day:last-child {
    border-bottom: 1px solid var(--bb-line);
  }
  .bb-day-h {
    display: grid;
    align-content: start;
    gap: 4px;
    margin: 0;
  }
  .bb-day-h b {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    font-stretch: var(--bb-wide);
    letter-spacing: -0.035em;
    line-height: 0.9;
  }
  .bb-day-h span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bb-ink-3);
  }
  .bb-day-list {
