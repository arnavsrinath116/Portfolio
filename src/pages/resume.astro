---
import Base from '../layouts/Base.astro';
import SheetFrame from '../components/SheetFrame.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { withBase } from '../lib/url';

// the CV is one A4 page; the picture is the PDF drawn at 2480px wide (A4 at 300 dpi), the file is what downloads
const pdf = withBase(site.resumePdf);
const file = site.resumePdf.split('/').pop();
---

<Base title={`Résumé · ${site.name}`} description={`${site.name}'s résumé: experience design, UI/UX, product, HCI and ergonomics. View it here or download the PDF.`}>
  <SheetFrame />
  <Header back />
  <main id="main" class="cv">
    <header class="cv-head">
      <div>
        <p class="cv-code">A4 · 1 page · PDF</p>
        <h1 class="cv-title" data-words="load"><span class="hl-block">Résumé</span></h1>
      </div>
      <div class="cv-actions">
        <a class="cv-btn" href={pdf} download={file} data-magnet>
          <span class="cv-btn-label">Download PDF</span>
          <Icon name="arrow-down" />
        </a>
        <a class="cv-link bracket" href={pdf} target="_blank" rel="noopener">Open the PDF <Icon name="arrow-up-right" /></a>
      </div>
    </header>

    <figure class="cv-sheet">
      <a href={pdf} target="_blank" rel="noopener" aria-label="Open the résumé as a PDF">
        <img
          src={withBase(site.resumeImage)}
          width="2480"
          height="3509"
          alt={`${site.name}'s résumé: experience design student at FLAME University. Experience at Tata Elxsi and an NGO; projects Cooked, The Man the God Wore and ITR filing; education, skills and tools.`}
          decoding="async"
        />
      </a>
    </figure>
  </main>
  <Footer />
</Base>

<style>
  .cv {
    position: relative;
    z-index: 1;
    padding: calc(var(--header-h) + var(--frame) + clamp(32px, 6vh, 72px)) calc(var(--frame) + var(--gutter))
      clamp(60px, 10vh, 120px);
  }
  .cv-head,
  .cv-sheet {
    width: min(100%, 880px);
    margin-inline: auto;
  }
  .cv-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px 32px;
    margin-bottom: clamp(28px, 5vh, 48px);
  }
  .cv-code {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  .cv-title {
    margin: 0;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
  }
  .cv-btn {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
    border-radius: var(--radius-slab);
    background: var(--accent-fill);
    color: var(--on-accent);
    text-decoration: none;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      filter 240ms ease-out;
  }
  .cv-btn-label {
    font-stretch: 125%;
    font-weight: 640;
    font-size: 1rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .cv-btn :global(.icon) {
    transition: transform var(--dur-base) var(--ease-out);
  }
  @media (hover: hover) {
    .cv-btn:hover {
      filter: brightness(1.08);
    }
    .cv-btn:hover :global(.icon) {
      transform: translateY(2px);
    }
  }
  .cv-link {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand-2);
    text-decoration: none;
  }

  /* the page itself: a sheet of paper on the drawing board, white in both themes */
  .cv-sheet {
    margin-block: 0;
  }
  .cv-sheet a {
    display: block;
    border-radius: 6px;
    overflow: hidden;
    background: #fff;
    box-shadow:
      0 0 0 1px var(--line-faint),
      0 30px 60px -24px rgb(0 0 0 / 0.35);
  }
  .cv-sheet img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 560px) {
    .cv-head {
      align-items: start;
    }
    .cv-link {
      margin-left: -0.9em; /* the ring's padding: keep the words on the text's left edge */
    }
  }
</style>
