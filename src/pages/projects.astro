---
import Base from '../layouts/Base.astro';
import SheetFrame from '../components/SheetFrame.astro';
import EdgeBlur from '../components/EdgeBlur.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectModal from '../components/project/ProjectModal.astro';
import Icon from '../components/Icon.astro';
import { projects } from '../data/projects';
import { skills } from '../data/skills';
import { site } from '../data/site';
import { withBase } from '../lib/url';

// every case study, as a drawing register: the homepage shows the first three, this shows them all
const pad = (n: number) => String(n).padStart(2, '0');
// and the models that aren't case studies (yet): the finished 3D pieces
const models = skills.find((s) => s.slug === '3d-modeling')?.works.filter((w) => !w.pending) ?? [];
---

<Base title={`All projects · ${site.name}`} description={`All projects by ${site.name}: product, UX and HMI case studies, and the models in between.`}>
  <SheetFrame />
  <EdgeBlur />
  <Header back />
  <ProjectModal />
  <span id="top"></span>
  <main id="main" class="pj">
    <header class="pj-head">
      <h1 class="pj-title">All <span class="hl-block">projects</span></h1>
      <p class="pj-note">
        The full drawing set: each case study from the first sketch to the last iteration, and the models built along the
        way. Open any sheet to read it.
      </p>
    </header>

    <section aria-labelledby="pj-cases">
      <h2 class="pj-sub" id="pj-cases"><span>Case studies</span><span>{pad(projects.length)} sheets</span></h2>
      <ol class="pj-list" data-rise-group>
        {
          projects.map((p, i) => (
            <li data-panel={`pj-${p.slug}`}>
              <a class="pj-card" href={withBase(`/projects/#project-${p.slug}`)} data-open-project={p.slug}>
                <span class="pj-cover">
                  {p.cover ? (
                    <img src={withBase(p.cover.src)} alt={p.cover.alt} width="2000" height="1160" loading="lazy" decoding="async" style={p.cover.focus ? `object-position:${p.cover.focus}` : undefined} />
                  ) : (
                    <span class="pj-draft">In drafting</span>
                  )}
                </span>
                <span class="pj-meta">
                  <span class="pj-no">P-{pad(i + 1)}</span>
                  <span class="pj-disc">{p.discipline}</span>
                  <span class="pj-name">{p.title}</span>
                  <span class="pj-line">{p.note}</span>
                  <span class="pj-facts">
                    {[!/TBD/i.test(p.duration) && p.duration, p.tools.slice(0, 3).join(' · ')].filter(Boolean).join('  ·  ')}
                  </span>
                  <span class="pj-go">
                    Open case study <Icon name="arrow-up-right" />
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    {
      models.length > 0 && (
        <section aria-labelledby="pj-models">
          <h2 class="pj-sub" id="pj-models">
            <span>Models &amp; side builds</span>
            <span>{pad(models.length)} pieces</span>
          </h2>
          <ul class="pj-models">
            {models.map((m, i) => (
              <li>
                <a class="pj-model" href={withBase('/projects/#skill-3d-modeling')} data-open-project="skill-3d-modeling">
                  <span class="pj-no">M-{pad(i + 1)}</span>
                  <span class="pj-mname">{m.title}</span>
                  <span class="pj-line">{m.caption}</span>
                  <span class="pj-mkind">
                    {m.kind} · 3D <Icon name="arrow-up-right" />
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
  <Footer />
</Base>

<style>
  .pj {
    position: relative;
    z-index: 1;
    padding: calc(var(--header-h) + var(--frame) + clamp(40px, 9vh, 96px)) calc(var(--frame) + var(--gutter)) clamp(60px, 10vh, 120px);
  }
  .pj-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 18px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(48px, 9vh, 96px);
  }
  .pj-title {
    margin: 0;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .pj-note {
    max-width: 42ch;
    margin: 0;
    color: var(--sand-2);
    line-height: 1.55;
  }
  .pj-sub {
    display: flex;
    justify-content: space-between;
    margin: 0 0 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  section + section {
    margin-top: clamp(56px, 10vh, 110px);
  }

  /* case studies: one sheet a row, cover on the left */
  .pj-list {
    display: grid;
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pj-list > li {
    --rise: 0px; /* scroll entrance (guide.ts) */
    transform: translateY(var(--rise));
  }
  .pj-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: clamp(18px, 3vw, 44px);
    align-items: center;
    padding: clamp(14px, 1.6vw, 20px);
    border-radius: var(--radius-slab);
    background: var(--slate-2);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
    color: inherit;
    text-decoration: none;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 240ms ease-out;
  }
  .pj-cover {
    position: relative;
    display: block;
    aspect-ratio: 2000 / 1160;
    border-radius: 9px;
    overflow: hidden;
    background: #f4f5f2;
  }
  .pj-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pj-draft {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px dashed rgb(var(--ink-rgb) / 0.18);
    border-radius: 9px;
    background: var(--slate-2);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  .pj-meta {
    display: grid;
    gap: 6px;
    align-content: center;
  }
  .pj-no,
  .pj-facts {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sand-3);
  }
  .pj-disc {
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .pj-name {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .pj-line {
    color: var(--sand-2);
    font-size: 0.9375rem;
  }
  .pj-facts {
    margin-top: 4px;
    white-space: pre-wrap;
  }
  .pj-go,
  .pj-mkind {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font-size: 0.8125rem;
    color: var(--sand-3);
    transition: color var(--dur-base) var(--ease-out);
  }
  .pj-go :global(.icon),
  .pj-mkind :global(.icon) {
    transition: transform var(--dur-base) var(--ease-out);
  }

  /* models: a register of rows */
  .pj-models {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 20px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pj-model {
    display: grid;
    gap: 6px;
    height: 100%;
    padding: 18px 20px;
    border-radius: var(--radius-slab);
    background: var(--slate-2);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
    color: inherit;
    text-decoration: none;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 240ms ease-out;
  }
  .pj-mname {
    font-stretch: 125%;
    font-weight: 640;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  .pj-mkind {
    margin-top: auto;
    padding-top: 8px;
  }

  @media (hover: hover) {
    .pj-card:hover,
    .pj-model:hover {
      transform: translateY(-4px);
      background: var(--slate-3);
    }
    .pj-card:hover .pj-cover img {
      transform: scale(1.03);
    }
    .pj-card:hover .pj-go,
    .pj-model:hover .pj-mkind {
      color: var(--accent);
    }
    .pj-card:hover .pj-go :global(.icon),
    .pj-model:hover .pj-mkind :global(.icon) {
      transform: translate(2px, -2px);
    }
  }

  @media (max-width: 860px) {
    .pj-head,
    .pj-card {
      grid-template-columns: minmax(0, 1fr);
    }
    .pj-models {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
