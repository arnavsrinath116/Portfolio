---
import Base from '../layouts/Base.astro';
import SheetFrame from '../components/SheetFrame.astro';
import EdgeBlur from '../components/EdgeBlur.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectModal from '../components/project/ProjectModal.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
import { withBase } from '../lib/url';

// every case study: the homepage shows the first three, this shows them all
// tools as a phrase: "Figma and FigJam", "ESP32, Arduino IDE and Fusion 360"
const phrase = (list: string[]) => (list.length < 2 ? list.join('') : `${list.slice(0, -1).join(', ')} and ${list[list.length - 1]}`);
---

<Base title={`All projects · ${site.name}`} description={`All projects by ${site.name}: product, UX and HMI case studies.`}>
  <SheetFrame />
  <EdgeBlur />
  <Header back />
  <ProjectModal />
  <span id="top"></span>
  <main id="main" class="pj">
    <header class="pj-head">
      <h1 class="pj-title" data-words="load">All projects</h1>
      <p class="pj-note">
        The full drawing set: each case study from the first sketch to the last iteration. Open any sheet to read it.
      </p>
    </header>

    <section aria-label="Case studies">
      <ol class="pj-list" data-rise-group>
        {
          projects.map((p) => (
            <li data-panel={`pj-${p.slug}`}>
              <a class="pj-card" href={withBase(`/projects/#project-${p.slug}`)} data-open-project={p.slug}>
                <span class="pj-cover">
                  {p.cover ? (
                    <img src={withBase(p.cover.src)} alt={p.cover.alt} width="2000" height="1160" loading="lazy" decoding="async" style={p.cover.focus ? `object-position:${p.cover.focus}` : undefined} />
                  ) : (
                    <span class="pj-draft">In drafting</span>
                  )}
                </span>
                <span class="pj-meta">
                  <span class="pj-disc">{p.discipline}</span>
                  <span class="pj-name">{p.title}</span>
                  <span class="pj-line">{p.note}</span>
                  <span class="pj-facts">
                    {[!/TBD/i.test(p.duration) && p.duration, phrase(p.tools.slice(0, 3))].filter(Boolean).join(', ')}
                  </span>
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

  </main>
  <Footer />
</Base>

<style>
  .pj {
    position: relative;
    z-index: 1;
    padding: calc(var(--header-h) + var(--frame) + clamp(40px, 9vh, 96px)) calc(var(--frame) + var(--gutter)) clamp(60px, 10vh, 120px);
  }
  .pj-head {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: 18px clamp(32px, 6vw, 96px);
    align-items: end;
    margin-bottom: clamp(48px, 9vh, 96px);
  }
  .pj-title {
    margin: 0;
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(2.4rem, 6vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }
  .pj-note {
    max-width: 42ch;
    margin: 0;
    color: var(--sand-2);
    line-height: 1.55;
  }
  /* case studies: one sheet a row, cover on the left */
  .pj-list {
    display: grid;
    gap: clamp(14px, 2vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pj-list > li {
    --rise: 0px; /* scroll entrance (guide.ts) */
    transform: translateY(var(--rise));
  }
  .pj-card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 4fr);
    gap: clamp(18px, 3vw, 44px);
    align-items: center;
    padding: clamp(14px, 1.6vw, 20px);
    border-radius: calc(var(--radius-slab) * var(--sq));
    background: var(--slate-2);
    border-top: 1px solid var(--slate-edge);
    box-shadow: var(--slab-shadow);
    color: inherit;
    text-decoration: none;
    transition:
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1),
      background-color 240ms ease-out;
  }
  .pj-cover {
    position: relative;
    display: block;
    aspect-ratio: 2000 / 1160;
    border-radius: calc(9px * var(--sq));
    overflow: hidden;
    background: #f4f5f2;
  }
  .pj-cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pj-draft {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 1px dashed rgb(var(--ink-rgb) / 0.18);
    border-radius: calc(9px * var(--sq));
    background: var(--slate-2);
    font-size: 0.875rem;
    color: var(--sand-3);
  }
  .pj-meta {
    display: grid;
    gap: 6px;
    align-content: center;
  }
  .pj-disc {
    margin-top: 6px;
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .pj-name {
    font-stretch: 125%;
    font-weight: 640;
    font-size: clamp(1.4rem, 2.6vw, 2.25rem);
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .pj-line {
    color: var(--sand-2);
    font-size: 0.9375rem;
  }
  .pj-facts {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--sand-3);
  }
  @media (hover: hover) {
    .pj-card:hover {
      transform: translateY(-4px);
      background: var(--slate-3);
    }
    .pj-card:hover .pj-cover img {
      transform: scale(1.03);
    }
  }

  @media (max-width: 860px) {
    .pj-head,
    .pj-card {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
